lemma avg_weights_sum {N : ℕ} (hN : 1 ≤ N) :
    ∑ _n ∈ Finset.range N, (N : ℝ)⁻¹ = 1 := by
  have : (N : ℝ) ≠ 0 := by positivity
  simp [this]

/-- Power-mean (Jensen) inequality for normalized finite averages. -/
lemma avg_le_rpow_avg {N : ℕ} (hN : 1 ≤ N) {b : ℕ → ℝ} (hb : ∀ n, 0 ≤ b n) {Q : ℝ}
    (hQ : 1 ≤ Q) :
    (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, b n ≤
      ((N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, b n ^ Q) ^ (1 / Q) := by
  rw [Finset.mul_sum, Finset.mul_sum]
  exact Real.arith_mean_le_rpow_mean _ (fun _ => (N : ℝ)⁻¹) b (fun _ _ => by positivity)
    (avg_weights_sum hN) (fun n _ => hb n) hQ

/-- Hölder inequality for normalized finite averages, in `R`-th power form. -/
lemma holder_avg_rpow {N : ℕ} (hN : 1 ≤ N) {a b : ℕ → ℝ} (ha : ∀ n, 0 ≤ a n)
    (hb : ∀ n, 0 ≤ b n) {P Q R : ℝ} (hPQR : P.HolderTriple Q R) (hR : 1 ≤ R) :
    ((N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, a n * b n) ^ R ≤
      ((N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, a n ^ P) ^ (R / P) *
      ((N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, b n ^ Q) ^ (R / Q) := by
  have hNpos : (0 : ℝ) < (N : ℝ)⁻¹ := by
    have : (0 : ℝ) < N := by exact_mod_cast hN
    positivity
  have hP := hPQR.left_pos
  have hQ := hPQR.right_pos
  have hRpos : 0 < R := by linarith
  have hsum : R / P + R / Q = 1 := by
    have h := hPQR.inv_add_inv_eq_inv
    field_simp
    have : R * (P⁻¹ + Q⁻¹) = 1 := by rw [h, mul_inv_cancel₀ hRpos.ne']
    field_simp at this
    linarith
  have h1 : ((N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, a n * b n) ^ R ≤
      (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, (a n * b n) ^ R := by
    rw [Finset.mul_sum, Finset.mul_sum]
    exact Real.rpow_arith_mean_le_arith_mean_rpow _ (fun _ => (N : ℝ)⁻¹) _
      (fun _ _ => hNpos.le) (avg_weights_sum hN) (fun n _ => mul_nonneg (ha n) (hb n)) hR
  have h2 := Real.Lr_rpow_le_Lp_mul_Lq_of_nonneg (Finset.range N) hPQR
    (fun n _ => ha n) (fun n _ => hb n)
  refine h1.trans ?_
  have hsplit : (N : ℝ)⁻¹ = (N : ℝ)⁻¹ ^ (R / P) * (N : ℝ)⁻¹ ^ (R / Q) := by
    rw [← Real.rpow_add hNpos, hsum, Real.rpow_one]
  have hA : 0 ≤ ∑ n ∈ Finset.range N, a n ^ P :=
    Finset.sum_nonneg fun n _ => Real.rpow_nonneg (ha n) _
  have hB : 0 ≤ ∑ n ∈ Finset.range N, b n ^ Q :=
    Finset.sum_nonneg fun n _ => Real.rpow_nonneg (hb n) _
  rw [Real.mul_rpow hNpos.le hA, Real.mul_rpow hNpos.le hB]
  calc (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, (a n * b n) ^ R
      ≤ (N : ℝ)⁻¹ * ((∑ n ∈ Finset.range N, a n ^ P) ^ (R / P) *
          (∑ n ∈ Finset.range N, b n ^ Q) ^ (R / Q)) := by gcongr
    _ = _ := by conv_lhs => rw [hsplit]
                ring

lemma norm_bilinAvg_le_T08 {X : Type*} (T S : X → X) (f g : X → ℂ) (N : ℕ) (x : X) :
    ‖bilinAvg T S f g N x‖ ≤
      (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, ‖f (T^[n] x)‖ * ‖g (S^[n] x)‖ := by
  unfold bilinAvg
  rw [norm_mul, norm_inv, Complex.norm_natCast]
  gcongr
  refine (norm_sum_le _ _).trans ?_
