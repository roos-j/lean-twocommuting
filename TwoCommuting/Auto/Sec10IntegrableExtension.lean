/-- A forward average of length `N ≥ 1` is at most twice the centered maximal function. -/
lemma FinSupp.forward_avg_lt_two_maxZ {a : ℤ → ℝ} {S : Finset ℤ} (ha : FinSupp a S) (k : ℤ)
    {N : ℕ} (hN : 1 ≤ N) {t : ℝ} (ht : t < (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, a (k + n)) :
    t / 2 < maxZ a k := by
  have hsub : (Finset.range N).image (fun n : ℕ => k + n) ⊆
      Finset.Icc (k - ((N - 1 : ℕ) : ℤ)) (k + ((N - 1 : ℕ) : ℤ)) := by
    intro j hj
    simp only [Finset.mem_image, Finset.mem_range] at hj
    obtain ⟨n, hn, rfl⟩ := hj
    simp only [Finset.mem_Icc]
    constructor <;> omega
  have hsum : ∑ n ∈ Finset.range N, a (k + n) ≤
      ∑ j ∈ Finset.Icc (k - ((N - 1 : ℕ) : ℤ)) (k + ((N - 1 : ℕ) : ℤ)), a j := by
    rw [← Finset.sum_image (f := a) (g := fun n : ℕ => k + n)
      (fun x _ y _ h => by simpa using h)]
    exact Finset.sum_le_sum_of_subset_of_nonneg hsub fun j _ _ => ha.nonneg j
  have h2 := ha.sum_Icc_le_maxZ k (N - 1)
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
  have hcast : ((N - 1 : ℕ) : ℝ) = (N : ℝ) - 1 := by
    rw [Nat.cast_sub hN]; simp
  rw [hcast] at h2
  have hm := ha.maxZ_nonneg k
  rw [lt_inv_mul_iff₀ hNpos] at ht
  nlinarith

