/-- One-sided weak type bound for finitely supported sequences, constant `10`. -/
lemma FinSupp.weak_forward {a : ℤ → ℝ} {S : Finset ℤ} (ha : FinSupp a S) {t : ℝ} (ht : 0 < t)
    (F : Finset ℤ) :
    t * (F.filter fun k => ∃ N : ℕ, 1 ≤ N ∧
      t < (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, a (k + n)).card ≤ 10 * ∑ j ∈ S, a j := by
  classical
  have h := ha.weak_maxZ (t := t / 2) (by positivity) F
  have hc : (F.filter fun k => ∃ N : ℕ, 1 ≤ N ∧
      t < (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, a (k + n)).card ≤
      (F.filter fun k => t / 2 < maxZ a k).card := by
    apply Finset.card_le_card
    intro k hk
    simp only [Finset.mem_filter] at hk ⊢
    obtain ⟨hkF, N, hN, hlt⟩ := hk
    exact ⟨hkF, ha.forward_avg_lt_two_maxZ k hN hlt⟩
  have hc' : ((F.filter fun k => ∃ N : ℕ, 1 ≤ N ∧
      t < (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, a (k + n)).card : ℝ) ≤
      (F.filter fun k => t / 2 < maxZ a k).card := by exact_mod_cast hc
  nlinarith

variable {X : Type*} [MeasurableSpace X]

/-- The set where some forward orbit average of length `1 ≤ N ≤ K` exceeds `t`. -/
def fwdSetK (T : X → X) (h : X → ℝ) (t : ℝ) (K : ℕ) : Set X :=
  {x | ∃ N : ℕ, 1 ≤ N ∧ N ≤ K ∧ t < (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, h (T^[n] x)}

/-- The finite-orbit-segment inequality: transference of `FinSupp.weak_forward`. -/
lemma orbit_segment_ineq (T : X → X) {h : X → ℝ} (h0 : ∀ x, 0 ≤ h x) {t : ℝ} (ht : 0 < t)
    (K L : ℕ) (x : X) :
    t * ∑ j ∈ Finset.range L, (fwdSetK T h t K).indicator 1 (T^[j] x) ≤
      10 * ∑ j ∈ Finset.range (L + K), h (T^[j] x) := by
  classical
  set Sset : Finset ℤ := (Finset.range (L + K)).image (Nat.cast : ℕ → ℤ) with hSset
  set a : ℤ → ℝ := fun j => if j ∈ Sset then h (T^[j.toNat] x) else 0 with ha_def
  have ha : FinSupp a Sset :=
    ⟨fun j => by simp only [ha_def]; split_ifs <;> simp [h0], fun j hj => by simp [ha_def, hj]⟩
  have hinj : Function.Injective (Nat.cast : ℕ → ℤ) := Nat.cast_injective
  have hsumS : ∑ j ∈ Sset, a j = ∑ j ∈ Finset.range (L + K), h (T^[j] x) := by
    rw [hSset, Finset.sum_image (fun x _ y _ hxy => hinj hxy)]
    refine Finset.sum_congr rfl fun j hj => ?_
    simp only [ha_def]
    rw [if_pos (Finset.mem_image_of_mem _ hj)]
    simp
  set F : Finset ℤ := (Finset.range L).image (Nat.cast : ℕ → ℤ)
  have hw := ha.weak_forward ht F
  rw [hsumS] at hw
  refine le_trans ?_ hw
  gcongr
  rw [Finset.sum_indicator_eq_sum_filter]
  simp only [Pi.one_apply, Finset.sum_const, nsmul_eq_mul, mul_one]
  have : (((Finset.range L).filter fun j => T^[j] x ∈ fwdSetK T h t K).image
      (Nat.cast : ℕ → ℤ)) ⊆ F.filter fun k => ∃ N : ℕ, 1 ≤ N ∧
        t < (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, a (k + n) := by
    intro k hk
    simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_range] at hk
    obtain ⟨j, ⟨hjL, N, hN1, hNK, hlt⟩, rfl⟩ := hk
    simp only [Finset.mem_filter]
    refine ⟨Finset.mem_image_of_mem _ (Finset.mem_range.2 hjL), N, hN1, ?_⟩
    convert hlt using 2
    refine Finset.sum_congr rfl fun n hn => ?_
    have hn' := Finset.mem_range.1 hn
    have hmem : ((j : ℤ) + n) ∈ Sset := by
      rw [hSset, Finset.mem_image]
      exact ⟨j + n, Finset.mem_range.2 (by omega), by push_cast; rfl⟩
    simp only [ha_def, if_pos hmem]
    have : ((j : ℤ) + n).toNat = n + j := by omega
    rw [this, Function.iterate_add_apply]
  have hc := Finset.card_le_card this
  rw [Finset.card_image_of_injective _ hinj] at hc
  exact_mod_cast hc

variable {μ : Measure X}

lemma integral_comp_iterate_eq {T : X → X} (hT : MeasurePreserving T μ μ) {g : X → ℝ}
    (hg : AEStronglyMeasurable g μ) (n : ℕ) : ∫ x, g (T^[n] x) ∂μ = ∫ x, g x ∂μ := by
  have hTn := hT.iterate n
  have := integral_map (μ := μ) hTn.aemeasurable (f := g) (by rwa [hTn.map_eq])
  rw [hTn.map_eq] at this
  exact this.symm

lemma integrable_comp_iterate {T : X → X} (hT : MeasurePreserving T μ μ) {g : X → ℝ}
    (hg : Integrable g μ) (n : ℕ) : Integrable (fun x => g (T^[n] x)) μ :=
  (hT.iterate n).integrable_comp_of_integrable hg

lemma measurableSet_fwdSetK {T : X → X} (hT : Measurable T) {h : X → ℝ} (hh : Measurable h)
    (t : ℝ) (K : ℕ) : MeasurableSet (fwdSetK T h t K) := by
  have : fwdSetK T h t K = ⋃ N ∈ Finset.Icc 1 K,
      {x | t < (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, h (T^[n] x)} := by
    ext x; simp [fwdSetK, and_assoc]
  rw [this]
  exact Finset.measurableSet_biUnion _ fun N _ => measurableSet_lt measurable_const
    ((Finset.measurable_sum _ fun n _ => hh.comp (hT.iterate n)).const_mul _)

lemma measureReal_fwdSetK_le [IsProbabilityMeasure μ] {T : X → X}
    (hT : MeasurePreserving T μ μ) {h : X → ℝ} (hh : Measurable h) (h0 : ∀ x, 0 ≤ h x)
    (hi : Integrable h μ) {t : ℝ} (ht : 0 < t) (K : ℕ) :
    μ.real (fwdSetK T h t K) ≤ 10 * (∫ x, h x ∂μ) / t := by
  set E := fwdSetK T h t K
  have hE := measurableSet_fwdSetK hT.measurable hh t K
  set I := ∫ x, h x ∂μ
  have key : ∀ L : ℕ, t * (L * μ.real E) ≤ 10 * ((L + K) * I) := by
    intro L
    have hint := integral_mono (μ := μ)
      (f := fun x => t * ∑ j ∈ Finset.range L, E.indicator 1 (T^[j] x))
      (g := fun x => 10 * ∑ j ∈ Finset.range (L + K), h (T^[j] x)) ?_ ?_
      (fun x => orbit_segment_ineq T h0 ht K L x)
    · rw [integral_const_mul, integral_const_mul, integral_finsetSum, integral_finsetSum] at hint
      · have hj : ∀ j, ∫ x, E.indicator 1 (T^[j] x) ∂μ = μ.real E := fun j => by
          rw [integral_comp_iterate_eq hT
            ((measurable_one.indicator hE).aestronglyMeasurable (μ := μ)),
            integral_indicator_one hE]
        simp only [integral_comp_iterate_eq hT hi.aestronglyMeasurable, hj, Finset.sum_const,
          Finset.card_range, nsmul_eq_mul] at hint
        push_cast at hint
        exact hint
      · exact fun j _ => integrable_comp_iterate hT hi j
      · exact fun j _ => integrable_comp_iterate hT
          ((integrable_const (1 : ℝ)).indicator hE) j
    · exact (integrable_finsetSum _ fun j _ => integrable_comp_iterate hT
          ((integrable_const (1 : ℝ)).indicator hE) j).const_mul _
    · exact (integrable_finsetSum _ fun j _ => integrable_comp_iterate hT hi j).const_mul _
  have hI : 0 ≤ I := integral_nonneg h0
  have hlim : Tendsto (fun n : ℕ => 10 * I / t * (1 + (K : ℝ) / ((n + 1 : ℕ) : ℝ))) atTop
      (𝓝 (10 * I / t * (1 + 0))) := by
    refine tendsto_const_nhds.mul (tendsto_const_nhds.add ?_)
    exact (tendsto_const_div_atTop_nhds_zero_nat (K : ℝ)).comp (tendsto_add_atTop_nat 1)
  rw [add_zero, mul_one] at hlim
  refine ge_of_tendsto' hlim fun n => ?_
  have hk := key (n + 1)
  set L : ℝ := ((n + 1 : ℕ) : ℝ)
  have hn : (0 : ℝ) < L := by positivity
  have : 10 * I / t * (1 + (K : ℝ) / L) = 10 * ((L + K) * I) / (t * L) := by
    field_simp
  rw [this, le_div_iff₀ (by positivity)]
  linarith

lemma one_sided_weak_maximal_of_measurable [IsProbabilityMeasure μ] {T : X → X}
    (hT : MeasurePreserving T μ μ) {h : X → ℝ} (hh : Measurable h) (h0 : ∀ x, 0 ≤ h x)
    (hi : Integrable h μ) {t : ℝ} (ht : 0 < t) :
    μ {x | ∃ N : ℕ, 1 ≤ N ∧ t < (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, h (T^[n] x)} ≤
      ENNReal.ofReal (10 * (∫ x, h x ∂μ) / t) := by
  have hU : {x | ∃ N : ℕ, 1 ≤ N ∧ t < (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, h (T^[n] x)} =
      ⋃ K, fwdSetK T h t K := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, fwdSetK]
    constructor
    · rintro ⟨N, hN, hlt⟩; exact ⟨N, N, hN, le_rfl, hlt⟩
    · rintro ⟨K, N, hN, -, hlt⟩; exact ⟨N, hN, hlt⟩
  have hmono : Monotone (fwdSetK T h t) := by
    intro K K' hKK' x hx
    obtain ⟨N, hN, hNK, hlt⟩ := hx
    exact ⟨N, hN, hNK.trans hKK', hlt⟩
  rw [hU, hmono.measure_iUnion]
  refine iSup_le fun K => ?_
  rw [← ofReal_measureReal]
  exact ENNReal.ofReal_le_ofReal (measureReal_fwdSetK_le hT hh h0 hi ht K)

/-- **Lemma 10.1 (node T06), weak maximal estimate.** For a measure-preserving map `T` of a
probability space, a nonnegative integrable `h` and `t > 0`, the one-sided ergodic maximal
function `M_T h = sup_{N ≥ 1} N⁻¹ ∑_{n<N} h ∘ Tⁿ` satisfies
`μ {M_T h > t} ≤ 10 ‖h‖₁ / t` (here `‖h‖₁ = ∫ h` since `h ≥ 0`).
The blueprint states the constant `6` (based on a Vitali constant `3`); our discrete maximal
estimate D01 has constant `5`, which yields the absolute constant `10`. No invertibility or
commutation is needed. -/
theorem one_sided_ergodic_weak_maximal [IsProbabilityMeasure μ] {T : X → X}
    (hT : MeasurePreserving T μ μ) {h : X → ℝ} (h0 : ∀ x, 0 ≤ h x)
    (hi : Integrable h μ) {t : ℝ} (ht : 0 < t) :
    μ {x | ∃ N : ℕ, 1 ≤ N ∧ t < (N : ℝ)⁻¹ * ∑ n ∈ Finset.range N, h (T^[n] x)} ≤
      ENNReal.ofReal (10 * (∫ x, h x ∂μ) / t) := by
  set h' : X → ℝ := fun x => max (hi.aestronglyMeasurable.mk h x) 0 with hh'_def
  have hh' : Measurable h' :=
    hi.aestronglyMeasurable.stronglyMeasurable_mk.measurable.max measurable_const
  have heq : h =ᵐ[μ] h' := hi.aestronglyMeasurable.ae_eq_mk.mono fun x hx => by
    simp only [hh'_def, ← hx, max_eq_left (h0 x)]
  have hi' : Integrable h' μ := hi.congr heq
  have h0' : ∀ x, 0 ≤ h' x := fun x => le_max_right _ _
  have hall : ∀ᵐ x ∂μ, ∀ n : ℕ, h (T^[n] x) = h' (T^[n] x) :=
    ae_all_iff.2 fun n => (hT.iterate n).quasiMeasurePreserving.ae_eq_comp heq
  rw [integral_congr_ae heq]
  refine le_trans (measure_mono_ae ?_) (one_sided_weak_maximal_of_measurable hT hh' h0' hi' ht)
  filter_upwards [hall] with x hx
  intro hmem
  obtain ⟨N, hN, hlt⟩ := hmem
  refine ⟨N, hN, ?_⟩
  simpa only [hx] using hlt

end T06

