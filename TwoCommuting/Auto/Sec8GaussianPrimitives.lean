    nlinarith
  have hsp : 0 < s ^ (-p) := Real.rpow_pos_of_pos hs0 _
  have : ‖G s‖ = s ^ (-p) * ‖F s‖ := by
    simp only [hG, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hsp]
  rw [this] at hlim
