/-- The pairing `I_j(σ) = ∫ a(t) g_σ^{(j)}(t) dt` (helper for node S01). -/
def s01I (a : ℝ → ℂ) (j : ℕ) (σ : ℝ) : ℂ := ∫ t, a t * (gaussianD j σ t : ℂ)

/-- Helper for node S01: the heat equation for the pairings, `∂_σ I_j = I_{j+2} / 2`. -/
lemma s01_hasDerivAt_I (ha : Measurable a) (hM : ∀ t, ‖a t‖ ≤ M) (j : ℕ) {σ : ℝ}
    (hσ : 0 < σ) : HasDerivAt (s01I a j) (s01I a (j + 2) σ / 2) σ := by
  obtain ⟨C, hC, hCb⟩ := abs_pow_mul_gaussianD_le (j + 2) 0
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hs : Ioo (σ / 2) (2 * σ) ∈ 𝓝 σ := Ioo_mem_nhds (by linarith) (by linarith)
  have hmeasg : ∀ k τ, AEStronglyMeasurable (fun t => a t * (gaussianD k τ t : ℂ)) :=
    fun k τ => ha.aestronglyMeasurable.mul
      (Complex.continuous_ofReal.comp (continuous_gaussianD k τ)).aestronglyMeasurable
  have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
    (F := fun τ t => a t * (gaussianD j τ t : ℂ))
    (F' := fun τ t => a t * ((gaussianD (j + 2) τ t / 2 : ℝ) : ℂ)) (x₀ := σ)
    (bound := fun t => M * (C * (√(σ / 2))⁻¹ ^ (j + 3) *
      Real.exp (-(t ^ 2) / (4 * (2 * σ))))) hs ?_ ?_ ?_ ?_ ?_ ?_
  · have : (∫ t, a t * ((gaussianD (j + 2) σ t / 2 : ℝ) : ℂ)) = s01I a (j + 2) σ / 2 := by
      unfold s01I; rw [← integral_div]; congr 1; funext t; push_cast; ring
    rw [← this]; exact key.2
  · exact Eventually.of_forall fun τ => hmeasg j τ
  · exact s01_integrable_mul ha hM (integrable_gaussianD j hσ).ofReal
  · have : (fun t => a t * ((gaussianD (j + 2) σ t / 2 : ℝ) : ℂ)) =
        fun t => (1 / 2 : ℂ) * (a t * (gaussianD (j + 2) σ t : ℂ)) := by
      funext t; push_cast; ring
    rw [this]; exact (hmeasg (j + 2) σ).const_mul _
  · refine Eventually.of_forall fun t τ hτ => ?_
    have hτ0 : 0 < τ := by linarith [hτ.1]
    have hb := hCb τ hτ0 t
    simp only [pow_zero, one_mul, mul_one] at hb
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have h1 : (√τ)⁻¹ ≤ (√(σ / 2))⁻¹ :=
      inv_anti₀ (Real.sqrt_pos.2 (by linarith)) (Real.sqrt_le_sqrt hτ.1.le)
    have h2 : Real.exp (-(t ^ 2) / (4 * τ)) ≤ Real.exp (-(t ^ 2) / (4 * (2 * σ))) := by
      refine Real.exp_le_exp.2 ?_
      rw [neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left (sq_nonneg t) (by linarith) (by linarith [hτ.2])
    have h3 : |gaussianD (j + 2) τ t / 2| ≤ C * (√(σ / 2))⁻¹ ^ (j + 3) *
        Real.exp (-(t ^ 2) / (4 * (2 * σ))) := by
      rw [abs_div, abs_two]
      calc |gaussianD (j + 2) τ t| / 2 ≤ |gaussianD (j + 2) τ t| := by
            linarith [abs_nonneg (gaussianD (j + 2) τ t)]
        _ ≤ C * (√τ)⁻¹ ^ (j + 2 + 1) * Real.exp (-(t ^ 2) / (4 * τ)) := hb
        _ ≤ C * (√(σ / 2))⁻¹ ^ (j + 3) * Real.exp (-(t ^ 2) / (4 * (2 * σ))) := by
            gcongr
    exact mul_le_mul (hM t) h3 (abs_nonneg _) hM0
  · exact ((integrable_exp_neg_sq_div (by positivity : (0:ℝ) < 2 * σ)).const_mul _).const_mul _
  · refine Eventually.of_forall fun t τ hτ => ?_
    have hτ0 : 0 < τ := by linarith [hτ.1]
    exact (hasDerivAt_gaussianD_variance j hτ0 t).ofReal_comp.const_mul (a t)

/-- Helper for node S01: a bounded solution of `u F'(u) = p F(u) + e(u)` with `e → 0` and
`p > 0` tends to zero (integrate `(u^{-p} F)' = u^{-p-1} e` from `s` to infinity). -/
lemma s01_tendsto_zero_of_euler {F e : ℝ → ℂ} {p : ℝ} (hp : 0 < p) {K : ℝ}
    (hF : ∀ᶠ u in atTop, ‖F u‖ ≤ K) (he : Tendsto e atTop (𝓝 0))
    (hd : ∀ u, 0 < u → HasDerivAt F (((p : ℂ) * F u + e u) / u) u) :
    Tendsto F atTop (𝓝 0) := by
  rw [Metric.tendsto_nhds]
  intro ε hε
  have he' := Metric.tendsto_nhds.1 he (ε * p / 2) (by positivity)
  obtain ⟨s1, hs1⟩ := eventually_atTop.1 (hF.and he')
  filter_upwards [eventually_ge_atTop (max s1 1)] with s hs
  have hs0 : 0 < s := lt_of_lt_of_le one_pos (le_trans (le_max_right _ _) hs)
  rw [dist_zero_right]
  set G : ℝ → ℂ := fun u => ((u ^ (-p) : ℝ) : ℂ) * F u with hG
  have hGd : ∀ u, 0 < u → HasDerivAt G (((u ^ (-p - 1) : ℝ) : ℂ) * e u) u := by
    intro u hu
    have h1 := (Real.hasDerivAt_rpow_const (p := -p) (Or.inl hu.ne')).ofReal_comp
    have h2 := h1.mul (hd u hu)
    convert h2 using 1
    have hw : u ^ (-p) = u ^ (-p - 1) * u := by
      rw [Real.rpow_sub_one hu.ne']; field_simp
    rw [hw]
    have hu' : (u : ℂ) ≠ 0 := by exact_mod_cast hu.ne'
    push_cast
    field_simp
    ring
  -- bound on `[s, T]`
  have hbd : ∀ T, s ≤ T → ‖G T - G s‖ ≤ ε / 2 * (s ^ (-p) - T ^ (-p)) := by
    intro T hT
    have hpos : ∀ x ∈ Icc s T, 0 < x := fun x hx => lt_of_lt_of_le hs0 hx.1
    have := image_norm_le_of_norm_deriv_right_le_deriv_boundary' (a := s) (b := T)
      (f := fun u => G u - G s) (f' := fun u => ((u ^ (-p - 1) : ℝ) : ℂ) * e u)
      (B := fun u => ε / 2 * (s ^ (-p) - u ^ (-p)))
      (B' := fun u => ε / 2 * (p * u ^ (-p - 1))) ?_ ?_ ?_ ?_ ?_ ?_ (x := T) ⟨hT, le_rfl⟩
    · exact this
    · intro x hx
      exact ((hGd x (hpos x hx)).sub_const (G s)).continuousAt.continuousWithinAt
    · intro x hx
      exact ((hGd x (hpos x (Ico_subset_Icc_self hx))).sub_const (G s)).hasDerivWithinAt
    · simp
    · intro x hx
      have hx0 := hpos x hx
      exact (((Real.hasDerivAt_rpow_const (p := -p) (Or.inl hx0.ne')).const_sub
        (s ^ (-p))).const_mul (ε / 2)).continuousAt.continuousWithinAt
    · intro x hx
      have hx0 := hpos x (Ico_subset_Icc_self hx)
      have h1 := Real.hasDerivAt_rpow_const (p := -p) (Or.inl hx0.ne')
      have h2 := (h1.const_sub (s ^ (-p))).const_mul (ε / 2)
      convert h2.hasDerivWithinAt using 1
      ring_nf
    · intro x hx
      have hx0 := hpos x (Ico_subset_Icc_self hx)
      have hxs : s1 ≤ x := le_trans (le_max_left _ _) (hs.trans hx.1)
      have hex := (hs1 x hxs).2
      rw [dist_zero_right] at hex
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (Real.rpow_pos_of_pos hx0 _)]
      have : 0 < x ^ (-p - 1) := Real.rpow_pos_of_pos hx0 _
      nlinarith
  -- let `T → ∞`
  have hlim : ‖G s‖ ≤ ε / 2 * s ^ (-p) := by
    have ht : Tendsto (fun T : ℝ => T ^ (-p) * K + ε / 2 * s ^ (-p)) atTop
        (𝓝 (0 * K + ε / 2 * s ^ (-p))) :=
      ((tendsto_rpow_neg_atTop hp).mul_const K).add_const _
    rw [zero_mul, zero_add] at ht
    refine ge_of_tendsto ht ?_
    filter_upwards [eventually_ge_atTop s, eventually_ge_atTop s1] with T hT hT1
    have h1 := hbd T hT
    have h2 : ‖G T‖ ≤ T ^ (-p) * K := by
      have hT0 : 0 < T := lt_of_lt_of_le hs0 hT
      simp only [hG, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (Real.rpow_pos_of_pos hT0 _)]
      exact mul_le_mul_of_nonneg_left (hs1 T hT1).1 (Real.rpow_pos_of_pos hT0 _).le
    have h3 : ‖G s‖ ≤ ‖G T‖ + ‖G T - G s‖ := by
      have := norm_sub_le (G T) (G T - G s)
      simpa using this
