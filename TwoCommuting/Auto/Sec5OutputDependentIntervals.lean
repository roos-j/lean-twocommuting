/-! ### Node D01: a maximal estimate on the integer line -/

section D01

/-- The centered average `(2r+1)⁻¹ ∑_{|j-k| ≤ r} a(j)`. -/
def avgZ (a : ℤ → ℝ) (k : ℤ) (r : ℕ) : ℝ :=
  (∑ j ∈ Finset.Icc (k - r) (k + r), a j) / (2 * r + 1)

/-- The centered maximal function `M_ℤ a(k) = sup_{r ≥ 0} (2r+1)⁻¹ ∑_{|j-k| ≤ r} a(j)`. -/
def maxZ (a : ℤ → ℝ) (k : ℤ) : ℝ := ⨆ r : ℕ, avgZ a k r

variable {a : ℤ → ℝ} {S : Finset ℤ}

/-- Standing hypotheses: `a ≥ 0` is supported in the finite set `S`. -/
structure FinSupp (a : ℤ → ℝ) (S : Finset ℤ) : Prop where
  nonneg : ∀ j, 0 ≤ a j
  supp : ∀ j, j ∉ S → a j = 0

lemma FinSupp.sum_le (ha : FinSupp a S) (T : Finset ℤ) : ∑ j ∈ T, a j ≤ ∑ j ∈ S, a j := by
  classical
  rw [← Finset.sum_subset (Finset.inter_subset_left (s₁ := T) (s₂ := S))
    (fun j _ hj => ha.supp j fun hS => hj (Finset.mem_inter.2 ⟨‹_›, hS⟩))]
  exact Finset.sum_le_sum_of_subset_of_nonneg Finset.inter_subset_right
    fun j _ _ => ha.nonneg j

lemma FinSupp.sum_Icc_le (ha : FinSupp a S) (k : ℤ) (r : ℕ) :
    ∑ j ∈ Finset.Icc (k - r) (k + r), a j ≤ ∑ j ∈ S, a j := ha.sum_le _

lemma FinSupp.avgZ_le (ha : FinSupp a S) (k : ℤ) (r : ℕ) : avgZ a k r ≤ ∑ j ∈ S, a j := by
  unfold avgZ
  have h1 : (1 : ℝ) ≤ 2 * r + 1 := by have := r.cast_nonneg (α := ℝ); linarith
  have h0 : 0 ≤ ∑ j ∈ Finset.Icc (k - r) (k + r), a j :=
    Finset.sum_nonneg fun j _ => ha.nonneg j
  rw [div_le_iff₀ (by linarith)]
  nlinarith [ha.sum_Icc_le k r]

lemma FinSupp.bdd (ha : FinSupp a S) (k : ℤ) : BddAbove (Set.range (avgZ a k)) :=
  ⟨_, Set.forall_mem_range.2 (ha.avgZ_le k)⟩

lemma FinSupp.avgZ_le_maxZ (ha : FinSupp a S) (k : ℤ) (r : ℕ) : avgZ a k r ≤ maxZ a k :=
  le_ciSup (ha.bdd k) r

lemma FinSupp.avgZ_nonneg (ha : FinSupp a S) (k : ℤ) (r : ℕ) : 0 ≤ avgZ a k r := by
  unfold avgZ
  exact div_nonneg (Finset.sum_nonneg fun j _ => ha.nonneg j) (by positivity)

lemma FinSupp.maxZ_nonneg (ha : FinSupp a S) (k : ℤ) : 0 ≤ maxZ a k :=
  (ha.avgZ_nonneg k 0).trans (ha.avgZ_le_maxZ k 0)

lemma FinSupp.maxZ_le (ha : FinSupp a S) (k : ℤ) : maxZ a k ≤ ∑ j ∈ S, a j :=
  ciSup_le (ha.avgZ_le k)

lemma FinSupp.sum_Icc_le_maxZ (ha : FinSupp a S) (k : ℤ) (r : ℕ) :
    ∑ j ∈ Finset.Icc (k - r) (k + r), a j ≤ (2 * r + 1) * maxZ a k := by
  have := ha.avgZ_le_maxZ k r
  unfold avgZ at this
  rwa [div_le_iff₀ (by positivity), mul_comm] at this

lemma card_Icc_center (k : ℤ) (r : ℕ) : ((Finset.Icc (k - r) (k + r)).card : ℝ) = 2 * r + 1 := by
  rw [Int.card_Icc]
  have : (k + r + 1 - (k - r)).toNat = 2 * r + 1 := by omega
  rw [this]; push_cast; ring

lemma card_Icc_center' (k : ℤ) (r : ℕ) (x : ℝ) :
    (Finset.Icc (k - r) (k + r)).card • x = (2 * r + 1) * x := by
  rw [nsmul_eq_mul, card_Icc_center]

/-- **Weak type (1,1)** of `M_ℤ` (Vitali covering, constant 5). -/
theorem FinSupp.weak_maxZ (ha : FinSupp a S) {t : ℝ} (ht : 0 < t) (F : Finset ℤ) :
    t * (F.filter fun k => t < maxZ a k).card ≤ 5 * ∑ j ∈ S, a j := by
  classical
  set F' := F.filter fun k => t < maxZ a k
  -- a radius with large average at each point of `F'`
  have hr : ∀ k ∈ F', ∃ r : ℕ, t < avgZ a k r := by
    intro k hk
    exact exists_lt_of_lt_ciSup (Finset.mem_filter.1 hk).2
  choose! r hr using hr
  set B : ℤ → Set ℤ := fun k => Set.Icc (k - r k) (k + r k)
  obtain ⟨u, hu, hdisj, hcov⟩ := Vitali.exists_disjoint_subfamily_covering_enlargement B
    (F' : Set ℤ) (fun k => (r k : ℝ)) 2 one_lt_two (fun k _ => Nat.cast_nonneg _)
    (∑ k ∈ F', (r k : ℝ)) (fun k hk => Finset.single_le_sum (f := fun k => (r k : ℝ))
      (fun _ _ => Nat.cast_nonneg _) hk) (fun k _ => ⟨k, by simp [B]⟩)
  have hufin : u.Finite := (F'.finite_toSet).subset hu
  set U := hufin.toFinset
  have hU : ∀ b ∈ U, b ∈ F' := fun b hb => hu (hufin.mem_toFinset.1 hb)
  -- covering by the five-fold enlargements
  have hcover : F' ⊆ U.biUnion fun b => Finset.Icc (b - 5 * r b) (b + 5 * r b) := by
    intro k hk
    obtain ⟨b, hb, ⟨x, hx1, hx2⟩, hrb⟩ := hcov k hk
    simp only [Finset.mem_biUnion, Finset.mem_Icc]
    refine ⟨b, hufin.mem_toFinset.2 hb, ?_⟩
    simp only [B, Set.mem_Icc] at hx1 hx2
    have : (r k : ℝ) ≤ 2 * r b := hrb
    have : r k ≤ 2 * r b := by exact_mod_cast this
    constructor <;> omega
  have hcard : (F'.card : ℝ) ≤ ∑ b ∈ U, 5 * (2 * (r b : ℝ) + 1) := by
    calc (F'.card : ℝ) ≤ ((U.biUnion fun b => Finset.Icc (b - 5 * r b) (b + 5 * r b)).card : ℝ) := by
          exact_mod_cast Finset.card_le_card hcover
      _ ≤ ∑ b ∈ U, ((Finset.Icc (b - 5 * r b) (b + 5 * r b)).card : ℝ) := by
          exact_mod_cast Finset.card_biUnion_le
      _ ≤ ∑ b ∈ U, 5 * (2 * (r b : ℝ) + 1) := by
          refine Finset.sum_le_sum fun b _ => ?_
          have := card_Icc_center b (5 * r b)
          push_cast at this
          rw [this]; nlinarith [(r b).cast_nonneg (α := ℝ)]
  -- each selected interval carries mass `> t (2r+1)`
  have hmass : ∀ b ∈ U, t * (2 * (r b : ℝ) + 1) ≤ ∑ j ∈ Finset.Icc (b - r b) (b + r b), a j := by
    intro b hb
    have := hr b (hU b hb)
    unfold avgZ at this
    rw [lt_div_iff₀ (by positivity)] at this
    linarith
  have hdisj' : Set.PairwiseDisjoint (↑U) fun b => Finset.Icc (b - r b) (b + r b) := by
    intro b hb c hc hbc
    have := hdisj (hufin.mem_toFinset.1 hb) (hufin.mem_toFinset.1 hc) hbc
    simp only [Function.onFun, B] at this
    rw [Function.onFun, ← Finset.disjoint_coe]
    simpa using this
  have hsumU : ∑ b ∈ U, ∑ j ∈ Finset.Icc (b - r b) (b + r b), a j ≤ ∑ j ∈ S, a j := by
    rw [← Finset.sum_biUnion hdisj']
    exact ha.sum_le _
  calc t * F'.card ≤ t * ∑ b ∈ U, 5 * (2 * (r b : ℝ) + 1) := by gcongr
    _ = 5 * ∑ b ∈ U, t * (2 * (r b : ℝ) + 1) := by rw [Finset.mul_sum, Finset.mul_sum]; ring_nf
    _ ≤ 5 * ∑ b ∈ U, ∑ j ∈ Finset.Icc (b - r b) (b + r b), a j := by
        gcongr with b hb; exact hmass b hb
    _ ≤ 5 * ∑ j ∈ S, a j := by gcongr

lemma lintegral_Ioo_rpow {p x : ℝ} (hp : 1 < p) (hx : 0 ≤ x) :
    ∫⁻ t in Set.Ioo 0 x, ENNReal.ofReal (t ^ (p - 2)) = ENNReal.ofReal (x ^ (p - 1) / (p - 1)) := by
  have hr : -1 < p - 2 := by linarith
  have hint : IntegrableOn (fun t : ℝ => t ^ (p - 2)) (Set.Ioo 0 x) := by
    have := (intervalIntegral.intervalIntegrable_rpow' hr (a := 0) (b := x))
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hx] at this
    exact this.mono_set Set.Ioo_subset_Ioc_self
  rw [← ofReal_integral_eq_lintegral_ofReal hint]
  · congr 1
    rw [← integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le hx,
      integral_rpow (Or.inl hr), Real.zero_rpow (by linarith)]
    ring_nf
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
    exact Real.rpow_nonneg ht.1.le _

/-- Truncated weak bound: `t #{M_ℤ a > t} ≤ 10 ∑_{a > t/2} a`. -/
lemma FinSupp.weak_maxZ_trunc (ha : FinSupp a S) {t : ℝ} (ht : 0 < t) (F : Finset ℤ) :
    t * (F.filter fun k => t < maxZ a k).card ≤
      10 * ∑ j ∈ S, (if t < 2 * a j then a j else 0) := by
  classical
  set b : ℤ → ℝ := fun j => if t < 2 * a j then a j else 0
  have hb : FinSupp b S := ⟨fun j => by simp only [b]; split_ifs; exacts [ha.nonneg j, le_rfl],
    fun j hj => by simp only [b, ha.supp j hj]; simp⟩
  -- `M a ≤ t/2 + M b`
  have hsub : ∀ k, maxZ a k ≤ t / 2 + maxZ b k := by
    intro k
    refine ciSup_le fun r => ?_
    have h1 : avgZ a k r ≤ t / 2 + avgZ b k r := by
      unfold avgZ
      have hpos : (0 : ℝ) < 2 * r + 1 := by positivity
      have hsum : ∑ j ∈ Finset.Icc (k - r) (k + r), a j ≤
          ∑ j ∈ Finset.Icc (k - r) (k + r), (t / 2 + b j) := by
        refine Finset.sum_le_sum fun j _ => ?_
        simp only [b]; split_ifs with h
        · linarith
        · linarith
      rw [Finset.sum_add_distrib, Finset.sum_const, card_Icc_center' k r] at hsum
      rw [div_le_iff₀ hpos, add_mul, div_mul_cancel₀ _ hpos.ne']
      linarith
    linarith [hb.avgZ_le_maxZ k r]
  have hsubset : (F.filter fun k => t < maxZ a k) ⊆ F.filter fun k => t / 2 < maxZ b k := by
    intro k hk
    simp only [Finset.mem_filter] at hk ⊢
    exact ⟨hk.1, by linarith [hsub k]⟩
  have hw := hb.weak_maxZ (half_pos ht) F
  have hc : ((F.filter fun k => t < maxZ a k).card : ℝ) ≤
      (F.filter fun k => t / 2 < maxZ b k).card := by exact_mod_cast Finset.card_le_card hsubset
  nlinarith

/-- **Lemma 5.1 (node D01), strong bound:** for `1 < p`,
`∑_k (M_ℤ a(k))^p ≤ C_p ∑_k a(k)^p` with `C_p = 10 p 2^{p-1}/(p-1)` (sums over any finite
window on the left). -/
theorem FinSupp.strong_maxZ (ha : FinSupp a S) {p : ℝ} (hp : 1 < p) (F : Finset ℤ) :
    ∑ k ∈ F, maxZ a k ^ p ≤ 10 * p * 2 ^ (p - 1) / (p - 1) * ∑ j ∈ S, a j ^ p := by
  classical
  have hp0 : 0 < p := by linarith
  set μ : Measure ℤ := (Measure.count : Measure ℤ).restrict (F : Set ℤ)
  have hM : ∀ k, 0 ≤ maxZ a k := ha.maxZ_nonneg
  have h1 : ∫⁻ k, ENNReal.ofReal (maxZ a k ^ p) ∂μ = ∑ k ∈ F, ENNReal.ofReal (maxZ a k ^ p) := by
    rw [lintegral_finset]
    simp
  have h2 := lintegral_rpow_eq_lintegral_meas_lt_mul μ (Eventually.of_forall hM)
    (Measurable.of_discrete.aemeasurable) hp0
  have hmeas : ∀ t, μ {k | t < maxZ a k} = (F.filter fun k => t < maxZ a k).card := by
    intro t
    rw [Measure.restrict_apply' F.measurableSet]
    have : {k | t < maxZ a k} ∩ (F : Set ℤ) = ↑(F.filter fun k => t < maxZ a k) := by
      ext k; simp [and_comm]
    rw [this, Measure.count_apply_finset]
  set c : ℤ → ℝ := fun j => 10 * a j
  have h3 : ∀ t ∈ Set.Ioi (0 : ℝ), μ {k | t < maxZ a k} * ENNReal.ofReal (t ^ (p - 1)) ≤
      ∑ j ∈ S, ENNReal.ofReal (c j) *
        (Set.Ioo 0 (2 * a j)).indicator (fun t => ENNReal.ofReal (t ^ (p - 2))) t := by
    intro t ht
    have ht0 : (0 : ℝ) < t := ht
    rw [hmeas]
    have hw := ha.weak_maxZ_trunc ht0 F
    have htp : 0 ≤ t ^ (p - 2) := Real.rpow_nonneg ht0.le _
    have hrhs : ∑ j ∈ S, ENNReal.ofReal (c j) *
        (Set.Ioo 0 (2 * a j)).indicator (fun t => ENNReal.ofReal (t ^ (p - 2))) t =
        ENNReal.ofReal (10 * (∑ j ∈ S, (if t < 2 * a j then a j else 0)) * t ^ (p - 2)) := by
      rw [Finset.mul_sum, Finset.sum_mul, ENNReal.ofReal_sum_of_nonneg]
      · refine Finset.sum_congr rfl fun j _ => ?_
        by_cases hj : t < 2 * a j
        · rw [Set.indicator_of_mem (show t ∈ Set.Ioo 0 (2 * a j) from ⟨ht0, hj⟩), if_pos hj, ← ENNReal.ofReal_mul (by
            simp only [c]; linarith [ha.nonneg j])]
        · rw [Set.indicator_of_notMem (fun h => hj h.2)]; simp [hj]
      · intro j _
        split_ifs
        · have := ha.nonneg j; positivity
        · simp
    rw [hrhs, ← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (Nat.cast_nonneg _)]
    refine ENNReal.ofReal_le_ofReal ?_
    have hpow : t ^ (p - 1) = t * t ^ (p - 2) := by
      rw [show p - 1 = (p - 2) + 1 by ring, Real.rpow_add_one ht0.ne']; ring
    rw [hpow]
    nlinarith [mul_le_mul_of_nonneg_right hw htp]
  have h4 : ∫⁻ t in Set.Ioi 0, μ {k | t < maxZ a k} * ENNReal.ofReal (t ^ (p - 1)) ≤
      ∑ j ∈ S, ENNReal.ofReal (c j) * ENNReal.ofReal ((2 * a j) ^ (p - 1) / (p - 1)) := by
    calc ∫⁻ t in Set.Ioi 0, μ {k | t < maxZ a k} * ENNReal.ofReal (t ^ (p - 1))
        ≤ ∫⁻ t in Set.Ioi 0, ∑ j ∈ S, ENNReal.ofReal (c j) *
            (Set.Ioo 0 (2 * a j)).indicator (fun t => ENNReal.ofReal (t ^ (p - 2))) t :=
          setLIntegral_mono' measurableSet_Ioi h3
      _ = ∑ j ∈ S, ENNReal.ofReal (c j) *
            ∫⁻ t in Set.Ioi 0, (Set.Ioo 0 (2 * a j)).indicator
              (fun t => ENNReal.ofReal (t ^ (p - 2))) t := by
          rw [lintegral_finsetSum' _ fun j _ => (Measurable.const_mul (Measurable.indicator
            (by fun_prop) measurableSet_Ioo) _).aemeasurable]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [lintegral_const_mul _ (Measurable.indicator (by fun_prop) measurableSet_Ioo)]
      _ = _ := by
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [lintegral_indicator measurableSet_Ioo, Measure.restrict_restrict measurableSet_Ioo,
            Set.inter_eq_left.2 (fun t ht => ht.1), lintegral_Ioo_rpow hp
              (by linarith [ha.nonneg j])]
  have h5 : ∑ j ∈ S, ENNReal.ofReal (c j) * ENNReal.ofReal ((2 * a j) ^ (p - 1) / (p - 1)) =
      ENNReal.ofReal (10 * 2 ^ (p - 1) / (p - 1) * ∑ j ∈ S, a j ^ p) := by
    rw [Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg]
    · refine Finset.sum_congr rfl fun j _ => ?_
      have haj := ha.nonneg j
      have hp1 : 0 < p - 1 := by linarith
      rw [← ENNReal.ofReal_mul (by simp only [c]; positivity)]
      congr 1
      simp only [c]
      rw [Real.mul_rpow (by norm_num) haj]
      have : a j * a j ^ (p - 1) = a j ^ p := by
        rcases haj.eq_or_lt with h | h
        · rw [← h, Real.zero_rpow (by linarith), Real.zero_rpow (by linarith)]; ring
        · rw [show p = 1 + (p - 1) by ring, Real.rpow_add h, Real.rpow_one]; ring_nf
      rw [← this]
      field_simp
    · intro j _; have := ha.nonneg j; have : 0 < p - 1 := by linarith
      positivity
  have htot : ∑ k ∈ F, ENNReal.ofReal (maxZ a k ^ p) ≤
      ENNReal.ofReal (10 * p * 2 ^ (p - 1) / (p - 1) * ∑ j ∈ S, a j ^ p) := by
    rw [← h1, h2]
    calc ENNReal.ofReal p * ∫⁻ t in Set.Ioi 0, μ {k | t < maxZ a k} * ENNReal.ofReal (t ^ (p - 1))
        ≤ ENNReal.ofReal p * ENNReal.ofReal (10 * 2 ^ (p - 1) / (p - 1) * ∑ j ∈ S, a j ^ p) := by
          gcongr; exact h4.trans h5.le
      _ = _ := by
          rw [← ENNReal.ofReal_mul hp0.le]; congr 1; ring
  rw [← ENNReal.ofReal_sum_of_nonneg (fun k _ => Real.rpow_nonneg (hM k) _)] at htot
  exact (ENNReal.ofReal_le_ofReal_iff (by
    have : 0 ≤ ∑ j ∈ S, a j ^ p := Finset.sum_nonneg fun j _ => Real.rpow_nonneg (ha.nonneg j) _
    have : 0 < p - 1 := by linarith
    positivity)).1 htot

lemma Icc_succ_center (k : ℤ) (N : ℕ) :
    Finset.Icc (k - (N + 1 : ℕ)) (k + (N + 1 : ℕ)) =
      insert (k - (N + 1 : ℕ)) (insert (k + (N + 1 : ℕ)) (Finset.Icc (k - N) (k + N))) := by
  ext j; simp only [Finset.mem_Icc, Finset.mem_insert]; push_cast; omega

/-- Abel summation for a radial weight `ψ(|j - k|)` over centered intervals. -/
lemma abel_radial (ψ : ℕ → ℝ) (b : ℤ → ℝ) (k : ℤ) (N : ℕ) :
    ∑ j ∈ Finset.Icc (k - N) (k + N), ψ (j - k).natAbs * b j =
      ∑ r ∈ Finset.range (N + 1), (ψ r - ψ (r + 1)) * ∑ j ∈ Finset.Icc (k - r) (k + r), b j +
        ψ (N + 1) * ∑ j ∈ Finset.Icc (k - N) (k + N), b j := by
  induction N with
  | zero =>
    simp only [Nat.cast_zero, sub_zero, add_zero, Finset.Icc_self, Finset.sum_singleton,
      sub_self, Int.natAbs_zero, zero_add, Finset.range_one]
    ring
  | succ N ih =>
    have h1 : k - (N + 1 : ℕ) ∉ insert (k + (N + 1 : ℕ)) (Finset.Icc (k - N) (k + N)) := by
      simp only [Finset.mem_insert, Finset.mem_Icc]; push_cast; omega
    have h2 : k + (N + 1 : ℕ) ∉ Finset.Icc (k - N) (k + N) := by
      simp only [Finset.mem_Icc]; push_cast; omega
    have hA : ∀ f : ℤ → ℝ, ∑ j ∈ Finset.Icc (k - (N + 1 : ℕ)) (k + (N + 1 : ℕ)), f j =
        f (k - (N + 1 : ℕ)) + (f (k + (N + 1 : ℕ)) + ∑ j ∈ Finset.Icc (k - N) (k + N), f j) := by
      intro f
      rw [Icc_succ_center, Finset.sum_insert h1, Finset.sum_insert h2]
    have e1 : (k - (N + 1 : ℕ) - k).natAbs = N + 1 := by omega
    have e2 : (k + (N + 1 : ℕ) - k).natAbs = N + 1 := by omega
    rw [Finset.sum_range_succ]
    simp only [hA]
    rw [ih, e1, e2]
    ring

/-- **Lemma 5.1 (node D01), Gaussian averages:** for `τ ≥ h²` and `a ≥ 0`,
`∑_j h g_τ(h(j-k)) a(j) ≤ (1 + √(2/π)) M_ℤ a(k)`. -/
theorem FinSupp.gaussian_le_maxZ (ha : FinSupp a S) {h τ : ℝ} (hh : 0 < h) (hτ : h ^ 2 ≤ τ)
    (k : ℤ) :
    ∑ j ∈ S, h * gaussian τ (h * (j - k)) * a j ≤ (1 + √(2 / π)) * maxZ a k := by
  classical
  have hτ0 : 0 < τ := lt_of_lt_of_le (by positivity) hτ
  set ψ : ℕ → ℝ := fun r => h * gaussian τ (h * r)
  have hψ : ∀ j : ℤ, h * gaussian τ (h * (j - k)) = ψ (j - k).natAbs := by
    intro j
    simp only [ψ, gaussian]
    congr 3
    rw [mul_pow, mul_pow, Nat.cast_natAbs, Int.cast_abs, sq_abs]
    push_cast; ring
  have hψnn : ∀ r, 0 ≤ ψ r := fun r => mul_nonneg hh.le (gaussian_nonneg' _ _)
  have hψmono : ∀ r, ψ (r + 1) ≤ ψ r := by
    intro r
    refine mul_le_mul_of_nonneg_left (gaussian_anti hτ0 ?_) hh.le
    rw [abs_of_nonneg (by positivity), abs_of_nonneg (by positivity)]
    push_cast; nlinarith
  -- a window containing the support
  obtain ⟨N, hN⟩ : ∃ N : ℕ, S ⊆ Finset.Icc (k - N) (k + N) := by
    refine ⟨∑ j ∈ S, (j - k).natAbs, fun j hj => ?_⟩
    have := Finset.single_le_sum (f := fun j => (j - k).natAbs) (fun _ _ => Nat.zero_le _) hj
    simp only [Finset.mem_Icc]
    have h' : ((j - k).natAbs : ℤ) ≤ ((∑ j ∈ S, (j - k).natAbs : ℕ) : ℤ) := by exact_mod_cast this
    constructor <;> omega
  have hext : ∑ j ∈ S, h * gaussian τ (h * (j - k)) * a j =
      ∑ j ∈ Finset.Icc (k - N) (k + N), ψ (j - k).natAbs * a j := by
    rw [Finset.sum_subset hN (fun j _ hj => by rw [ha.supp j hj, mul_zero])]
    exact Finset.sum_congr rfl fun j _ => by rw [hψ]
  set c := maxZ a k
  have hc : 0 ≤ c := ha.maxZ_nonneg k
  have hab := abel_radial ψ a k N
  have hone := abel_radial ψ (fun _ => 1) k N
  simp only [mul_one, Finset.sum_const, card_Icc_center'] at hone
  have hbound : ∑ j ∈ Finset.Icc (k - N) (k + N), ψ (j - k).natAbs * a j ≤
      c * ∑ j ∈ Finset.Icc (k - N) (k + N), ψ (j - k).natAbs := by
    rw [hab, hone]
    have hsum : ∑ r ∈ Finset.range (N + 1), (ψ r - ψ (r + 1)) *
        ∑ j ∈ Finset.Icc (k - r) (k + r), a j ≤
        ∑ r ∈ Finset.range (N + 1), (ψ r - ψ (r + 1)) * ((2 * r + 1) * c) :=
      Finset.sum_le_sum fun r _ =>
        mul_le_mul_of_nonneg_left (ha.sum_Icc_le_maxZ k r) (sub_nonneg.2 (hψmono r))
    have htail : ψ (N + 1) * ∑ j ∈ Finset.Icc (k - N) (k + N), a j ≤
        ψ (N + 1) * ((2 * N + 1) * c) :=
      mul_le_mul_of_nonneg_left (ha.sum_Icc_le_maxZ k N) (hψnn (N + 1))
    refine (add_le_add hsum htail).trans (le_of_eq ?_)
    rw [mul_add, Finset.mul_sum]
    congr 1
    · exact Finset.sum_congr rfl fun r _ => by ring
    · ring
  -- the total mass of the radial weights
  have hmass : ∑ j ∈ Finset.Icc (k - N) (k + N), ψ (j - k).natAbs ≤ 1 + √(2 / π) := by
    have := sum_gweight_le (ι := Finset.Icc (k - N) (k + N)) (fun j => h * (j : ℤ)) hh hτ
      (fun j => (j : ℤ)) Subtype.val_injective (fun j => rfl) (h * k)
    rw [← Finset.sum_coe_sort]
    convert this using 2 with j
    rw [← hψ]
    simp only [gweight]
    congr 2; ring
  rw [hext]
  calc _ ≤ c * ∑ j ∈ Finset.Icc (k - N) (k + N), ψ (j - k).natAbs := hbound
    _ ≤ c * (1 + √(2 / π)) := mul_le_mul_of_nonneg_left hmass hc
    _ = _ := mul_comm _ _

end D01

/-! ### Gaussian integrals on the center space (used in Lemma 5.2) -/

section D02Gauss

lemma gaussian_neg (σ t : ℝ) : gaussian σ (-t) = gaussian σ t := by
  simp [gaussian]

/-- `∫ g_a(S + z) g_b(c - z) dz = g_{a+b}(S + c)`. -/
lemma gaussian_conv_shift {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (S c : ℝ) :
    ∫ z, gaussian a (S + z) * gaussian b (c - z) = gaussian (a + b) (S + c) := by
  have := gaussian_conv_gaussian ha hb (S + c)
  rw [← this, ← integral_sub_left_eq_self (fun d => gaussian a (S + c - d) * gaussian b d)
    volume c]
  congr 1; funext z
  simp only [show S + c - (c - z) = S + z by ring]

/-- `∫ g_a(u - t) g_b(v - t) dt = g_{a+b}(u - v)`. -/
lemma gaussian_prod_integral {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (u v : ℝ) :
    ∫ t, gaussian a (u - t) * gaussian b (v - t) = gaussian (a + b) (u - v) := by
  have := gaussian_conv_shift ha hb (u - v) 0
  rw [add_zero] at this
  rw [← this, ← integral_sub_left_eq_self
    (fun z => gaussian a (u - v + z) * gaussian b (0 - z)) volume v]
  congr 1; funext t
  simp only [show u - v + (v - t) = u - t by ring, show (0 : ℝ) - (v - t) = -(v - t) by ring,
    gaussian_neg]

lemma integrable_gaussian_mul_gaussian {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (u v : ℝ) :
    Integrable (fun t => gaussian a (u - t) * gaussian b (v - t)) := by
  have h1 : Integrable (fun t => gaussian a (u - t)) := (integrable_gaussian' ha).comp_sub_left u
  have hc : Continuous fun t => gaussian b (v - t) :=
    (continuous_gaussian' b).comp (continuous_const.sub continuous_id)
  exact h1.mul_bdd (c := (√(2 * π * b))⁻¹) hc.aestronglyMeasurable
    (Eventually.of_forall fun t => by
      show ‖gaussian b (v - t)‖ ≤ _
      rw [Real.norm_eq_abs, abs_of_nonneg (gaussian_nonneg' _ _)]; exact gaussian_le_sup _ _)

/-- Iterated integrals on `ℝ³`: `∫ F = ∫∫∫ F(x, y, z)` for integrable `F`. -/
lemma integral_fin3 {F : (Fin 3 → ℝ) → ℝ} (hF : Integrable F) :
    ∫ p, F p = ∫ x, ∫ y, ∫ z, F ![x, y, z] := by
  set e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0
  have hmp : MeasurePreserving e.symm ((volume : Measure ℝ).prod (volume : Measure (Fin 2 → ℝ)))
      volume := (volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).symm
  have h2 := (volume_preserving_finTwoArrow ℝ).symm
  have hint : Integrable (fun z : ℝ × (Fin 2 → ℝ) => F (e.symm z))
      ((volume : Measure ℝ).prod volume) :=
    (hmp.integrable_comp_emb e.symm.measurableEmbedding).2 hF
  rw [← hmp.integral_comp' (g := F), integral_prod _ hint]
  refine integral_congr_ae ?_
  filter_upwards [hint.prod_right_ae] with x hx
  set E2 := MeasurableEquiv.finTwoArrow (α := ℝ)
  have hint2 : Integrable (fun yz : ℝ × ℝ => F (e.symm (x, E2.symm yz)))
      ((volume : Measure ℝ).prod volume) :=
    (h2.integrable_comp_emb E2.symm.measurableEmbedding).2 hx
  rw [← h2.integral_comp' (g := fun q => F (e.symm (x, q))), Measure.volume_eq_prod,
    integral_prod _ hint2]
  refine integral_congr_ae (Eventually.of_forall fun y =>
    integral_congr_ae (Eventually.of_forall fun z => ?_))
  show F (e.symm (x, E2.symm (y, z))) = F ![x, y, z]
  congr 1
  ext i
  fin_cases i <;> rfl

/-- Plane integral of one weight at the center `a` and two weights at the center `b`:
`∫ g_τ(p₀+p₁+p₂) w_a w_b w_b' dp = h³ g_{2σ_b}(u_b - u_b')`. -/
lemma plane_gauss_two {τ σa σb : ℝ} (hτ : 0 < τ) (hσa : 0 < σa) (hσb : 0 < σb) {a b : Fin 3}
    (hab : a ≠ b) (ua ub ub' h : ℝ) :
    Integrable (fun p : Fin 3 → ℝ => gaussian τ (p 0 + p 1 + p 2) *
      (h * gaussian σa (ua - p a) * (h * gaussian σb (ub - p b) * (h * gaussian σb (ub' - p b))))) ∧
    ∫ p : Fin 3 → ℝ, gaussian τ (p 0 + p 1 + p 2) *
      (h * gaussian σa (ua - p a) * (h * gaussian σb (ub - p b) * (h * gaussian σb (ub' - p b)))) =
      h ^ 3 * gaussian (σb + σb) (ub - ub') := by
  have hg : Integrable (fun t => h * gaussian σb (ub - t) * (h * gaussian σb (ub' - t))) := by
    have := (integrable_gaussian_mul_gaussian hσb hσb ub ub').const_mul (h * h)
    refine this.congr (Eventually.of_forall fun t => ?_)
    simp only; ring
  obtain ⟨hI, hV⟩ := plane_integral_prod (k := gaussian τ)
    (f := fun t => h * gaussian σa (ua - t))
    (g := fun t => h * gaussian σb (ub - t) * (h * gaussian σb (ub' - t)))
    (continuous_gaussian' _)
    (continuous_const.mul ((continuous_gaussian' _).comp (continuous_const.sub continuous_id)))
    ((continuous_const.mul ((continuous_gaussian' _).comp (continuous_const.sub continuous_id))).mul
      (continuous_const.mul ((continuous_gaussian' _).comp (continuous_const.sub continuous_id))))
    (integrable_gaussian' hτ) (integrable_weight_line _ _ _ hσa) hg hab
  refine ⟨hI, ?_⟩
  rw [hV, integral_gaussian_eq_one hτ, integral_weight_line _ _ _ hσa]
  have : ∫ t, h * gaussian σb (ub - t) * (h * gaussian σb (ub' - t)) =
      h * h * gaussian (σb + σb) (ub - ub') := by
    rw [← gaussian_prod_integral hσb hσb ub ub', ← integral_const_mul]
    congr 1; funext t; ring
  rw [this]; ring

/-- Plane integral of one weight at each center:
`∫ g_τ(p₀+p₁+p₂) w₀ w₁ w₂ dp = h³ g_{τ+σ₀+σ₁+σ₂}(c₀ + c₁ + c₂)`. -/
lemma plane_gauss_three {τ σ₀ σ₁ σ₂ : ℝ} (hτ : 0 < τ) (h₀ : 0 < σ₀) (h₁ : 0 < σ₁) (h₂ : 0 < σ₂)
    (c₀ c₁ c₂ h : ℝ) :
    Integrable (fun p : Fin 3 → ℝ => gaussian τ (p 0 + p 1 + p 2) *
      (h * gaussian σ₀ (c₀ - p 0) * (h * gaussian σ₁ (c₁ - p 1) * (h * gaussian σ₂ (c₂ - p 2))))) ∧
    ∫ p : Fin 3 → ℝ, gaussian τ (p 0 + p 1 + p 2) *
      (h * gaussian σ₀ (c₀ - p 0) * (h * gaussian σ₁ (c₁ - p 1) * (h * gaussian σ₂ (c₂ - p 2)))) =
      h ^ 3 * gaussian (τ + σ₂ + σ₁ + σ₀) (c₀ + c₁ + c₂) := by
  set F : (Fin 3 → ℝ) → ℝ := fun p => gaussian τ (p 0 + p 1 + p 2) *
      (h * gaussian σ₀ (c₀ - p 0) * (h * gaussian σ₁ (c₁ - p 1) * (h * gaussian σ₂ (c₂ - p 2))))
  have hcont : Continuous F := by
    simp only [F]
    have := continuous_gaussian' τ
    have := continuous_gaussian' σ₀
    have := continuous_gaussian' σ₁
    have := continuous_gaussian' σ₂
    fun_prop
  have hprod : Integrable (fun p : Fin 3 → ℝ =>
      ∏ k : Fin 3, ![fun t => |h| * gaussian σ₀ (c₀ - t), fun t => |h| * gaussian σ₁ (c₁ - t),
        fun t => |h| * gaussian σ₂ (c₂ - t)] k (p k)) := by
    refine Integrable.fintype_prod fun k => ?_
    fin_cases k
    · exact integrable_weight_line _ _ _ h₀
    · exact integrable_weight_line _ _ _ h₁
    · exact integrable_weight_line _ _ _ h₂
  have hI : Integrable F := by
    refine (hprod.const_mul (√(2 * π * τ))⁻¹).mono' hcont.aestronglyMeasurable
      (Eventually.of_forall fun p => ?_)
    simp only [F, Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Real.norm_eq_abs, abs_mul,
      abs_of_nonneg (gaussian_nonneg' _ _)]
    have := gaussian_le_sup τ (p 0 + p 1 + p 2)
    have : 0 ≤ |h| * gaussian σ₀ (c₀ - p 0) * (|h| * gaussian σ₁ (c₁ - p 1) *
        (|h| * gaussian σ₂ (c₂ - p 2))) := by
      have := gaussian_nonneg' σ₀ (c₀ - p 0)
      have := gaussian_nonneg' σ₁ (c₁ - p 1)
      have := gaussian_nonneg' σ₂ (c₂ - p 2)
      positivity
    nlinarith
  refine ⟨hI, ?_⟩
  rw [integral_fin3 hI]
  simp only [F, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.head_cons, Matrix.tail_cons]
  have step1 : ∀ x y : ℝ, ∫ z, gaussian τ (x + y + z) *
      (h * gaussian σ₀ (c₀ - x) * (h * gaussian σ₁ (c₁ - y) * (h * gaussian σ₂ (c₂ - z)))) =
      h * gaussian σ₀ (c₀ - x) * (h * gaussian σ₁ (c₁ - y) *
        (h * gaussian (τ + σ₂) (x + y + c₂))) := by
    intro x y
    rw [← gaussian_conv_shift hτ h₂ (x + y) c₂]
    simp only [← integral_const_mul]
    congr 1; funext z; ring
  simp_rw [step1]
  have step2 : ∀ x : ℝ, ∫ y, h * gaussian σ₀ (c₀ - x) * (h * gaussian σ₁ (c₁ - y) *
      (h * gaussian (τ + σ₂) (x + y + c₂))) =
      h * gaussian σ₀ (c₀ - x) * (h * h * gaussian (τ + σ₂ + σ₁) (x + c₂ + c₁)) := by
    intro x
    rw [← gaussian_conv_shift (by positivity : 0 < τ + σ₂) h₁ (x + c₂) c₁]
    simp only [← integral_const_mul]
    congr 1; funext y
    rw [show x + y + c₂ = x + c₂ + y by ring]; ring
  simp_rw [step2]
  rw [show c₀ + c₁ + c₂ = c₂ + c₁ + c₀ by ring,
    ← gaussian_conv_shift (by positivity : 0 < τ + σ₂ + σ₁) h₀ (c₂ + c₁) c₀,
    ← integral_const_mul]
  congr 1; funext x
  rw [show x + c₂ + c₁ = c₂ + c₁ + x by ring]
  ring

end D02Gauss

/-! ### Lemma 5.2: expectations of the weights under the edge densities -/

section D02Expect

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Extension by zero of a function on the mesh to the integers, `zext f (kᵢ) = f i`. -/
def zext (kk : ι → ℤ) (f : ι → ℝ) (z : ℤ) : ℝ := ∑ m ∈ Finset.univ.filter (fun m => kk m = z), f m

omit [DecidableEq ι] in
lemma zext_kk {kk : ι → ℤ} (hk : Function.Injective kk) (f : ι → ℝ) (m : ι) :
    zext kk f (kk m) = f m := by
  unfold zext
  rw [Finset.sum_eq_single m]
  · intro b hb hbm
    exact absurd (hk (Finset.mem_filter.1 hb).2) hbm
  · intro hm; exact absurd (by simp : m ∈ Finset.univ.filter (fun m' => kk m' = kk m)) hm

omit [DecidableEq ι] in
lemma zext_finSupp {kk : ι → ℤ} {f : ι → ℝ} (hf : ∀ m, 0 ≤ f m) :
    FinSupp (zext kk f) (Finset.univ.image kk) := by
  classical
  refine ⟨fun z => Finset.sum_nonneg fun m _ => hf m, fun z hz => ?_⟩
  refine Finset.sum_eq_zero fun m hm => ?_
  exact absurd (Finset.mem_image.2 ⟨m, Finset.mem_univ m, (Finset.mem_filter.1 hm).2⟩) hz

omit [DecidableEq ι] in
lemma sum_image_zext {kk : ι → ℤ} (hk : Function.Injective kk) (φ : ℤ → ℝ) (f : ι → ℝ) :
    ∑ z ∈ Finset.univ.image kk, φ z * zext kk f z = ∑ m, φ (kk m) * f m := by
  classical
  rw [Finset.sum_image fun x _ y _ h => hk h]
  exact Finset.sum_congr rfl fun m _ => by rw [zext_kk hk]

omit [DecidableEq ι] in
/-- Gaussian sums over the mesh are dominated by the maximal function (D01 in mesh form). -/
lemma mesh_gauss_le_maxZ {kk : ι → ℤ} (hk : Function.Injective kk) {f : ι → ℝ}
    (hf : ∀ m, 0 ≤ f m) {h τ : ℝ} (hh : 0 < h) (hτ : h ^ 2 ≤ τ) (z : ℤ) :
    ∑ m, h * gaussian τ (h * (kk m - z)) * f m ≤ (1 + √(2 / π)) * maxZ (zext kk f) z := by
  have := (zext_finSupp (kk := kk) hf).gaussian_le_maxZ hh hτ z
  rwa [sum_image_zext hk (fun w => h * gaussian τ (h * (w - z))) f] at this

namespace HeatData

variable (Hd : HeatData ι)

/-- `X(i)² = ∑_m |A(i,m)|² w₁(m)`. -/
def Xf (A : Matrix ι ι ℂ) (p σ : Fin 3 → ℝ) (i : ι) : ℝ := √(∑ m, ‖A i m‖ ^ 2 * Hd.w p σ 1 m)
/-- `Y(j)² = ∑_m |A(m,j)|² w₀(m)`. -/
def Yf (A : Matrix ι ι ℂ) (p σ : Fin 3 → ℝ) (j : ι) : ℝ := √(∑ m, ‖A m j‖ ^ 2 * Hd.w p σ 0 m)
/-- `H(i)² = ∑_m |A₂(m,i)|² w₂(m)`. -/
def Hf (A : Matrix ι ι ℂ) (p σ : Fin 3 → ℝ) (i : ι) : ℝ := √(∑ m, ‖A m i‖ ^ 2 * Hd.w p σ 2 m)
/-- `Q(j)² = ∑_m |A₁(j,m)|² w₂(m)`. -/
def Qf (A : Matrix ι ι ℂ) (p σ : Fin 3 → ℝ) (j : ι) : ℝ := √(∑ m, ‖A j m‖ ^ 2 * Hd.w p σ 2 m)

/-- The edge density `ρ_{ij} = g_{βs}(p₀+p₁+p₂) w₀(i) w₁(j)` (total mass `h²`). -/
def rho (β s : ℝ) (σ : Fin 3 → ℝ) (i j : ι) (p : Fin 3 → ℝ) : ℝ :=
  Gm β 0 s p * (Hd.w p σ 0 i * Hd.w p σ 1 j)

omit [Fintype ι] [DecidableEq ι] in
lemma w_eq (p σ : Fin 3 → ℝ) (k : Fin 3) (m : ι) :
    Hd.w p σ k m = Hd.h * gaussian (σ k) (Hd.u m - p k) := rfl

lemma Gm_eq (β s : ℝ) (p : Fin 3 → ℝ) : Gm β 0 s p = gaussian (β * s) (p 0 + p 1 + p 2) := by
  simp [Gm, gaussianD_zero]

/-- `∫ ρ_{ij} w₁(m) = h³ g_{2σ₁}(u_j - u_m)`. -/
lemma rho_w1 {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ} (hσ : ∀ k, 0 < σ k) (i j m : ι) :
    Integrable (fun p => Hd.rho β s σ i j p * Hd.w p σ 1 m) ∧
    ∫ p, Hd.rho β s σ i j p * Hd.w p σ 1 m =
      Hd.h ^ 3 * gaussian (σ 1 + σ 1) (Hd.u j - Hd.u m) := by
  obtain ⟨hI, hV⟩ := plane_gauss_two hτ (hσ 0) (hσ 1) (a := 0) (b := 1) (by decide)
    (Hd.u i) (Hd.u j) (Hd.u m) Hd.h
  have e : (fun p => Hd.rho β s σ i j p * Hd.w p σ 1 m) = fun p : Fin 3 → ℝ =>
      gaussian (β * s) (p 0 + p 1 + p 2) * (Hd.h * gaussian (σ 0) (Hd.u i - p 0) *
        (Hd.h * gaussian (σ 1) (Hd.u j - p 1) * (Hd.h * gaussian (σ 1) (Hd.u m - p 1)))) := by
    funext p; simp only [rho, Gm_eq, w_eq]; ring
  rw [e]; exact ⟨hI, hV⟩

/-- `∫ ρ_{ij} w₀(m) = h³ g_{2σ₀}(u_i - u_m)`. -/
lemma rho_w0 {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ} (hσ : ∀ k, 0 < σ k) (i j m : ι) :
    Integrable (fun p => Hd.rho β s σ i j p * Hd.w p σ 0 m) ∧
    ∫ p, Hd.rho β s σ i j p * Hd.w p σ 0 m =
      Hd.h ^ 3 * gaussian (σ 0 + σ 0) (Hd.u i - Hd.u m) := by
  obtain ⟨hI, hV⟩ := plane_gauss_two hτ (hσ 1) (hσ 0) (a := 1) (b := 0) (by decide)
    (Hd.u j) (Hd.u i) (Hd.u m) Hd.h
  have e : (fun p => Hd.rho β s σ i j p * Hd.w p σ 0 m) = fun p : Fin 3 → ℝ =>
      gaussian (β * s) (p 0 + p 1 + p 2) * (Hd.h * gaussian (σ 1) (Hd.u j - p 1) *
        (Hd.h * gaussian (σ 0) (Hd.u i - p 0) * (Hd.h * gaussian (σ 0) (Hd.u m - p 0)))) := by
    funext p; simp only [rho, Gm_eq, w_eq]; ring
  rw [e]; exact ⟨hI, hV⟩

/-- `∫ ρ_{ij} w₂(m) = h³ g_{βs+σ₀+σ₁+σ₂}(u_i + u_j + u_m)`. -/
lemma rho_w2 {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ} (hσ : ∀ k, 0 < σ k) (i j m : ι) :
    Integrable (fun p => Hd.rho β s σ i j p * Hd.w p σ 2 m) ∧
    ∫ p, Hd.rho β s σ i j p * Hd.w p σ 2 m =
      Hd.h ^ 3 * gaussian (β * s + σ 2 + σ 1 + σ 0) (Hd.u i + Hd.u j + Hd.u m) := by
  obtain ⟨hI, hV⟩ := plane_gauss_three hτ (hσ 0) (hσ 1) (hσ 2) (Hd.u i) (Hd.u j) (Hd.u m) Hd.h
  have e : (fun p => Hd.rho β s σ i j p * Hd.w p σ 2 m) = fun p : Fin 3 → ℝ =>
      gaussian (β * s) (p 0 + p 1 + p 2) * (Hd.h * gaussian (σ 0) (Hd.u i - p 0) *
        (Hd.h * gaussian (σ 1) (Hd.u j - p 1) * (Hd.h * gaussian (σ 2) (Hd.u m - p 2)))) := by
    funext p; simp only [rho, Gm_eq, w_eq]; ring
  rw [e]; exact ⟨hI, hV⟩

lemma rho_integrable {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ} (hσ : ∀ k, 0 < σ k) (i j : ι) :
    Integrable (Hd.rho β s σ i j) := by
  obtain ⟨hI, -⟩ := plane_integral_prod (k := gaussian (β * s))
    (f := fun t => Hd.h * gaussian (σ 0) (Hd.u i - t))
    (g := fun t => Hd.h * gaussian (σ 1) (Hd.u j - t)) (continuous_gaussian' _)
    (continuous_const.mul ((continuous_gaussian' _).comp (continuous_const.sub continuous_id)))
    (continuous_const.mul ((continuous_gaussian' _).comp (continuous_const.sub continuous_id)))
    (integrable_gaussian' hτ) (integrable_weight_line _ _ _ (hσ 0))
    (integrable_weight_line _ _ _ (hσ 1)) (a := 0) (b := 1) (by decide)
  refine hI.congr (Eventually.of_forall fun p => ?_)
  simp only [rho, Gm_eq, w_eq]

lemma sq_Xf (hh : 0 ≤ Hd.h) (A : Matrix ι ι ℂ) (p σ : Fin 3 → ℝ) (i : ι) :
    Hd.Xf A p σ i ^ 2 = ∑ m, ‖A i m‖ ^ 2 * Hd.w p σ 1 m :=
  Real.sq_sqrt (Finset.sum_nonneg fun m _ => mul_nonneg (sq_nonneg _) (gweight_nonneg' _ hh _ _ _))

lemma sq_Yf (hh : 0 ≤ Hd.h) (A : Matrix ι ι ℂ) (p σ : Fin 3 → ℝ) (j : ι) :
    Hd.Yf A p σ j ^ 2 = ∑ m, ‖A m j‖ ^ 2 * Hd.w p σ 0 m :=
  Real.sq_sqrt (Finset.sum_nonneg fun m _ => mul_nonneg (sq_nonneg _) (gweight_nonneg' _ hh _ _ _))

lemma sq_Hf (hh : 0 ≤ Hd.h) (A : Matrix ι ι ℂ) (p σ : Fin 3 → ℝ) (i : ι) :
    Hd.Hf A p σ i ^ 2 = ∑ m, ‖A m i‖ ^ 2 * Hd.w p σ 2 m :=
  Real.sq_sqrt (Finset.sum_nonneg fun m _ => mul_nonneg (sq_nonneg _) (gweight_nonneg' _ hh _ _ _))

lemma sq_Qf (hh : 0 ≤ Hd.h) (A : Matrix ι ι ℂ) (p σ : Fin 3 → ℝ) (j : ι) :
    Hd.Qf A p σ j ^ 2 = ∑ m, ‖A j m‖ ^ 2 * Hd.w p σ 2 m :=
  Real.sq_sqrt (Finset.sum_nonneg fun m _ => mul_nonneg (sq_nonneg _) (gweight_nonneg' _ hh _ _ _))

end HeatData

end D02Expect

section D02Expect2

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι)

lemma integral_rho_sum {β s : ℝ} {σ : Fin 3 → ℝ} {i j : ι} (k : Fin 3) (c : ι → ℝ)
    (hint : ∀ m, Integrable (fun p => Hd.rho β s σ i j p * Hd.w p σ k m)) :
    Integrable (fun p => Hd.rho β s σ i j p * ∑ m, c m * Hd.w p σ k m) ∧
    ∫ p, Hd.rho β s σ i j p * ∑ m, c m * Hd.w p σ k m =
      ∑ m, c m * ∫ p, Hd.rho β s σ i j p * Hd.w p σ k m := by
  have e : (fun p => Hd.rho β s σ i j p * ∑ m, c m * Hd.w p σ k m) =
      fun p => ∑ m, c m * (Hd.rho β s σ i j p * Hd.w p σ k m) := by
    funext p; rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun m _ => by ring
  rw [e]
  refine ⟨integrable_finsetSum _ fun m _ => (hint m).const_mul _, ?_⟩
  rw [integral_finsetSum _ fun m _ => (hint m).const_mul _]
  exact Finset.sum_congr rfl fun m _ => integral_const_mul _ _

variable {kk : ι → ℤ}

lemma u_sub {τ : ℝ} (hu : ∀ i, Hd.u i = Hd.h * kk i) (j m : ι) :
    gaussian τ (Hd.u j - Hd.u m) = gaussian τ (Hd.h * (kk m - kk j)) := by
  rw [hu, hu, ← gaussian_neg]; congr 1; ring

lemma u_add {τ : ℝ} (hu : ∀ i, Hd.u i = Hd.h * kk i) (i j m : ι) :
    gaussian τ (Hd.u i + Hd.u j + Hd.u m) = gaussian τ (Hd.h * (kk m - (-kk i - kk j))) := by
  rw [hu, hu, hu]; congr 1; push_cast; ring

/-- **Lemma 5.2, expectation of `X²`:** `∫ ρ_{ij} X(i)² ≤ C h² M_ℤ(|A(i,·)|²)(k_j)`. -/
theorem E_X (hk : Function.Injective kk) (hu : ∀ i, Hd.u i = Hd.h * kk i) (hh : 0 < Hd.h)
    {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ} (hσ : ∀ k, 0 < σ k)
    (h1 : Hd.h ^ 2 ≤ σ 1 + σ 1) (A : Matrix ι ι ℂ) (i j : ι) :
    Integrable (fun p => Hd.rho β s σ i j p * Hd.Xf A p σ i ^ 2) ∧
    ∫ p, Hd.rho β s σ i j p * Hd.Xf A p σ i ^ 2 ≤
      Hd.h ^ 2 * ((1 + √(2 / π)) * maxZ (zext kk fun m => ‖A i m‖ ^ 2) (kk j)) := by
  simp only [Hd.sq_Xf hh.le]
  obtain ⟨hI, hV⟩ := Hd.integral_rho_sum 1 (fun m => ‖A i m‖ ^ 2)
    fun m => (Hd.rho_w1 hτ hσ i j m).1
  refine ⟨hI, ?_⟩
  rw [hV]
  simp only [(Hd.rho_w1 hτ hσ i j _).2, Hd.u_sub hu]
  have := mesh_gauss_le_maxZ hk (f := fun m => ‖A i m‖ ^ 2) (fun m => sq_nonneg _) hh h1 (kk j)
  calc ∑ m, ‖A i m‖ ^ 2 * (Hd.h ^ 3 * gaussian (σ 1 + σ 1) (Hd.h * (kk m - kk j)))
      = Hd.h ^ 2 * ∑ m, Hd.h * gaussian (σ 1 + σ 1) (Hd.h * (kk m - kk j)) * ‖A i m‖ ^ 2 := by
        rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun m _ => by ring
    _ ≤ _ := by gcongr

/-- **Lemma 5.2, expectation of `Y²`:** `∫ ρ_{ij} Y(j)² ≤ C h² M_ℤ(|A(·,j)|²)(k_i)`. -/
theorem E_Y (hk : Function.Injective kk) (hu : ∀ i, Hd.u i = Hd.h * kk i) (hh : 0 < Hd.h)
    {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ} (hσ : ∀ k, 0 < σ k)
    (h0 : Hd.h ^ 2 ≤ σ 0 + σ 0) (A : Matrix ι ι ℂ) (i j : ι) :
    Integrable (fun p => Hd.rho β s σ i j p * Hd.Yf A p σ j ^ 2) ∧
    ∫ p, Hd.rho β s σ i j p * Hd.Yf A p σ j ^ 2 ≤
      Hd.h ^ 2 * ((1 + √(2 / π)) * maxZ (zext kk fun m => ‖A m j‖ ^ 2) (kk i)) := by
  simp only [Hd.sq_Yf hh.le]
  obtain ⟨hI, hV⟩ := Hd.integral_rho_sum 0 (fun m => ‖A m j‖ ^ 2)
    fun m => (Hd.rho_w0 hτ hσ i j m).1
  refine ⟨hI, ?_⟩
  rw [hV]
  simp only [(Hd.rho_w0 hτ hσ i j _).2, Hd.u_sub hu]
  have := mesh_gauss_le_maxZ hk (f := fun m => ‖A m j‖ ^ 2) (fun m => sq_nonneg _) hh h0 (kk i)
  calc ∑ m, ‖A m j‖ ^ 2 * (Hd.h ^ 3 * gaussian (σ 0 + σ 0) (Hd.h * (kk m - kk i)))
      = Hd.h ^ 2 * ∑ m, Hd.h * gaussian (σ 0 + σ 0) (Hd.h * (kk m - kk i)) * ‖A m j‖ ^ 2 := by
        rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun m _ => by ring
    _ ≤ _ := by gcongr

/-- **Lemma 5.2, expectation of `H²`:** `∫ ρ_{ij} H(i)² ≤ C h² M_ℤ(|A₂(·,i)|²)(-k_i-k_j)`. -/
theorem E_H (hk : Function.Injective kk) (hu : ∀ i, Hd.u i = Hd.h * kk i) (hh : 0 < Hd.h)
    {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ} (hσ : ∀ k, 0 < σ k)
    (h2 : Hd.h ^ 2 ≤ β * s + σ 2 + σ 1 + σ 0) (A : Matrix ι ι ℂ) (i j : ι) :
    Integrable (fun p => Hd.rho β s σ i j p * Hd.Hf A p σ i ^ 2) ∧
    ∫ p, Hd.rho β s σ i j p * Hd.Hf A p σ i ^ 2 ≤
      Hd.h ^ 2 * ((1 + √(2 / π)) * maxZ (zext kk fun m => ‖A m i‖ ^ 2) (-kk i - kk j)) := by
  simp only [Hd.sq_Hf hh.le]
  obtain ⟨hI, hV⟩ := Hd.integral_rho_sum 2 (fun m => ‖A m i‖ ^ 2)
    fun m => (Hd.rho_w2 hτ hσ i j m).1
  refine ⟨hI, ?_⟩
  rw [hV]
  simp only [(Hd.rho_w2 hτ hσ i j _).2, Hd.u_add hu]
  have := mesh_gauss_le_maxZ hk (f := fun m => ‖A m i‖ ^ 2) (fun m => sq_nonneg _) hh h2
    (-kk i - kk j)
  calc ∑ m, ‖A m i‖ ^ 2 * (Hd.h ^ 3 *
        gaussian (β * s + σ 2 + σ 1 + σ 0) (Hd.h * (kk m - (-kk i - kk j))))
      = Hd.h ^ 2 * ∑ m, Hd.h * gaussian (β * s + σ 2 + σ 1 + σ 0)
          (Hd.h * (kk m - (-kk i - kk j))) * ‖A m i‖ ^ 2 := by
        rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun m _ => by ring
    _ ≤ _ := by
        gcongr
        convert this using 3
        push_cast; ring

/-- **Lemma 5.2, expectation of `Q²`:** `∫ ρ_{ij} Q(j)² ≤ C h² M_ℤ(|A₁(j,·)|²)(-k_i-k_j)`. -/
theorem E_Q (hk : Function.Injective kk) (hu : ∀ i, Hd.u i = Hd.h * kk i) (hh : 0 < Hd.h)
    {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ} (hσ : ∀ k, 0 < σ k)
    (h2 : Hd.h ^ 2 ≤ β * s + σ 2 + σ 1 + σ 0) (A : Matrix ι ι ℂ) (i j : ι) :
    Integrable (fun p => Hd.rho β s σ i j p * Hd.Qf A p σ j ^ 2) ∧
    ∫ p, Hd.rho β s σ i j p * Hd.Qf A p σ j ^ 2 ≤
      Hd.h ^ 2 * ((1 + √(2 / π)) * maxZ (zext kk fun m => ‖A j m‖ ^ 2) (-kk i - kk j)) := by
  simp only [Hd.sq_Qf hh.le]
  obtain ⟨hI, hV⟩ := Hd.integral_rho_sum 2 (fun m => ‖A j m‖ ^ 2)
    fun m => (Hd.rho_w2 hτ hσ i j m).1
  refine ⟨hI, ?_⟩
  rw [hV]
  simp only [(Hd.rho_w2 hτ hσ i j _).2, Hd.u_add hu]
  have := mesh_gauss_le_maxZ hk (f := fun m => ‖A j m‖ ^ 2) (fun m => sq_nonneg _) hh h2
    (-kk i - kk j)
  calc ∑ m, ‖A j m‖ ^ 2 * (Hd.h ^ 3 *
        gaussian (β * s + σ 2 + σ 1 + σ 0) (Hd.h * (kk m - (-kk i - kk j))))
      = Hd.h ^ 2 * ∑ m, Hd.h * gaussian (β * s + σ 2 + σ 1 + σ 0)
          (Hd.h * (kk m - (-kk i - kk j))) * ‖A j m‖ ^ 2 := by
        rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun m _ => by ring
    _ ≤ _ := by
        gcongr
        convert this using 3
        push_cast; ring

end HeatData

end D02Expect2

/-! ### Lemma 5.2: the energy change at one switch -/

section D02Jump

variable {n k : Type*} [Fintype n] [Fintype k] [DecidableEq k]

omit [DecidableEq k] in
lemma abs_hsRe_le_sum (X Y : Matrix n k ℂ) : |hsRe X Y| ≤ ∑ a, ∑ b, ‖X a b‖ * ‖Y a b‖ := by
  rw [hsRe_eq_sum]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun a _ => ?_)
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun b _ => ?_)
  refine (Complex.abs_re_le_norm _).trans (le_of_eq ?_)
  rw [norm_mul, Complex.norm_conj]

/-- **Energy change along a segment (consequence of Lemma 3.4, node M04):** if along
`R(z) = (1-z)R₋ + zR₊`, `z ∈ [0,1]`, the entries satisfy
`|(R(z) √(R(z)ᴴR(z)+η))_{ab}| |D_{ab}| ≤ K_{ab}` with `D = R₊ - R₋`, then
`|Φ_η(R₊ᴴR₊) - Φ_η(R₋ᴴR₋)| ≤ 3 ∑ K_{ab}`. -/
theorem abs_energyReg_change_le (Rm Rp : Matrix n k ℂ) {η : ℝ} (hη : 0 < η) (K : n → k → ℝ)
    (hK : ∀ z ∈ Set.Icc (0 : ℝ) 1, ∀ a b,
      ‖((((1 - z) • Rm + z • Rp) * CFC.sqrt ((((1 - z) • Rm + z • Rp))ᴴ *
        ((1 - z) • Rm + z • Rp) + (η : ℂ) • 1) : Matrix n k ℂ) a b)‖ * ‖(Rp - Rm) a b‖ ≤
          K a b) :
    |energyReg η (Rpᴴ * Rp) - energyReg η (Rmᴴ * Rm)| ≤ 3 * ∑ a, ∑ b, K a b := by
  rw [energyReg_segment_change Rm Rp hη]
  have := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 1)
    (C := 3 * ∑ a, ∑ b, K a b) (f := fun z => 3 * hsRe (((1 - z) • Rm + z • Rp) *
        CFC.sqrt ((((1 - z) • Rm + z • Rp))ᴴ * ((1 - z) • Rm + z • Rp) + (η : ℂ) • 1))
          (Rp - Rm)) (fun z hz => ?_)
  · simpa using this
  · have hz' : z ∈ Set.Icc (0 : ℝ) 1 := by
      rw [Set.uIoc_of_le zero_le_one] at hz; exact ⟨hz.1.le, hz.2⟩
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 3)]
    gcongr
    exact (abs_hsRe_le_sum _ _).trans (Finset.sum_le_sum fun a _ =>
      Finset.sum_le_sum fun b _ => hK z hz' a b)

end D02Jump

section D02Jump2

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

lemma norm_convex_le {a b : ℂ} {c z : ℝ} (hz : z ∈ Set.Icc (0 : ℝ) 1) (ha : ‖a‖ ≤ c)
    (hb : ‖b‖ ≤ c) : ‖(1 - z) • a + z • b‖ ≤ c := by
  refine (norm_add_le _ _).trans ?_
  rw [norm_smul, norm_smul, Real.norm_of_nonneg (by linarith [hz.2]),
    Real.norm_of_nonneg hz.1]
  nlinarith [hz.1, hz.2]

lemma sqrt_sq_add_le {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) : √(x ^ 2 + y ^ 2) ≤ x + y := by
  rw [Real.sqrt_le_left (by positivity)]; nlinarith

lemma sqrt_add_le' {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) : √(x + y) ≤ √x + √y := by
  rw [Real.sqrt_le_left (by positivity)]
  nlinarith [Real.sq_sqrt hx, Real.sq_sqrt hy, Real.sqrt_nonneg x, Real.sqrt_nonneg y]

/-- Entry bound along a segment from row and column bounds (from Lemma 3.4's entry estimate). -/
lemma entry_bound_of_rowcol {n k : Type*} [Fintype n] [Fintype k] [DecidableEq k]
    (R : Matrix n k ℂ) {η : ℝ} (hη : 0 ≤ η) (a : n) (b : k) {ρ γ : ℝ} (hρ : 0 ≤ ρ)
    (hγ : 0 ≤ γ) (hrow : ∑ c, ‖R a c‖ ^ 2 ≤ ρ ^ 2) (hcol : ∑ r, ‖R r b‖ ^ 2 ≤ γ ^ 2) :
    ‖((R * CFC.sqrt (Rᴴ * R + (η : ℂ) • (1 : Matrix k k ℂ)) : Matrix n k ℂ) a b)‖ ≤
      ρ * (γ + √η) := by
  refine (norm_entry_mul_sqrt_gram_le R hη a b).trans ?_
  refine mul_le_mul ?_ ?_ (Real.sqrt_nonneg _) hρ
  · exact Real.sqrt_le_left hρ |>.2 hrow
  · calc √(∑ r, ‖R r b‖ ^ 2 + η) ≤ √(γ ^ 2 + η) := Real.sqrt_le_sqrt (by linarith)
      _ ≤ √(γ ^ 2) + √η := sqrt_add_le' (sq_nonneg _) hη
      _ = γ + √η := by rw [Real.sqrt_sq hγ]

namespace HeatData

variable (Hd : HeatData ι)

/-- The same data with the array `A₀` replaced by `B`. -/
def withA0 (B : Matrix ι ι ℂ) : HeatData ι := ⟨Hd.u, Hd.h, Function.update Hd.A 0 B⟩

omit [Fintype ι] [DecidableEq ι] in
@[simp] lemma withA0_u (B : Matrix ι ι ℂ) : (Hd.withA0 B).u = Hd.u := rfl
omit [Fintype ι] [DecidableEq ι] in
@[simp] lemma withA0_h (B : Matrix ι ι ℂ) : (Hd.withA0 B).h = Hd.h := rfl
omit [Fintype ι] [DecidableEq ι] in
@[simp] lemma withA0_A0 (B : Matrix ι ι ℂ) : (Hd.withA0 B).A 0 = B := by simp [withA0]
omit [Fintype ι] [DecidableEq ι] in
@[simp] lemma withA0_A1 (B : Matrix ι ι ℂ) : (Hd.withA0 B).A 1 = Hd.A 1 := by
  simp [withA0, Function.update_of_ne (show (1 : Fin 3) ≠ 0 by decide)]
omit [Fintype ι] [DecidableEq ι] in
@[simp] lemma withA0_A2 (B : Matrix ι ι ℂ) : (Hd.withA0 B).A 2 = Hd.A 2 := by
  simp [withA0, Function.update_of_ne (show (2 : Fin 3) ≠ 0 by decide)]
omit [Fintype ι] [DecidableEq ι] in
@[simp] lemma withA0_w (B : Matrix ι ι ℂ) : (Hd.withA0 B).w = Hd.w := rfl
omit [Fintype ι] [DecidableEq ι] in
@[simp] lemma withA0_sqw (B : Matrix ι ι ℂ) : (Hd.withA0 B).sqw = Hd.sqw := rfl

lemma W_apply (p σ : Fin 3 → ℝ) (v : Fin 3) (i j : ι) :
    Hd.W p σ v i j = (Hd.sqw p σ v i : ℂ) * Hd.A v i j * (Hd.sqw p σ (v + 1) j : ℂ) := by
  rw [W, rdiag_mul_mul_rdiag_apply]

omit [DecidableEq ι] in
lemma norm_sqw_sq (hh : 0 ≤ Hd.h) (p σ : Fin 3 → ℝ) (k : Fin 3) (i : ι) :
    ‖(Hd.sqw p σ k i : ℂ)‖ ^ 2 = Hd.w p σ k i := by
  rw [Complex.norm_real, Real.norm_eq_abs, sq_abs]
  exact Real.sq_sqrt (gweight_nonneg' _ hh _ _ _)

lemma norm_W_sq (hh : 0 ≤ Hd.h) (p σ : Fin 3 → ℝ) (v : Fin 3) (i j : ι) :
    ‖Hd.W p σ v i j‖ ^ 2 = Hd.w p σ v i * ‖Hd.A v i j‖ ^ 2 * Hd.w p σ (v + 1) j := by
  rw [W_apply, norm_mul, norm_mul, mul_pow, mul_pow, Hd.norm_sqw_sq hh, Hd.norm_sqw_sq hh]

end HeatData

end D02Jump2

section D02Jump3

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι)

lemma R_inl (p σ : Fin 3 → ℝ) (v : Fin 3) (i j : ι) :
    Hd.R p σ v i (Sum.inl j) = Hd.W p σ v i j := by
  simp [R, rowMat]

lemma R_inr (p σ : Fin 3 → ℝ) (v : Fin 3) (i j : ι) :
    Hd.R p σ v i (Sum.inr j) = star (Hd.W p σ (v - 1) j i) := by
  simp [R, rowMat, Matrix.conjTranspose_apply]

lemma e2_withA0 (B B' : Matrix ι ι ℂ) (p σ : Fin 3 → ℝ) (η : ℝ) :
    (Hd.withA0 B').e p σ η 2 = (Hd.withA0 B).e p σ η 2 := by
  have h1 : (2 : Fin 3) - 1 = 1 := rfl
  have h2 : (2 : Fin 3) + 1 = 0 := rfl
  have h3 : (1 : Fin 3) + 1 = 2 := rfl
  simp only [e, T, R, W, h1, h2, h3, withA0_A1, withA0_A2, withA0_sqw]

/-- **Lemma 5.2, energy change at one switch (pointwise):** replacing `A₀` by another array
with entries bounded by `|B₀|` changes `∑_v e_v` by at most
`3 ∑_{ij} |δA(i,j)| (w₀(i) w₁(j) (2XY + HY + QX) + √η (w₀(i)√w₁(j)(X+H) + √w₀(i) w₁(j)(Y+Q)))`.
-/
theorem jump_pointwise (hh : 0 ≤ Hd.h) {η : ℝ} (hη : 0 < η) (Bm Bp B0 : Matrix ι ι ℂ)
    (hm : ∀ i j, ‖Bm i j‖ ≤ ‖B0 i j‖) (hp : ∀ i j, ‖Bp i j‖ ≤ ‖B0 i j‖) (p σ : Fin 3 → ℝ) :
    |∑ v, (Hd.withA0 Bp).e p σ η v - ∑ v, (Hd.withA0 Bm).e p σ η v| ≤
      3 * ∑ i, ∑ j, ‖Bp i j - Bm i j‖ *
        (Hd.w p σ 0 i * Hd.w p σ 1 j *
            (2 * Hd.Xf B0 p σ i * Hd.Yf B0 p σ j + Hd.Hf (Hd.A 2) p σ i * Hd.Yf B0 p σ j +
              Hd.Qf (Hd.A 1) p σ j * Hd.Xf B0 p σ i) +
          √η * (Hd.w p σ 0 i * √(Hd.w p σ 1 j) * (Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i) +
            √(Hd.w p σ 0 i) * Hd.w p σ 1 j * (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j))) := by
  have hw : ∀ k m, 0 ≤ Hd.w p σ k m := fun k m => gweight_nonneg' _ hh _ _ _
  have hX : ∀ i, 0 ≤ Hd.Xf B0 p σ i := fun i => Real.sqrt_nonneg _
  have hY : ∀ j, 0 ≤ Hd.Yf B0 p σ j := fun j => Real.sqrt_nonneg _
  have hH : ∀ i, 0 ≤ Hd.Hf (Hd.A 2) p σ i := fun i => Real.sqrt_nonneg _
  have hQ : ∀ j, 0 ≤ Hd.Qf (Hd.A 1) p σ j := fun j => Real.sqrt_nonneg _
  have hX2 := Hd.sq_Xf hh B0 p σ
  have hY2 := Hd.sq_Yf hh B0 p σ
  have hH2 := Hd.sq_Hf hh (Hd.A 2) p σ
  have hQ2 := Hd.sq_Qf hh (Hd.A 1) p σ
  have hsq : ∀ k m, ‖(Hd.sqw p σ k m : ℂ)‖ = √(Hd.w p σ k m) := fun k m => by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Hd.sqw_nonneg _ _ _ _)]; rfl
  have hsqsq : ∀ k m, √(Hd.w p σ k m) * √(Hd.w p σ k m) = Hd.w p σ k m := fun k m =>
    Real.mul_self_sqrt (hw k m)
  have e01 : (0 : Fin 3) + 1 = 1 := rfl
  have e02 : (0 : Fin 3) - 1 = 2 := rfl
  have e11 : (1 : Fin 3) + 1 = 2 := rfl
  have e12 : (1 : Fin 3) - 1 = 0 := rfl
  have e21 : (2 : Fin 3) + 1 = 0 := rfl
  -- entries of the two row matrices that change
  have W0 : ∀ (B : Matrix ι ι ℂ) i j, (Hd.withA0 B).W p σ 0 i j =
      (Hd.sqw p σ 0 i : ℂ) * B i j * (Hd.sqw p σ 1 j : ℂ) := fun B i j => by
    rw [W_apply, e01, withA0_A0, withA0_sqw]
  have W1 : ∀ (B : Matrix ι ι ℂ) j m, (Hd.withA0 B).W p σ 1 j m =
      (Hd.sqw p σ 1 j : ℂ) * Hd.A 1 j m * (Hd.sqw p σ 2 m : ℂ) := fun B j m => by
    rw [W_apply, e11, withA0_A1, withA0_sqw]
  have W2 : ∀ (B : Matrix ι ι ℂ) m i, (Hd.withA0 B).W p σ 2 m i =
      (Hd.sqw p σ 2 m : ℂ) * Hd.A 2 m i * (Hd.sqw p σ 0 i : ℂ) := fun B m i => by
    rw [W_apply, e21, withA0_A2, withA0_sqw]
  have hconv : ∀ z ∈ Set.Icc (0 : ℝ) 1, ∀ i j, ‖(1 - z) • Bm i j + z • Bp i j‖ ≤ ‖B0 i j‖ :=
    fun z hz i j => norm_convex_le hz (hm i j) (hp i j)
  ------------------------------------------------------------------ the row matrix `R₀`
  set K0 : ι → ι ⊕ ι → ℝ := fun i b => match b with
    | Sum.inl j => (√(Hd.w p σ 0 i) * (Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i)) * (√(Hd.w p σ 1 j) * Hd.Yf B0 p σ j + √η) *
        (√(Hd.w p σ 0 i) * ‖Bp i j - Bm i j‖ * √(Hd.w p σ 1 j))
    | Sum.inr _ => 0
  have hE0 : |(Hd.withA0 Bp).e p σ η 0 - (Hd.withA0 Bm).e p σ η 0| ≤ 3 * ∑ i, ∑ b, K0 i b := by
    refine abs_energyReg_change_le ((Hd.withA0 Bm).R p σ 0) ((Hd.withA0 Bp).R p σ 0) hη K0 fun z hz i b => ?_
    set Rz := (1 - z) • (Hd.withA0 Bm).R p σ 0 + z • (Hd.withA0 Bp).R p σ 0
    have Rl : ∀ i j, Rz i (Sum.inl j) =
        (Hd.sqw p σ 0 i : ℂ) * ((1 - z) • Bm i j + z • Bp i j) * (Hd.sqw p σ 1 j : ℂ) := by
      intro i j
      simp only [Rz, Matrix.add_apply, Matrix.smul_apply, R_inl, W0]
      simp only [smul_eq_mul, Complex.real_smul]; ring
    have Rr : ∀ i m, Rz i (Sum.inr m) = star (Hd.W p σ 2 m i) := by
      intro i m
      simp only [Rz, Matrix.add_apply, Matrix.smul_apply, R_inr, e02, W2]
      rw [show Hd.W p σ 2 m i = (Hd.sqw p σ 2 m : ℂ) * Hd.A 2 m i * (Hd.sqw p σ 0 i : ℂ) by
        rw [W_apply, e21]]
      rw [← add_smul]; simp
    rcases b with j | m
    · -- row and column bounds
      have hrow : ∑ c, ‖Rz i c‖ ^ 2 ≤ (√(Hd.w p σ 0 i) * (Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i)) ^ 2 := by
        rw [Fintype.sum_sum_type]
        have h1 : ∑ j, ‖Rz i (Sum.inl j)‖ ^ 2 ≤ Hd.w p σ 0 i * Hd.Xf B0 p σ i ^ 2 := by
          rw [hX2, Finset.mul_sum]
          refine Finset.sum_le_sum fun j _ => ?_
          rw [Rl, norm_mul, norm_mul, hsq, hsq, mul_pow, mul_pow, Real.sq_sqrt (hw _ _),
            Real.sq_sqrt (hw _ _)]
          have hc := pow_le_pow_left₀ (norm_nonneg _) (hconv z hz i j) 2
          nlinarith [mul_le_mul_of_nonneg_left hc (mul_nonneg (hw 0 i) (hw 1 j))]
        have h2 : ∑ m, ‖Rz i (Sum.inr m)‖ ^ 2 = Hd.w p σ 0 i * Hd.Hf (Hd.A 2) p σ i ^ 2 := by
          rw [hH2, Finset.mul_sum]
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [Rr, norm_star, Hd.norm_W_sq hh, e21]; ring
        rw [mul_pow, Real.sq_sqrt (hw _ _)]
        nlinarith [hX i, hH i, mul_nonneg (hw 0 i) (mul_nonneg (hX i) (hH i))]
      have hcol : ∑ r, ‖Rz r (Sum.inl j)‖ ^ 2 ≤ (√(Hd.w p σ 1 j) * Hd.Yf B0 p σ j) ^ 2 := by
        rw [mul_pow, Real.sq_sqrt (hw _ _), hY2, Finset.mul_sum]
        refine Finset.sum_le_sum fun r _ => ?_
        rw [Rl, norm_mul, norm_mul, hsq, hsq, mul_pow, mul_pow, Real.sq_sqrt (hw _ _),
          Real.sq_sqrt (hw _ _)]
        have hc := pow_le_pow_left₀ (norm_nonneg _) (hconv z hz r j) 2
        nlinarith [mul_le_mul_of_nonneg_left hc (mul_nonneg (hw 0 r) (hw 1 j))]
      have hent := entry_bound_of_rowcol Rz hη.le i (Sum.inl j)
        (mul_nonneg (Real.sqrt_nonneg _) (add_nonneg (hX i) (hH i)))
        (mul_nonneg (Real.sqrt_nonneg _) (hY j)) hrow hcol
      have hD : ‖((Hd.withA0 Bp).R p σ 0 - (Hd.withA0 Bm).R p σ 0) i (Sum.inl j)‖ =
          √(Hd.w p σ 0 i) * ‖Bp i j - Bm i j‖ * √(Hd.w p σ 1 j) := by
        rw [Matrix.sub_apply, R_inl, R_inl, W0, W0, ← sub_mul, ← mul_sub, norm_mul, norm_mul,
          hsq, hsq]
      rw [hD]
      exact mul_le_mul_of_nonneg_right hent (by positivity)
    · have hD : ((Hd.withA0 Bp).R p σ 0 - (Hd.withA0 Bm).R p σ 0) i (Sum.inr m) = 0 := by
        rw [Matrix.sub_apply, R_inr, R_inr, e02, W2, W2, sub_self]
      rw [hD, norm_zero, mul_zero]
  ------------------------------------------------------------------ the row matrix `R₁`
  set K1 : ι → ι ⊕ ι → ℝ := fun j b => match b with
    | Sum.inl _ => 0
    | Sum.inr i => (√(Hd.w p σ 1 j) * (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j)) * (√(Hd.w p σ 0 i) * Hd.Xf B0 p σ i + √η) *
        (√(Hd.w p σ 0 i) * ‖Bp i j - Bm i j‖ * √(Hd.w p σ 1 j))
  have hE1 : |(Hd.withA0 Bp).e p σ η 1 - (Hd.withA0 Bm).e p σ η 1| ≤ 3 * ∑ j, ∑ b, K1 j b := by
    refine abs_energyReg_change_le ((Hd.withA0 Bm).R p σ 1) ((Hd.withA0 Bp).R p σ 1) hη K1 fun z hz j b => ?_
    set Rz := (1 - z) • (Hd.withA0 Bm).R p σ 1 + z • (Hd.withA0 Bp).R p σ 1
    have Rl : ∀ j m, Rz j (Sum.inl m) = Hd.W p σ 1 j m := by
      intro j m
      simp only [Rz, Matrix.add_apply, Matrix.smul_apply, R_inl, W1]
      rw [show Hd.W p σ 1 j m = (Hd.sqw p σ 1 j : ℂ) * Hd.A 1 j m * (Hd.sqw p σ 2 m : ℂ) by
        rw [W_apply, e11]]
      rw [← add_smul]; simp
    have Rr : ∀ j i, Rz j (Sum.inr i) =
        star ((Hd.sqw p σ 0 i : ℂ) * ((1 - z) • Bm i j + z • Bp i j) * (Hd.sqw p σ 1 j : ℂ)) := by
      intro j i
      simp only [Rz, Matrix.add_apply, Matrix.smul_apply, R_inr, e12, W0]
      simp only [smul_eq_mul, Complex.real_smul, star_mul', star_add, Complex.star_def,
        map_mul, Complex.conj_ofReal]
      ring
    rcases b with m | i
    · have hD : ((Hd.withA0 Bp).R p σ 1 - (Hd.withA0 Bm).R p σ 1) j (Sum.inl m) = 0 := by
        rw [Matrix.sub_apply, R_inl, R_inl, W1, W1, sub_self]
      rw [hD, norm_zero, mul_zero]
    · have hrow : ∑ c, ‖Rz j c‖ ^ 2 ≤ (√(Hd.w p σ 1 j) * (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j)) ^ 2 := by
        rw [Fintype.sum_sum_type]
        have h1 : ∑ m, ‖Rz j (Sum.inl m)‖ ^ 2 = Hd.w p σ 1 j * Hd.Qf (Hd.A 1) p σ j ^ 2 := by
          rw [hQ2, Finset.mul_sum]
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [Rl, Hd.norm_W_sq hh, e11]; ring
        have h2 : ∑ r, ‖Rz j (Sum.inr r)‖ ^ 2 ≤ Hd.w p σ 1 j * Hd.Yf B0 p σ j ^ 2 := by
          rw [hY2, Finset.mul_sum]
          refine Finset.sum_le_sum fun r _ => ?_
          rw [Rr, norm_star, norm_mul, norm_mul, hsq, hsq, mul_pow, mul_pow,
            Real.sq_sqrt (hw _ _), Real.sq_sqrt (hw _ _)]
          have hc := pow_le_pow_left₀ (norm_nonneg _) (hconv z hz r j) 2
          nlinarith [mul_le_mul_of_nonneg_left hc (mul_nonneg (hw 0 r) (hw 1 j))]
        rw [mul_pow, Real.sq_sqrt (hw _ _)]
        nlinarith [hY j, hQ j, mul_nonneg (hw 1 j) (mul_nonneg (hY j) (hQ j))]
      have hcol : ∑ r, ‖Rz r (Sum.inr i)‖ ^ 2 ≤ (√(Hd.w p σ 0 i) * Hd.Xf B0 p σ i) ^ 2 := by
        rw [mul_pow, Real.sq_sqrt (hw _ _), hX2, Finset.mul_sum]
        refine Finset.sum_le_sum fun r _ => ?_
        rw [Rr, norm_star, norm_mul, norm_mul, hsq, hsq, mul_pow, mul_pow, Real.sq_sqrt (hw _ _),
          Real.sq_sqrt (hw _ _)]
        have hc := pow_le_pow_left₀ (norm_nonneg _) (hconv z hz i r) 2
        nlinarith [mul_le_mul_of_nonneg_left hc (mul_nonneg (hw 0 i) (hw 1 r))]
      have hent := entry_bound_of_rowcol Rz hη.le j (Sum.inr i)
        (mul_nonneg (Real.sqrt_nonneg _) (add_nonneg (hY j) (hQ j)))
        (mul_nonneg (Real.sqrt_nonneg _) (hX i)) hrow hcol
      have hD : ‖((Hd.withA0 Bp).R p σ 1 - (Hd.withA0 Bm).R p σ 1) j (Sum.inr i)‖ =
          √(Hd.w p σ 0 i) * ‖Bp i j - Bm i j‖ * √(Hd.w p σ 1 j) := by
        rw [Matrix.sub_apply, R_inr, R_inr, e12, W0, W0, ← star_sub, norm_star, ← sub_mul,
          ← mul_sub, norm_mul, norm_mul, hsq, hsq]
      rw [hD]
      exact mul_le_mul_of_nonneg_right hent (by positivity)
  ------------------------------------------------------------------ combine
  have hE2 := Hd.e2_withA0 Bm Bp p σ η
  rw [Fin.sum_univ_three, Fin.sum_univ_three]
  have hsplit : (Hd.withA0 Bp).e p σ η 0 + (Hd.withA0 Bp).e p σ η 1 + (Hd.withA0 Bp).e p σ η 2 -
      ((Hd.withA0 Bm).e p σ η 0 + (Hd.withA0 Bm).e p σ η 1 + (Hd.withA0 Bm).e p σ η 2) =
      ((Hd.withA0 Bp).e p σ η 0 - (Hd.withA0 Bm).e p σ η 0) + ((Hd.withA0 Bp).e p σ η 1 - (Hd.withA0 Bm).e p σ η 1) := by
    rw [hE2]; ring
  rw [hsplit]
  refine (abs_add_le _ _).trans ((add_le_add hE0 hE1).trans (le_of_eq ?_))
  simp only [Fintype.sum_sum_type, K0, K1, Finset.sum_const_zero, add_zero, zero_add]
  rw [Finset.sum_comm (f := fun j i => (√(Hd.w p σ 1 j) * (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j)) * (√(Hd.w p σ 0 i) * Hd.Xf B0 p σ i + √η) *
    (√(Hd.w p σ 0 i) * ‖Bp i j - Bm i j‖ * √(Hd.w p σ 1 j))), ← mul_add, ← Finset.sum_add_distrib]
  congr 1
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  have a1 : √(Hd.w p σ 0 i) * √(Hd.w p σ 0 i) = Hd.w p σ 0 i := hsqsq 0 i
  have a2 : √(Hd.w p σ 1 j) * √(Hd.w p σ 1 j) = Hd.w p σ 1 j := hsqsq 1 j
  linear_combination (‖Bp i j - Bm i j‖ * ((Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i) * Hd.Yf B0 p σ j + (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j) * Hd.Xf B0 p σ i) * √(Hd.w p σ 1 j) ^ 2 +
      √η * ‖Bp i j - Bm i j‖ * (Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i) * √(Hd.w p σ 1 j)) * a1 +
    (‖Bp i j - Bm i j‖ * ((Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i) * Hd.Yf B0 p σ j + (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j) * Hd.Xf B0 p σ i) * Hd.w p σ 0 i +
      √η * ‖Bp i j - Bm i j‖ * (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j) * √(Hd.w p σ 0 i)) * a2

end HeatData

end D02Jump3

section D02Jump4

/-- `x ≤ √A √B` from the family of bounds `x ≤ (tA + B/t)/2`, `t > 0`. -/
lemma le_sqrt_mul_of_forall {x A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (h : ∀ t > 0, x ≤ (t * A + B / t) / 2) : x ≤ √A * √B := by
  rcases hA.eq_or_lt with hA0 | hApos
  · subst hA0
    rw [Real.sqrt_zero, zero_mul]
    by_contra hx; push Not at hx
    have := h (B / x + 1) (by positivity)
    have hxB : B / (B / x + 1) < x := by
      rw [div_lt_iff₀ (by positivity)]
      have : B / x * x = B := div_mul_cancel₀ _ hx.ne'
      nlinarith
    linarith
  rcases hB.eq_or_lt with hB0 | hBpos
  · subst hB0
    rw [Real.sqrt_zero, mul_zero]
    by_contra hx; push Not at hx
    have h1 := h (x / (A + 1)) (by positivity)
    have h2 : x / (A + 1) * A < x := by
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]; nlinarith
    rw [zero_div, add_zero] at h1
    linarith
  · have hsA := Real.sqrt_pos.2 hApos
    have hsB := Real.sqrt_pos.2 hBpos
    have := h (√B / √A) (by positivity)
    have e1 : √B / √A * A = √A * √B := by
      rw [div_mul_eq_mul_div, div_eq_iff hsA.ne']; nlinarith [Real.mul_self_sqrt hA]
    have e2 : B / (√B / √A) = √A * √B := by
      rw [div_div_eq_mul_div, div_eq_iff hsB.ne']; nlinarith [Real.mul_self_sqrt hB]
    rw [e1, e2] at this
    linarith

/-- **Cauchy–Schwarz for a weighted integral:** `∫ ρ f g ≤ (∫ ρ f²)^{1/2} (∫ ρ g²)^{1/2}`. -/
lemma integral_rho_mul_le {X : Type*} [MeasurableSpace X] {μ : Measure X} {ρ f g : X → ℝ}
    (hρ : ∀ x, 0 ≤ ρ x) (h1 : Integrable (fun x => ρ x * f x ^ 2) μ)
    (h2 : Integrable (fun x => ρ x * g x ^ 2) μ) (h3 : Integrable (fun x => ρ x * (f x * g x)) μ) :
    ∫ x, ρ x * (f x * g x) ∂μ ≤ √(∫ x, ρ x * f x ^ 2 ∂μ) * √(∫ x, ρ x * g x ^ 2 ∂μ) := by
  refine le_sqrt_mul_of_forall (integral_nonneg fun x => mul_nonneg (hρ x) (sq_nonneg _))
    (integral_nonneg fun x => mul_nonneg (hρ x) (sq_nonneg _)) fun t ht => ?_
  rw [← integral_const_mul, ← integral_div, ← integral_add (h1.const_mul t) (h2.div_const t),
    ← integral_div]
  refine integral_mono h3 (((h1.const_mul t).add (h2.div_const t)).div_const 2) fun x => ?_
  simp only
  have := hρ x
  have key : f x * g x ≤ (t * f x ^ 2 + g x ^ 2 / t) / 2 := by
    have e : (t * f x ^ 2 + g x ^ 2 / t) / 2 - f x * g x = (t * f x - g x) ^ 2 / (2 * t) := by
      field_simp; ring
    have : 0 ≤ (t * f x - g x) ^ 2 / (2 * t) := by positivity
    linarith
  calc ρ x * (f x * g x) ≤ ρ x * ((t * f x ^ 2 + g x ^ 2 / t) / 2) :=
        mul_le_mul_of_nonneg_left key this
    _ = (t * (ρ x * f x ^ 2) + ρ x * g x ^ 2 / t) / 2 := by ring

lemma sqrt_weight_eq {h σ : ℝ} (hh : 0 ≤ h) (hσ : 0 < σ) (x : ℝ) :
    √(h * gaussian σ x) = √h * (√((√(2 * π * σ))⁻¹) * Real.exp (-(1 / (4 * σ)) * x ^ 2)) := by
  unfold gaussian
  rw [Real.sqrt_mul hh, Real.sqrt_mul (by positivity), ← Real.exp_half]
  congr 3
  field_simp; ring

lemma integrable_sqrt_weight {h σ : ℝ} (hh : 0 ≤ h) (hσ : 0 < σ) (u : ℝ) :
    Integrable (fun t => √(h * gaussian σ (u - t))) := by
  simp_rw [sqrt_weight_eq hh hσ]
  exact (((integrable_exp_neg_mul_sq (by positivity : 0 < 1 / (4 * σ))).comp_sub_left u).const_mul
    _).const_mul _

lemma continuous_sqrt_weight (h σ u : ℝ) : Continuous (fun t => √(h * gaussian σ (u - t))) :=
  Real.continuous_sqrt.comp (continuous_const.mul
    ((continuous_gaussian' σ).comp (continuous_const.sub continuous_id)))

end D02Jump4

section D02Jump5

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι)

omit [DecidableEq ι] in
lemma continuous_w_p (σ : Fin 3 → ℝ) (hσ : ∀ k, 0 < σ k) (k : Fin 3) (m : ι) :
    Continuous fun p : Fin 3 → ℝ => Hd.w p σ k m :=
  Hd.continuous_w continuous_id continuous_const (fun _ => hσ) k m

omit [DecidableEq ι] in
lemma continuous_wsum (σ : Fin 3 → ℝ) (hσ : ∀ k, 0 < σ k) (k : Fin 3) (c : ι → ℝ) :
    Continuous fun p : Fin 3 → ℝ => √(∑ m, c m * Hd.w p σ k m) :=
  Real.continuous_sqrt.comp (continuous_finset_sum _ fun m _ =>
    continuous_const.mul (Hd.continuous_w_p σ hσ k m))

omit [DecidableEq ι] in
lemma w_le_sup (hh : 0 ≤ Hd.h) (p σ : Fin 3 → ℝ) (k : Fin 3) (m : ι) :
    Hd.w p σ k m ≤ Hd.h * (√(2 * π * σ k))⁻¹ :=
  mul_le_mul_of_nonneg_left (gaussian_le_sup _ _) hh

omit [DecidableEq ι] in
lemma wsum_le (hh : 0 ≤ Hd.h) (p σ : Fin 3 → ℝ) (k : Fin 3) (c : ι → ℝ) (hc : ∀ m, 0 ≤ c m) :
    √(∑ m, c m * Hd.w p σ k m) ≤ √(∑ m, c m * (Hd.h * (√(2 * π * σ k))⁻¹)) :=
  Real.sqrt_le_sqrt (Finset.sum_le_sum fun m _ =>
    mul_le_mul_of_nonneg_left (Hd.w_le_sup hh p σ k m) (hc m))

lemma rho_continuous (β s : ℝ) (hτ : 0 < β * s) (σ : Fin 3 → ℝ) (hσ : ∀ k, 0 < σ k) (i j : ι) :
    Continuous (Hd.rho β s σ i j) := by
  have : Hd.rho β s σ i j = fun p => gaussian (β * s) (p 0 + p 1 + p 2) *
      (Hd.w p σ 0 i * Hd.w p σ 1 j) := by funext p; rw [rho, Gm_eq]
  rw [this]
  exact ((continuous_gaussian' _).comp (by fun_prop)).mul
    ((Hd.continuous_w_p σ hσ 0 i).mul (Hd.continuous_w_p σ hσ 1 j))

lemma rho_nonneg (hh : 0 ≤ Hd.h) (β s : ℝ) (σ : Fin 3 → ℝ) (i j : ι) (p : Fin 3 → ℝ) :
    0 ≤ Hd.rho β s σ i j p := by
  rw [rho, Gm_eq]
  exact mul_nonneg (gaussian_nonneg' _ _) (mul_nonneg (gweight_nonneg' _ hh _ _ _)
    (gweight_nonneg' _ hh _ _ _))

/-- `g_{βs}(p₀+p₁+p₂) w₀(i) √w₁(j)` is integrable. -/
lemma G_w0_sqrtw1_integrable (hh : 0 ≤ Hd.h) {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ}
    (hσ : ∀ k, 0 < σ k) (i j : ι) :
    Integrable (fun p : Fin 3 → ℝ => Gm β 0 s p * (Hd.w p σ 0 i * √(Hd.w p σ 1 j))) := by
  obtain ⟨hI, -⟩ := plane_integral_prod (k := gaussian (β * s))
    (f := fun t => Hd.h * gaussian (σ 0) (Hd.u i - t))
    (g := fun t => √(Hd.h * gaussian (σ 1) (Hd.u j - t))) (continuous_gaussian' _)
    (continuous_const.mul ((continuous_gaussian' _).comp (continuous_const.sub continuous_id)))
    (continuous_sqrt_weight _ _ _) (integrable_gaussian' hτ)
    (integrable_weight_line _ _ _ (hσ 0)) (integrable_sqrt_weight hh (hσ 1) _)
    (a := 0) (b := 1) (by decide)
  refine hI.congr (Eventually.of_forall fun p => ?_)
  simp only [Gm_eq, w_eq]

/-- `g_{βs}(p₀+p₁+p₂) √w₀(i) w₁(j)` is integrable. -/
lemma G_sqrtw0_w1_integrable (hh : 0 ≤ Hd.h) {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ}
    (hσ : ∀ k, 0 < σ k) (i j : ι) :
    Integrable (fun p : Fin 3 → ℝ => Gm β 0 s p * (√(Hd.w p σ 0 i) * Hd.w p σ 1 j)) := by
  obtain ⟨hI, -⟩ := plane_integral_prod (k := gaussian (β * s))
    (f := fun t => √(Hd.h * gaussian (σ 0) (Hd.u i - t)))
    (g := fun t => Hd.h * gaussian (σ 1) (Hd.u j - t)) (continuous_gaussian' _)
    (continuous_sqrt_weight _ _ _)
    (continuous_const.mul ((continuous_gaussian' _).comp (continuous_const.sub continuous_id)))
    (integrable_gaussian' hτ) (integrable_sqrt_weight hh (hσ 0) _)
    (integrable_weight_line _ _ _ (hσ 1)) (a := 0) (b := 1) (by decide)
  refine hI.congr (Eventually.of_forall fun p => ?_)
  simp only [Gm_eq, w_eq]

/-- Integrability of `ρ f g` from that of `ρ f²` and `ρ g²`. -/
lemma rho_mul_integrable {ρ f g : (Fin 3 → ℝ) → ℝ} (hρ : ∀ p, 0 ≤ ρ p) (hc : Continuous ρ)
    (hf : Continuous f) (hg : Continuous g) (h1 : Integrable fun p => ρ p * f p ^ 2)
    (h2 : Integrable fun p => ρ p * g p ^ 2) : Integrable fun p => ρ p * (f p * g p) := by
  refine ((h1.add h2).div_const 2).mono' (hc.mul (hf.mul hg)).aestronglyMeasurable
    (Eventually.of_forall fun p => ?_)
  simp only [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hρ p)]
  have := hρ p
  have : |f p * g p| ≤ (f p ^ 2 + g p ^ 2) / 2 := by
    rw [abs_le]; constructor <;> nlinarith [sq_nonneg (f p - g p), sq_nonneg (f p + g p)]
  calc ρ p * (|f p| * |g p|) = ρ p * |f p * g p| := by rw [abs_mul]
    _ ≤ ρ p * ((f p ^ 2 + g p ^ 2) / 2) := mul_le_mul_of_nonneg_left this (hρ p)
    _ = _ := by simp only [Pi.add_apply]; ring

end HeatData

end D02Jump5

section D02Jump6

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- `X_*(i,j) = (M_ℤ |B(i,·)|²(k_j))^{1/2}`. -/
def Xs (kk : ι → ℤ) (B : Matrix ι ι ℂ) (i j : ι) : ℝ :=
  √(maxZ (zext kk fun m => ‖B i m‖ ^ 2) (kk j))
/-- `Y_*(i,j) = (M_ℤ |B(·,j)|²(k_i))^{1/2}`. -/
def Ys (kk : ι → ℤ) (B : Matrix ι ι ℂ) (i j : ι) : ℝ :=
  √(maxZ (zext kk fun m => ‖B m j‖ ^ 2) (kk i))
/-- `H_*(i,j) = (M_ℤ |A₂(·,i)|²(-k_i-k_j))^{1/2}`. -/
def Hs (kk : ι → ℤ) (A : Matrix ι ι ℂ) (i j : ι) : ℝ :=
  √(maxZ (zext kk fun m => ‖A m i‖ ^ 2) (-kk i - kk j))
/-- `Q_*(i,j) = (M_ℤ |A₁(j,·)|²(-k_i-k_j))^{1/2}`. -/
def Qs (kk : ι → ℤ) (A : Matrix ι ι ℂ) (i j : ι) : ℝ :=
  √(maxZ (zext kk fun m => ‖A j m‖ ^ 2) (-kk i - kk j))

namespace HeatData

variable (Hd : HeatData ι) {kk : ι → ℤ}

lemma sqrt_h2_mul {h a : ℝ} (hh : 0 ≤ h) (c : ℝ) (hc : 0 ≤ c) (ha : 0 ≤ a) :
    √(h ^ 2 * (c * a)) = h * √c * √a := by
  rw [Real.sqrt_mul (sq_nonneg h), Real.sqrt_sq hh, Real.sqrt_mul hc, mul_assoc]

/-- **Lemma 5.2, the cross terms:** `∫ ρ_{ij} (2XY + HY + QX) ≤ C h² (2X_*Y_* + H_*Y_* + Q_*X_*)`
with `C = 1 + √(2/π)` (Cauchy–Schwarz and the maximal bounds). -/
theorem rho_cross_le (hk : Function.Injective kk) (hu : ∀ i, Hd.u i = Hd.h * kk i)
    (hh : 0 < Hd.h) {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ} (hσ : ∀ k, 0 < σ k)
    (h0 : Hd.h ^ 2 ≤ σ 0 + σ 0) (h1 : Hd.h ^ 2 ≤ σ 1 + σ 1)
    (h2 : Hd.h ^ 2 ≤ β * s + σ 2 + σ 1 + σ 0) (B0 : Matrix ι ι ℂ) (i j : ι) :
    Integrable (fun p => Hd.rho β s σ i j p *
      (2 * Hd.Xf B0 p σ i * Hd.Yf B0 p σ j + Hd.Hf (Hd.A 2) p σ i * Hd.Yf B0 p σ j +
        Hd.Qf (Hd.A 1) p σ j * Hd.Xf B0 p σ i)) ∧
    ∫ p, Hd.rho β s σ i j p *
      (2 * Hd.Xf B0 p σ i * Hd.Yf B0 p σ j + Hd.Hf (Hd.A 2) p σ i * Hd.Yf B0 p σ j +
        Hd.Qf (Hd.A 1) p σ j * Hd.Xf B0 p σ i) ≤
      (1 + √(2 / π)) * Hd.h ^ 2 * (2 * Xs kk B0 i j * Ys kk B0 i j +
        Hs kk (Hd.A 2) i j * Ys kk B0 i j + Qs kk (Hd.A 1) i j * Xs kk B0 i j) := by
  set C := 1 + √(2 / π)
  have hC : 0 ≤ C := by positivity
  obtain ⟨iX, eX⟩ := Hd.E_X hk hu hh hτ hσ h1 B0 i j
  obtain ⟨iY, eY⟩ := Hd.E_Y hk hu hh hτ hσ h0 B0 i j
  obtain ⟨iH, eH⟩ := Hd.E_H hk hu hh hτ hσ h2 (Hd.A 2) i j
  obtain ⟨iQ, eQ⟩ := Hd.E_Q hk hu hh hτ hσ h2 (Hd.A 1) i j
  have hρ := Hd.rho_nonneg hh.le β s σ i j
  have hρc := Hd.rho_continuous β s hτ σ hσ i j
  have cX : Continuous fun p => Hd.Xf B0 p σ i := Hd.continuous_wsum σ hσ 1 _
  have cY : Continuous fun p => Hd.Yf B0 p σ j := Hd.continuous_wsum σ hσ 0 _
  have cH : Continuous fun p => Hd.Hf (Hd.A 2) p σ i := Hd.continuous_wsum σ hσ 2 _
  have cQ : Continuous fun p => Hd.Qf (Hd.A 1) p σ j := Hd.continuous_wsum σ hσ 2 _
  have iXY := rho_mul_integrable hρ hρc cX cY iX iY
  have iHY := rho_mul_integrable hρ hρc cH cY iH iY
  have iQX := rho_mul_integrable hρ hρc cQ cX iQ iX
  have hM : ∀ (f : ι → ℝ) (z : ℤ), (∀ m, 0 ≤ f m) → 0 ≤ maxZ (zext kk f) z := fun f z hf =>
    (zext_finSupp hf).maxZ_nonneg z
  have bound : ∀ (f g : (Fin 3 → ℝ) → ℝ) (a b : ℝ), 0 ≤ a → 0 ≤ b →
      Integrable (fun p => Hd.rho β s σ i j p * f p ^ 2) →
      Integrable (fun p => Hd.rho β s σ i j p * g p ^ 2) →
      Integrable (fun p => Hd.rho β s σ i j p * (f p * g p)) →
      ∫ p, Hd.rho β s σ i j p * f p ^ 2 ≤ Hd.h ^ 2 * (C * a) →
      ∫ p, Hd.rho β s σ i j p * g p ^ 2 ≤ Hd.h ^ 2 * (C * b) →
      ∫ p, Hd.rho β s σ i j p * (f p * g p) ≤ C * Hd.h ^ 2 * (√a * √b) := by
    intro f g a b ha hb if2 ig2 ifg ef eg
    refine (integral_rho_mul_le hρ if2 ig2 ifg).trans ?_
    calc √(∫ p, Hd.rho β s σ i j p * f p ^ 2) * √(∫ p, Hd.rho β s σ i j p * g p ^ 2)
        ≤ √(Hd.h ^ 2 * (C * a)) * √(Hd.h ^ 2 * (C * b)) :=
          mul_le_mul (Real.sqrt_le_sqrt ef) (Real.sqrt_le_sqrt eg) (Real.sqrt_nonneg _)
            (Real.sqrt_nonneg _)
      _ = C * Hd.h ^ 2 * (√a * √b) := by
          rw [sqrt_h2_mul hh.le C hC ha, sqrt_h2_mul hh.le C hC hb,
            show Hd.h * √C * √a * (Hd.h * √C * √b) = (√C * √C) * Hd.h ^ 2 * (√a * √b) by ring,
            Real.mul_self_sqrt hC]
  have bXY := bound _ _ _ _ (hM _ _ fun m => sq_nonneg _) (hM _ _ fun m => sq_nonneg _)
    iX iY iXY eX eY
  have bHY := bound _ _ _ _ (hM _ _ fun m => sq_nonneg _) (hM _ _ fun m => sq_nonneg _)
    iH iY iHY eH eY
  have bQX := bound _ _ _ _ (hM _ _ fun m => sq_nonneg _) (hM _ _ fun m => sq_nonneg _)
    iQ iX iQX eQ eX
  have e : (fun p => Hd.rho β s σ i j p *
      (2 * Hd.Xf B0 p σ i * Hd.Yf B0 p σ j + Hd.Hf (Hd.A 2) p σ i * Hd.Yf B0 p σ j +
        Hd.Qf (Hd.A 1) p σ j * Hd.Xf B0 p σ i)) = fun p =>
      2 * (Hd.rho β s σ i j p * (Hd.Xf B0 p σ i * Hd.Yf B0 p σ j)) +
        Hd.rho β s σ i j p * (Hd.Hf (Hd.A 2) p σ i * Hd.Yf B0 p σ j) +
        Hd.rho β s σ i j p * (Hd.Qf (Hd.A 1) p σ j * Hd.Xf B0 p σ i) := by
    funext p; ring
  rw [e]
  refine ⟨((iXY.const_mul 2).add iHY).add iQX, ?_⟩
  rw [integral_add, integral_add, integral_const_mul]
  · simp only [Xs, Ys, Hs, Qs]
    nlinarith [bXY, bHY, bQX]
  · exact iXY.const_mul 2
  · exact iHY
  · exact (iXY.const_mul 2).add iHY
  · exact iQX

end HeatData

end D02Jump6

section D02Jump7

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι) {kk : ι → ℤ}

/-- Integrability of the averaged energy integrand at a fixed scale. -/
lemma Jbar_integrable (hh : 0 < Hd.h) {η : ℝ} (hη : 0 < η) {α : Fin 3 → ℝ}
    (hα1 : ∀ k, 1 ≤ α k) (hα2 : ∀ k, α k ≤ 2) {s : ℝ} (hs : 0 < s) :
    Integrable (fun p => Gm (1 / 10) 0 s p * ∑ v, Hd.qE α η v s p) := by
  have e : (fun p => Gm (1 / 10) 0 s p * ∑ v, Hd.qE α η v s p) =
      fun p => ∑ v, Gm (1 / 10) 0 s p * Hd.qE α η v s p := by
    funext p; rw [Finset.mul_sum]
  rw [e]
  refine integrable_finsetSum _ fun v _ => ?_
  have G := Hd.family_good α η v hh hη hα1 hα2 hs (le_refl s)
  exact (good_integrable (Q := fun z => Hd.qE α η v z.1 z.2) hs (by positivity : (0 : ℝ) < 2 * s)
    (by norm_num : (0 : ℝ) < 1 / 10) v (G _ (by simp)).1 (G _ (by simp)).2 0).1 s
    ⟨le_rfl, le_rfl⟩

/-- The error term of the regularized jump bound (it is multiplied by `√η`). -/
def jumpErr (α : Fin 3 → ℝ) (s : ℝ) (B0 Bm Bp : Matrix ι ι ℂ) : ℝ :=
  3 * ∑ i, ∑ j, ‖Bp i j - Bm i j‖ * ∫ p, Gm (1 / 10) 0 s p *
    (Hd.w p (sig α s) 0 i * √(Hd.w p (sig α s) 1 j) *
        (Hd.Xf B0 p (sig α s) i + Hd.Hf (Hd.A 2) p (sig α s) i) +
      √(Hd.w p (sig α s) 0 i) * Hd.w p (sig α s) 1 j *
        (Hd.Yf B0 p (sig α s) j + Hd.Qf (Hd.A 1) p (sig α s) j))

lemma err_integrable (hh : 0 < Hd.h) {β s : ℝ} (hτ : 0 < β * s) {σ : Fin 3 → ℝ}
    (hσ : ∀ k, 0 < σ k) (B0 : Matrix ι ι ℂ) (i j : ι) :
    Integrable (fun p => Gm β 0 s p *
      (Hd.w p σ 0 i * √(Hd.w p σ 1 j) * (Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i) +
        √(Hd.w p σ 0 i) * Hd.w p σ 1 j * (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j))) := by
  set CX := √(∑ m, ‖B0 i m‖ ^ 2 * (Hd.h * (√(2 * π * σ 1))⁻¹))
  set CH := √(∑ m, ‖Hd.A 2 m i‖ ^ 2 * (Hd.h * (√(2 * π * σ 2))⁻¹))
  set CY := √(∑ m, ‖B0 m j‖ ^ 2 * (Hd.h * (√(2 * π * σ 0))⁻¹))
  set CQ := √(∑ m, ‖Hd.A 1 j m‖ ^ 2 * (Hd.h * (√(2 * π * σ 2))⁻¹))
  have hX : ∀ p, Hd.Xf B0 p σ i ≤ CX := fun p =>
    Hd.wsum_le hh.le p σ 1 _ fun m => sq_nonneg _
  have hH : ∀ p, Hd.Hf (Hd.A 2) p σ i ≤ CH := fun p =>
    Hd.wsum_le hh.le p σ 2 _ fun m => sq_nonneg _
  have hY : ∀ p, Hd.Yf B0 p σ j ≤ CY := fun p =>
    Hd.wsum_le hh.le p σ 0 _ fun m => sq_nonneg _
  have hQ : ∀ p, Hd.Qf (Hd.A 1) p σ j ≤ CQ := fun p =>
    Hd.wsum_le hh.le p σ 2 _ fun m => sq_nonneg _
  have i1 := Hd.G_w0_sqrtw1_integrable hh.le hτ hσ i j
  have i2 := Hd.G_sqrtw0_w1_integrable hh.le hτ hσ i j
  have hcont : Continuous (fun p => Gm β 0 s p *
      (Hd.w p σ 0 i * √(Hd.w p σ 1 j) * (Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i) +
        √(Hd.w p σ 0 i) * Hd.w p σ 1 j * (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j))) := by
    have cG : Continuous fun p : Fin 3 → ℝ => Gm β 0 s p := by
      have : (fun p : Fin 3 → ℝ => Gm β 0 s p) =
          fun p => gaussian (β * s) (p 0 + p 1 + p 2) := by funext p; rw [Gm_eq]
      rw [this]; exact (continuous_gaussian' _).comp (by fun_prop)
    have c0 := Hd.continuous_w_p σ hσ 0 i
    have c1 := Hd.continuous_w_p σ hσ 1 j
    have cX : Continuous fun p => Hd.Xf B0 p σ i := Hd.continuous_wsum σ hσ 1 _
    have cY : Continuous fun p => Hd.Yf B0 p σ j := Hd.continuous_wsum σ hσ 0 _
    have cH : Continuous fun p => Hd.Hf (Hd.A 2) p σ i := Hd.continuous_wsum σ hσ 2 _
    have cQ : Continuous fun p => Hd.Qf (Hd.A 1) p σ j := Hd.continuous_wsum σ hσ 2 _
    exact cG.mul (((c0.mul (Real.continuous_sqrt.comp c1)).mul (cX.add cH)).add
      (((Real.continuous_sqrt.comp c0).mul c1).mul (cY.add cQ)))
  refine ((i1.const_mul (CX + CH)).add (i2.const_mul (CY + CQ))).mono'
    hcont.aestronglyMeasurable (Eventually.of_forall fun p => ?_)
  have hG : 0 ≤ Gm β 0 s p := by rw [Gm_eq]; exact gaussian_nonneg' _ _
  have hw0 : 0 ≤ Hd.w p σ 0 i := gweight_nonneg' _ hh.le _ _ _
  have hw1 : 0 ≤ Hd.w p σ 1 j := gweight_nonneg' _ hh.le _ _ _
  have nX : 0 ≤ Hd.Xf B0 p σ i := Real.sqrt_nonneg _
  have nH : 0 ≤ Hd.Hf (Hd.A 2) p σ i := Real.sqrt_nonneg _
  have nY : 0 ≤ Hd.Yf B0 p σ j := Real.sqrt_nonneg _
  have nQ : 0 ≤ Hd.Qf (Hd.A 1) p σ j := Real.sqrt_nonneg _
  have s0 := Real.sqrt_nonneg (Hd.w p σ 0 i)
  have s1 := Real.sqrt_nonneg (Hd.w p σ 1 j)
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  simp only [Pi.add_apply]
  have a1 : Gm β 0 s p * (Hd.w p σ 0 i * √(Hd.w p σ 1 j) *
      (Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i)) ≤
      (CX + CH) * (Gm β 0 s p * (Hd.w p σ 0 i * √(Hd.w p σ 1 j))) := by
    have : Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i ≤ CX + CH := add_le_add (hX p) (hH p)
    have hP : 0 ≤ Gm β 0 s p * (Hd.w p σ 0 i * √(Hd.w p σ 1 j)) := by positivity
    nlinarith
  have a2 : Gm β 0 s p * (√(Hd.w p σ 0 i) * Hd.w p σ 1 j *
      (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j)) ≤
      (CY + CQ) * (Gm β 0 s p * (√(Hd.w p σ 0 i) * Hd.w p σ 1 j)) := by
    have : Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j ≤ CY + CQ := add_le_add (hY p) (hQ p)
    have hP : 0 ≤ Gm β 0 s p * (√(Hd.w p σ 0 i) * Hd.w p σ 1 j) := by positivity
    nlinarith
  nlinarith

/-- **Lemma 5.2, the jump of the averaged energy at one switch** (regularized):
`|J̄[A₀'](s) - J̄[A₀](s)| ≤ 3 C h² ∑_{ij} |δA(i,j)| (2X_*Y_* + H_*Y_* + Q_*X_*) + √η Err`,
for `s ≥ h²`, rates in `[1, 2]`, and arrays with entries bounded by `|B₀|`. -/
theorem jump_integrated (hk : Function.Injective kk) (hu : ∀ i, Hd.u i = Hd.h * kk i)
    (hh : 0 < Hd.h) {η : ℝ} (hη : 0 < η) {α : Fin 3 → ℝ} (hα1 : ∀ k, 1 ≤ α k)
    (hα2 : ∀ k, α k ≤ 2) {s : ℝ} (hs : Hd.h ^ 2 ≤ s) (Bm Bp B0 : Matrix ι ι ℂ)
    (hm : ∀ i j, ‖Bm i j‖ ≤ ‖B0 i j‖) (hp : ∀ i j, ‖Bp i j‖ ≤ ‖B0 i j‖) :
    |(Hd.withA0 Bp).Jbar α η s - (Hd.withA0 Bm).Jbar α η s| ≤
      3 * ((1 + √(2 / π)) * Hd.h ^ 2 * ∑ i, ∑ j, ‖Bp i j - Bm i j‖ *
        (2 * Xs kk B0 i j * Ys kk B0 i j + Hs kk (Hd.A 2) i j * Ys kk B0 i j +
          Qs kk (Hd.A 1) i j * Xs kk B0 i j)) + √η * Hd.jumpErr α s B0 Bm Bp := by
  have hs0 : 0 < s := lt_of_lt_of_le (by positivity) hs
  set σ := sig α s with hσdef
  have hσ : ∀ k, 0 < σ k := fun k => mul_pos (zero_lt_one.trans_le (hα1 k)) hs0
  have hσs : ∀ k, s ≤ σ k := fun k => by
    simp only [σ, sig]; nlinarith [hα1 k]
  have hτ : 0 < 1 / 10 * s := by positivity
  have h0 : Hd.h ^ 2 ≤ σ 0 + σ 0 := by linarith [hσs 0, hσ 0]
  have h1 : Hd.h ^ 2 ≤ σ 1 + σ 1 := by linarith [hσs 1, hσ 1]
  have h2 : Hd.h ^ 2 ≤ 1 / 10 * s + σ 2 + σ 1 + σ 0 := by linarith [hσs 0, hσ 1, hσ 2]
  have iP := (Hd.withA0 Bp).Jbar_integrable hh hη hα1 hα2 hs0
  have iM := (Hd.withA0 Bm).Jbar_integrable hh hη hα1 hα2 hs0
  set C := 1 + √(2 / π)
  -- the majorant
  set T : ι → ι → (Fin 3 → ℝ) → ℝ := fun i j p =>
    3 * ‖Bp i j - Bm i j‖ * (Hd.rho (1 / 10) s σ i j p *
      (2 * Hd.Xf B0 p σ i * Hd.Yf B0 p σ j + Hd.Hf (Hd.A 2) p σ i * Hd.Yf B0 p σ j +
        Hd.Qf (Hd.A 1) p σ j * Hd.Xf B0 p σ i)) +
    3 * ‖Bp i j - Bm i j‖ * √η * (Gm (1 / 10) 0 s p *
      (Hd.w p σ 0 i * √(Hd.w p σ 1 j) * (Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i) +
        √(Hd.w p σ 0 i) * Hd.w p σ 1 j * (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j)))
  have hTint : ∀ i j, Integrable (T i j) := fun i j =>
    ((Hd.rho_cross_le hk hu hh hτ hσ h0 h1 h2 B0 i j).1.const_mul _).add
      ((Hd.err_integrable hh hτ hσ B0 i j).const_mul _)
  have hTsum : Integrable (fun p => ∑ i, ∑ j, T i j p) :=
    integrable_finsetSum _ fun i _ => integrable_finsetSum _ fun j _ => hTint i j
  have hpt : ∀ p, ‖Gm (1 / 10) 0 s p * ∑ v, (Hd.withA0 Bp).qE α η v s p -
      Gm (1 / 10) 0 s p * ∑ v, (Hd.withA0 Bm).qE α η v s p‖ ≤ ∑ i, ∑ j, T i j p := by
    intro p
    have hG : 0 ≤ Gm (1 / 10) 0 s p := by rw [Gm_eq]; exact gaussian_nonneg' _ _
    have hj := Hd.jump_pointwise hh.le hη Bm Bp B0 hm hp p σ
    rw [Real.norm_eq_abs, ← mul_sub, abs_mul, abs_of_nonneg hG]
    calc Gm (1 / 10) 0 s p * |∑ v, (Hd.withA0 Bp).qE α η v s p -
          ∑ v, (Hd.withA0 Bm).qE α η v s p|
        ≤ Gm (1 / 10) 0 s p * (3 * ∑ i, ∑ j, ‖Bp i j - Bm i j‖ *
          (Hd.w p σ 0 i * Hd.w p σ 1 j *
              (2 * Hd.Xf B0 p σ i * Hd.Yf B0 p σ j + Hd.Hf (Hd.A 2) p σ i * Hd.Yf B0 p σ j +
                Hd.Qf (Hd.A 1) p σ j * Hd.Xf B0 p σ i) +
            √η * (Hd.w p σ 0 i * √(Hd.w p σ 1 j) * (Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i) +
              √(Hd.w p σ 0 i) * Hd.w p σ 1 j *
                (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j)))) :=
          mul_le_mul_of_nonneg_left hj hG
      _ = ∑ i, ∑ j, T i j p := by
          simp only [T, rho, Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
          ring
  have hJ : (Hd.withA0 Bp).Jbar α η s - (Hd.withA0 Bm).Jbar α η s =
      ∫ p, (Gm (1 / 10) 0 s p * ∑ v, (Hd.withA0 Bp).qE α η v s p -
        Gm (1 / 10) 0 s p * ∑ v, (Hd.withA0 Bm).qE α η v s p) := by
    rw [Jbar, Jbar, integral_sub iP iM]
  rw [hJ]
  refine (norm_integral_le_of_norm_le hTsum (Eventually.of_forall hpt)).trans ?_
  rw [integral_finsetSum _ fun i _ => integrable_finsetSum _ fun j _ => hTint i j]
  simp_rw [integral_finsetSum _ fun j _ => hTint _ j]
  have hT : ∀ i j, ∫ p, T i j p ≤ 3 * ‖Bp i j - Bm i j‖ * (C * Hd.h ^ 2 *
      (2 * Xs kk B0 i j * Ys kk B0 i j + Hs kk (Hd.A 2) i j * Ys kk B0 i j +
        Qs kk (Hd.A 1) i j * Xs kk B0 i j)) +
      √η * (3 * ‖Bp i j - Bm i j‖ * ∫ p, Gm (1 / 10) 0 s p *
        (Hd.w p σ 0 i * √(Hd.w p σ 1 j) * (Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i) +
          √(Hd.w p σ 0 i) * Hd.w p σ 1 j * (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j))) := by
    intro i j
    obtain ⟨iR, bR⟩ := Hd.rho_cross_le hk hu hh hτ hσ h0 h1 h2 B0 i j
    simp only [T]
    rw [integral_add (iR.const_mul _) ((Hd.err_integrable hh hτ hσ B0 i j).const_mul _),
      integral_const_mul, integral_const_mul]
    have hδ : 0 ≤ 3 * ‖Bp i j - Bm i j‖ := by positivity
    nlinarith [mul_le_mul_of_nonneg_left bR hδ]
  calc ∑ i, ∑ j, ∫ p, T i j p ≤ ∑ i, ∑ j, (3 * ‖Bp i j - Bm i j‖ * (C * Hd.h ^ 2 *
        (2 * Xs kk B0 i j * Ys kk B0 i j + Hs kk (Hd.A 2) i j * Ys kk B0 i j +
          Qs kk (Hd.A 1) i j * Xs kk B0 i j)) +
        √η * (3 * ‖Bp i j - Bm i j‖ * ∫ p, Gm (1 / 10) 0 s p *
          (Hd.w p σ 0 i * √(Hd.w p σ 1 j) * (Hd.Xf B0 p σ i + Hd.Hf (Hd.A 2) p σ i) +
            √(Hd.w p σ 0 i) * Hd.w p σ 1 j * (Hd.Yf B0 p σ j + Hd.Qf (Hd.A 1) p σ j)))) :=
        Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hT i j
    _ = _ := by
        simp only [jumpErr, Finset.sum_add_distrib, Finset.mul_sum, ← hσdef]
        congr 1
        · refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
          ring
        · refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
          ring

end HeatData

