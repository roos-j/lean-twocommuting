/-! ### Lemma 5.2: Hölder on the mesh and the maximal `ℓ³` bounds -/

section D02Holder

/-- Hölder's inequality with three factors in `ℓ³`. -/
lemma holder3 {κ : Type*} (s : Finset κ) (a b c : κ → ℝ) (ha : ∀ k, 0 ≤ a k) (hb : ∀ k, 0 ≤ b k)
    (hc : ∀ k, 0 ≤ c k) :
    ∑ k ∈ s, a k * b k * c k ≤
      (∑ k ∈ s, a k ^ 3) ^ (1 / 3 : ℝ) * (∑ k ∈ s, b k ^ 3) ^ (1 / 3 : ℝ) *
        (∑ k ∈ s, c k ^ 3) ^ (1 / 3 : ℝ) := by
  have hbc : ∀ k, 0 ≤ b k * c k := fun k => mul_nonneg (hb k) (hc k)
  -- `∑ a (bc) ≤ ‖a‖₃ ‖bc‖_{3/2}`
  have h1 := Real.inner_le_Lp_mul_Lq_of_nonneg s (f := a) (g := fun k => b k * c k)
    (p := 3) (q := 3 / 2) (by rw [Real.holderConjugate_iff]; norm_num) (fun k _ => ha k)
    (fun k _ => hbc k)
  -- `∑ (bc)^{3/2} ≤ ‖b‖₃^{3/2} ‖c‖₃^{3/2}`
  have hb32 : ∀ k, 0 ≤ b k ^ (3 / 2 : ℝ) := fun k => Real.rpow_nonneg (hb k) _
  have hc32 : ∀ k, 0 ≤ c k ^ (3 / 2 : ℝ) := fun k => Real.rpow_nonneg (hc k) _
  have h2 := Real.inner_le_Lp_mul_Lq_of_nonneg s (f := fun k => b k ^ (3 / 2 : ℝ))
    (g := fun k => c k ^ (3 / 2 : ℝ)) (p := 2) (q := 2) (by rw [Real.holderConjugate_iff]; norm_num)
    (fun k _ => hb32 k) (fun k _ => hc32 k)
  have sq32 : ∀ x : ℝ, 0 ≤ x → (x ^ (3 / 2 : ℝ)) ^ (2 : ℝ) = x ^ 3 := fun x hx => by
    rw [← Real.rpow_mul hx]; norm_num
  simp only [sq32 _ (hb _), sq32 _ (hc _)] at h2
  have hmul : ∀ k, (b k * c k) ^ (3 / 2 : ℝ) = b k ^ (3 / 2 : ℝ) * c k ^ (3 / 2 : ℝ) :=
    fun k => Real.mul_rpow (hb k) (hc k)
  have hcube : ∀ x : ℝ, 0 ≤ x → x ^ (3 : ℝ) = x ^ 3 := fun x _ => by
    rw [show (3 : ℝ) = ((3 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
  simp only [hcube _ (ha _)] at h1
  have Sb : 0 ≤ ∑ k ∈ s, b k ^ 3 := Finset.sum_nonneg fun k _ => pow_nonneg (hb k) 3
  have Sc : 0 ≤ ∑ k ∈ s, c k ^ 3 := Finset.sum_nonneg fun k _ => pow_nonneg (hc k) 3
  have Sbc : 0 ≤ ∑ k ∈ s, (b k * c k) ^ (3 / 2 : ℝ) :=
    Finset.sum_nonneg fun k _ => Real.rpow_nonneg (hbc k) _
  have h3 : (∑ k ∈ s, (b k * c k) ^ (3 / 2 : ℝ)) ^ (1 / (3 / 2) : ℝ) ≤
      (∑ k ∈ s, b k ^ 3) ^ (1 / 3 : ℝ) * (∑ k ∈ s, c k ^ 3) ^ (1 / 3 : ℝ) := by
    simp only [hmul]
    have := Real.rpow_le_rpow (Finset.sum_nonneg fun k _ => mul_nonneg (hb32 k) (hc32 k)) h2
      (by norm_num : (0 : ℝ) ≤ 2 / 3)
    rw [Real.mul_rpow (Real.rpow_nonneg Sb _) (Real.rpow_nonneg Sc _), ← Real.rpow_mul Sb,
      ← Real.rpow_mul Sc] at this
    convert this using 2 <;> norm_num
  calc ∑ k ∈ s, a k * b k * c k = ∑ k ∈ s, a k * (b k * c k) :=
        Finset.sum_congr rfl fun k _ => by ring
    _ ≤ (∑ k ∈ s, a k ^ 3) ^ (1 / 3 : ℝ) *
        (∑ k ∈ s, (b k * c k) ^ (3 / 2 : ℝ)) ^ (1 / (3 / 2) : ℝ) := by
        simpa using h1
    _ ≤ _ := by
        rw [mul_assoc]
        exact mul_le_mul_of_nonneg_left h3 (Real.rpow_nonneg
          (Finset.sum_nonneg fun k _ => pow_nonneg (ha k) 3) _)

lemma sqrt_pow_three {x : ℝ} (hx : 0 ≤ x) : √x ^ 3 = x ^ (3 / 2 : ℝ) := by
  rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hx]; norm_num

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {kk : ι → ℤ}

/-- The maximal function in `ℓ^{3/2}` along an injective window. -/
lemma sum_maxZ_comp_le (hk : Function.Injective kk) (f : ι → ℝ) (hf : ∀ m, 0 ≤ f m)
    {φ : ι → ℤ} (hφ : Function.Injective φ) :
    ∑ j, maxZ (zext kk f) (φ j) ^ (3 / 2 : ℝ) ≤
      30 * √2 * ∑ m, f m ^ (3 / 2 : ℝ) := by
  classical
  have hS := zext_finSupp (kk := kk) hf
  have := hS.strong_maxZ (p := 3 / 2) (by norm_num) (Finset.univ.image φ)
  rw [Finset.sum_image fun x _ y _ h => hφ h] at this
  have hsum : ∑ z ∈ Finset.univ.image kk, zext kk f z ^ (3 / 2 : ℝ) =
      ∑ m, f m ^ (3 / 2 : ℝ) := by
    rw [Finset.sum_image fun x _ y _ h => hk h]
    exact Finset.sum_congr rfl fun m _ => by rw [zext_kk hk]
  rw [hsum] at this
  have hC : (10 : ℝ) * (3 / 2) * 2 ^ ((3 : ℝ) / 2 - 1) / (3 / 2 - 1) = 30 * √2 := by
    rw [show (3 : ℝ) / 2 - 1 = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow]; ring
  rwa [hC] at this

/-- `∑_{ij} X_*³ ≤ 30√2 ∑_{ij} |B(i,j)|³`. -/
lemma sum_Xs_cube (hk : Function.Injective kk) (B : Matrix ι ι ℂ) :
    ∑ i, ∑ j, Xs kk B i j ^ 3 ≤ 30 * √2 * ∑ i, ∑ j, ‖B i j‖ ^ 3 := by
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun i _ => ?_
  have h := sum_maxZ_comp_le hk (fun m => ‖B i m‖ ^ 2) (fun m => sq_nonneg _) hk
  simp only [Xs]
  rw [Finset.sum_congr rfl fun j _ => sqrt_pow_three ((zext_finSupp
    (kk := kk) (f := fun m => ‖B i m‖ ^ 2) fun m => sq_nonneg _).maxZ_nonneg _)]
  refine h.trans (le_of_eq ?_)
  congr 1; refine Finset.sum_congr rfl fun m _ => ?_
  rw [← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _)]; norm_num

/-- `∑_{ij} Y_*³ ≤ 30√2 ∑_{ij} |B(i,j)|³`. -/
lemma sum_Ys_cube (hk : Function.Injective kk) (B : Matrix ι ι ℂ) :
    ∑ i, ∑ j, Ys kk B i j ^ 3 ≤ 30 * √2 * ∑ i, ∑ j, ‖B i j‖ ^ 3 := by
  rw [Finset.sum_comm, Finset.sum_comm (f := fun i j => ‖B i j‖ ^ 3), Finset.mul_sum]
  refine Finset.sum_le_sum fun j _ => ?_
  have h := sum_maxZ_comp_le hk (fun m => ‖B m j‖ ^ 2) (fun m => sq_nonneg _) hk
  simp only [Ys]
  rw [Finset.sum_congr rfl fun i _ => sqrt_pow_three ((zext_finSupp
    (kk := kk) (f := fun m => ‖B m j‖ ^ 2) fun m => sq_nonneg _).maxZ_nonneg _)]
  refine h.trans (le_of_eq ?_)
  congr 1; refine Finset.sum_congr rfl fun m _ => ?_
  rw [← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _)]; norm_num

/-- `∑_{ij} H_*³ ≤ 30√2 ∑_{ij} |A(i,j)|³`. -/
lemma sum_Hs_cube (hk : Function.Injective kk) (A : Matrix ι ι ℂ) :
    ∑ i, ∑ j, Hs kk A i j ^ 3 ≤ 30 * √2 * ∑ i, ∑ j, ‖A i j‖ ^ 3 := by
  rw [Finset.sum_comm (f := fun i j => ‖A i j‖ ^ 3), Finset.mul_sum]
  refine Finset.sum_le_sum fun i _ => ?_
  have h := sum_maxZ_comp_le hk (fun m => ‖A m i‖ ^ 2) (fun m => sq_nonneg _)
    (φ := fun j => -kk i - kk j) (fun x y hxy => hk (by simpa using hxy))
  simp only [Hs]
  rw [Finset.sum_congr rfl fun j _ => sqrt_pow_three ((zext_finSupp
    (kk := kk) (f := fun m => ‖A m i‖ ^ 2) fun m => sq_nonneg _).maxZ_nonneg _)]
  refine h.trans (le_of_eq ?_)
  congr 1; refine Finset.sum_congr rfl fun m _ => ?_
  rw [← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _)]; norm_num

/-- `∑_{ij} Q_*³ ≤ 30√2 ∑_{ij} |A(i,j)|³`. -/
lemma sum_Qs_cube (hk : Function.Injective kk) (A : Matrix ι ι ℂ) :
    ∑ i, ∑ j, Qs kk A i j ^ 3 ≤ 30 * √2 * ∑ i, ∑ j, ‖A i j‖ ^ 3 := by
  rw [Finset.sum_comm, Finset.mul_sum]
  refine Finset.sum_le_sum fun j _ => ?_
  have h := sum_maxZ_comp_le hk (fun m => ‖A j m‖ ^ 2) (fun m => sq_nonneg _)
    (φ := fun i => -kk i - kk j) (fun x y hxy => hk (by simpa using hxy))
  simp only [Qs]
  rw [Finset.sum_congr rfl fun i _ => sqrt_pow_three ((zext_finSupp
    (kk := kk) (f := fun m => ‖A j m‖ ^ 2) fun m => sq_nonneg _).maxZ_nonneg _)]
  refine h.trans (le_of_eq ?_)
  congr 1; refine Finset.sum_congr rfl fun m _ => ?_
  rw [← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _)]; norm_num

end D02Holder

section D02Holder2

lemma holder3_bound {κ : Type*} (s : Finset κ) (a b c : κ → ℝ) (ha : ∀ k, 0 ≤ a k)
    (hb : ∀ k, 0 ≤ b k) (hc : ∀ k, 0 ≤ c k) {A B D C : ℝ} (hC : 0 ≤ C) (hA0 : 0 ≤ A)
    (hB0 : 0 ≤ B) (hD0 : 0 ≤ D) (hA : ∑ k ∈ s, a k ^ 3 ≤ A) (hB : ∑ k ∈ s, b k ^ 3 ≤ C * B)
    (hD : ∑ k ∈ s, c k ^ 3 ≤ C * D) :
    ∑ k ∈ s, a k * b k * c k ≤
      C ^ (2 / 3 : ℝ) * (A ^ (1 / 3 : ℝ) * B ^ (1 / 3 : ℝ) * D ^ (1 / 3 : ℝ)) := by
  refine (holder3 s a b c ha hb hc).trans ?_
  have p1 := Real.rpow_le_rpow (Finset.sum_nonneg fun k _ => pow_nonneg (ha k) 3) hA
    (by norm_num : (0 : ℝ) ≤ 1 / 3)
  have p2 := Real.rpow_le_rpow (Finset.sum_nonneg fun k _ => pow_nonneg (hb k) 3) hB
    (by norm_num : (0 : ℝ) ≤ 1 / 3)
  have p3 := Real.rpow_le_rpow (Finset.sum_nonneg fun k _ => pow_nonneg (hc k) 3) hD
    (by norm_num : (0 : ℝ) ≤ 1 / 3)
  rw [Real.mul_rpow hC hB0] at p2
  rw [Real.mul_rpow hC hD0] at p3
  have hCC : C ^ (1 / 3 : ℝ) * C ^ (1 / 3 : ℝ) = C ^ (2 / 3 : ℝ) := by
    rw [← Real.rpow_add' hC (by norm_num)]; norm_num
  calc (∑ k ∈ s, a k ^ 3) ^ (1 / 3 : ℝ) * (∑ k ∈ s, b k ^ 3) ^ (1 / 3 : ℝ) *
        (∑ k ∈ s, c k ^ 3) ^ (1 / 3 : ℝ)
      ≤ A ^ (1 / 3 : ℝ) * (C ^ (1 / 3 : ℝ) * B ^ (1 / 3 : ℝ)) *
          (C ^ (1 / 3 : ℝ) * D ^ (1 / 3 : ℝ)) := by
        have q1 := Real.rpow_nonneg (Finset.sum_nonneg fun k (_ : k ∈ s) => pow_nonneg (hb k) 3)
          (1 / 3 : ℝ)
        have q2 := Real.rpow_nonneg (Finset.sum_nonneg fun k (_ : k ∈ s) => pow_nonneg (hc k) 3)
          (1 / 3 : ℝ)
        have q3 := Real.rpow_nonneg hA0 (1 / 3 : ℝ)
        have q4 := Real.rpow_nonneg (mul_nonneg (Real.rpow_nonneg hC (1 / 3 : ℝ))
          (Real.rpow_nonneg hB0 (1 / 3 : ℝ))) 1
        rw [Real.rpow_one] at q4
        exact mul_le_mul (mul_le_mul p1 p2 q1 q3) p3 q2 (mul_nonneg q3 q4)
    _ = (C ^ (1 / 3 : ℝ) * C ^ (1 / 3 : ℝ)) *
          (A ^ (1 / 3 : ℝ) * B ^ (1 / 3 : ℝ) * D ^ (1 / 3 : ℝ)) := by ring
    _ = _ := by rw [hCC]

lemma cube_root_mul_h2 {h A B D : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hD : 0 ≤ D) :
    h ^ 2 * (A ^ (1 / 3 : ℝ) * B ^ (1 / 3 : ℝ) * D ^ (1 / 3 : ℝ)) =
      (h ^ 2 * A) ^ (1 / 3 : ℝ) * (h ^ 2 * B) ^ (1 / 3 : ℝ) * (h ^ 2 * D) ^ (1 / 3 : ℝ) := by
  have hh : 0 ≤ h ^ 2 := sq_nonneg h
  rw [Real.mul_rpow hh hA, Real.mul_rpow hh hB, Real.mul_rpow hh hD]
  have : (h ^ 2) ^ (1 / 3 : ℝ) * (h ^ 2) ^ (1 / 3 : ℝ) * (h ^ 2) ^ (1 / 3 : ℝ) = h ^ 2 := by
    rw [← Real.rpow_add' hh (by norm_num), ← Real.rpow_add' hh (by norm_num)]; norm_num
  calc h ^ 2 * (A ^ (1 / 3 : ℝ) * B ^ (1 / 3 : ℝ) * D ^ (1 / 3 : ℝ))
      = ((h ^ 2) ^ (1 / 3 : ℝ) * (h ^ 2) ^ (1 / 3 : ℝ) * (h ^ 2) ^ (1 / 3 : ℝ)) *
          (A ^ (1 / 3 : ℝ) * B ^ (1 / 3 : ℝ) * D ^ (1 / 3 : ℝ)) := by rw [this]
    _ = _ := by ring

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {kk : ι → ℤ}

/-- The cube root `n = (h² ∑ |A|³)^{1/3}` of an array. -/
def nNorm (h : ℝ) (A : Matrix ι ι ℂ) : ℝ := (h ^ 2 * ∑ i, ∑ j, ‖A i j‖ ^ 3) ^ (1 / 3 : ℝ)

omit [DecidableEq ι] in
lemma nNorm_nonneg (h : ℝ) (A : Matrix ι ι ℂ) : 0 ≤ nNorm h A :=
  Real.rpow_nonneg (mul_nonneg (sq_nonneg h) (by positivity)) _

omit [DecidableEq ι] in
lemma nNorm_cube (h : ℝ) (A : Matrix ι ι ℂ) :
    nNorm h A ^ 3 = h ^ 2 * ∑ i, ∑ j, ‖A i j‖ ^ 3 := by
  rw [nNorm, ← Real.rpow_natCast, ← Real.rpow_mul (mul_nonneg (sq_nonneg h) (by positivity))]
  norm_num

/-- **Lemma 5.2, Hölder on `ℤ²`:**
`h² ∑ |B₀|(2X_*Y_* + H_*Y_* + Q_*X_*) ≤ (30√2)^{2/3} (2n₀³ + n₀²n₂ + n₀²n₁)`. -/
theorem cross_holder (hk : Function.Injective kk) (h : ℝ) (B0 A1 A2 : Matrix ι ι ℂ) :
    h ^ 2 * ∑ i, ∑ j, ‖B0 i j‖ * (2 * Xs kk B0 i j * Ys kk B0 i j +
        Hs kk A2 i j * Ys kk B0 i j + Qs kk A1 i j * Xs kk B0 i j) ≤
      (30 * √2) ^ (2 / 3 : ℝ) * (2 * nNorm h B0 ^ 3 + nNorm h B0 ^ 2 * nNorm h A2 +
        nNorm h B0 ^ 2 * nNorm h A1) := by
  set C := 30 * √2
  have hC : 0 ≤ C := by positivity
  set S0 := ∑ i, ∑ j, ‖B0 i j‖ ^ 3
  set S1 := ∑ i, ∑ j, ‖A1 i j‖ ^ 3
  set S2 := ∑ i, ∑ j, ‖A2 i j‖ ^ 3
  have hS0 : 0 ≤ S0 := by positivity
  have hS1 : 0 ≤ S1 := by positivity
  have hS2 : 0 ≤ S2 := by positivity
  have pr : ∀ f : ι → ι → ℝ, ∑ i, ∑ j, f i j = ∑ z : ι × ι, f z.1 z.2 := fun f =>
    (Fintype.sum_prod_type (fun z : ι × ι => f z.1 z.2)).symm
  have nX : ∀ i j, 0 ≤ Xs kk B0 i j := fun i j => Real.sqrt_nonneg _
  have nY : ∀ i j, 0 ≤ Ys kk B0 i j := fun i j => Real.sqrt_nonneg _
  have nH : ∀ i j, 0 ≤ Hs kk A2 i j := fun i j => Real.sqrt_nonneg _
  have nQ : ∀ i j, 0 ≤ Qs kk A1 i j := fun i j => Real.sqrt_nonneg _
  have cA : ∑ z : ι × ι, ‖B0 z.1 z.2‖ ^ 3 ≤ S0 := by rw [Fintype.sum_prod_type]
  have cX : ∑ z : ι × ι, Xs kk B0 z.1 z.2 ^ 3 ≤ C * S0 := by
    rw [Fintype.sum_prod_type]; exact sum_Xs_cube hk B0
  have cY : ∑ z : ι × ι, Ys kk B0 z.1 z.2 ^ 3 ≤ C * S0 := by
    rw [Fintype.sum_prod_type]; exact sum_Ys_cube hk B0
  have cH : ∑ z : ι × ι, Hs kk A2 z.1 z.2 ^ 3 ≤ C * S2 := by
    rw [Fintype.sum_prod_type]; exact sum_Hs_cube hk A2
  have cQ : ∑ z : ι × ι, Qs kk A1 z.1 z.2 ^ 3 ≤ C * S1 := by
    rw [Fintype.sum_prod_type]; exact sum_Qs_cube hk A1
  have b1 := holder3_bound Finset.univ (fun z : ι × ι => ‖B0 z.1 z.2‖)
    (fun z => Xs kk B0 z.1 z.2) (fun z => Ys kk B0 z.1 z.2) (fun z => norm_nonneg _)
    (fun z => nX _ _) (fun z => nY _ _) hC hS0 hS0 hS0 cA cX cY
  have b2 := holder3_bound Finset.univ (fun z : ι × ι => ‖B0 z.1 z.2‖)
    (fun z => Hs kk A2 z.1 z.2) (fun z => Ys kk B0 z.1 z.2) (fun z => norm_nonneg _)
    (fun z => nH _ _) (fun z => nY _ _) hC hS0 hS2 hS0 cA cH cY
  have b3 := holder3_bound Finset.univ (fun z : ι × ι => ‖B0 z.1 z.2‖)
    (fun z => Qs kk A1 z.1 z.2) (fun z => Xs kk B0 z.1 z.2) (fun z => norm_nonneg _)
    (fun z => nQ _ _) (fun z => nX _ _) hC hS0 hS1 hS0 cA cQ cX
  have hsplit : ∑ i, ∑ j, ‖B0 i j‖ * (2 * Xs kk B0 i j * Ys kk B0 i j +
      Hs kk A2 i j * Ys kk B0 i j + Qs kk A1 i j * Xs kk B0 i j) =
      2 * ∑ z : ι × ι, ‖B0 z.1 z.2‖ * Xs kk B0 z.1 z.2 * Ys kk B0 z.1 z.2 +
      ∑ z : ι × ι, ‖B0 z.1 z.2‖ * Hs kk A2 z.1 z.2 * Ys kk B0 z.1 z.2 +
      ∑ z : ι × ι, ‖B0 z.1 z.2‖ * Qs kk A1 z.1 z.2 * Xs kk B0 z.1 z.2 := by
    rw [pr, Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun z _ => by ring
  have e1 := cube_root_mul_h2 (h := h) hS0 hS0 hS0
  have e2 := cube_root_mul_h2 (h := h) hS0 hS2 hS0
  have e3 := cube_root_mul_h2 (h := h) hS0 hS1 hS0
  have n0 : (h ^ 2 * S0) ^ (1 / 3 : ℝ) = nNorm h B0 := rfl
  have n1 : (h ^ 2 * S1) ^ (1 / 3 : ℝ) = nNorm h A1 := rfl
  have n2 : (h ^ 2 * S2) ^ (1 / 3 : ℝ) = nNorm h A2 := rfl
  rw [n0, n2] at e2; rw [n0, n1] at e3; rw [n0] at e1
  have hC23 : 0 ≤ C ^ (2 / 3 : ℝ) := Real.rpow_nonneg hC _
  have hh2 : 0 ≤ h ^ 2 := sq_nonneg h
  rw [hsplit]
  calc h ^ 2 * (2 * ∑ z : ι × ι, ‖B0 z.1 z.2‖ * Xs kk B0 z.1 z.2 * Ys kk B0 z.1 z.2 +
        ∑ z : ι × ι, ‖B0 z.1 z.2‖ * Hs kk A2 z.1 z.2 * Ys kk B0 z.1 z.2 +
        ∑ z : ι × ι, ‖B0 z.1 z.2‖ * Qs kk A1 z.1 z.2 * Xs kk B0 z.1 z.2)
      ≤ h ^ 2 * (2 * (C ^ (2 / 3 : ℝ) * (S0 ^ (1 / 3 : ℝ) * S0 ^ (1 / 3 : ℝ) * S0 ^ (1 / 3 : ℝ))) +
          C ^ (2 / 3 : ℝ) * (S0 ^ (1 / 3 : ℝ) * S2 ^ (1 / 3 : ℝ) * S0 ^ (1 / 3 : ℝ)) +
          C ^ (2 / 3 : ℝ) * (S0 ^ (1 / 3 : ℝ) * S1 ^ (1 / 3 : ℝ) * S0 ^ (1 / 3 : ℝ))) := by
        gcongr
    _ = C ^ (2 / 3 : ℝ) * (2 * (h ^ 2 * (S0 ^ (1 / 3 : ℝ) * S0 ^ (1 / 3 : ℝ) * S0 ^ (1 / 3 : ℝ))) +
          h ^ 2 * (S0 ^ (1 / 3 : ℝ) * S2 ^ (1 / 3 : ℝ) * S0 ^ (1 / 3 : ℝ)) +
          h ^ 2 * (S0 ^ (1 / 3 : ℝ) * S1 ^ (1 / 3 : ℝ) * S0 ^ (1 / 3 : ℝ))) := by ring
    _ = _ := by rw [e1, e2, e3]; ring

end D02Holder2

/-! ### Lemma 5.2: removing the regularization `η ↓ 0` -/

section D02Limit

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- `√(P + η) = U diag(√(pᵢ + η)) Uᴴ` in the eigenbasis of `P ≥ 0`. -/
lemma sqrt_add_smul_eq {P : Matrix n n ℂ} (hP : P.PosSemidef) {η : ℝ} (hη : 0 ≤ η) :
    CFC.sqrt (P + (η : ℂ) • 1) = (hP.1.eigenvectorUnitary : Matrix n n ℂ) *
      diagonal (fun i => ((√(hP.1.eigenvalues i + η) : ℝ) : ℂ)) *
        star (hP.1.eigenvectorUnitary : Matrix n n ℂ) := by
  set U : Matrix n n ℂ := (hP.1.eigenvectorUnitary : Matrix n n ℂ)
  have hUU : star U * U = 1 := Unitary.coe_star_mul_self _
  have hUU' : U * star U = 1 := Unitary.coe_mul_star_self _
  have hspec : P = U * diagonal (fun i => ((hP.1.eigenvalues i : ℝ) : ℂ)) * star U := by
    have := hP.1.spectral_theorem
    rw [Unitary.conjStarAlgAut_apply] at this
    exact this
  refine CFC.sqrt_unique ?_ ?_
  · have hd : diagonal (fun i => ((√(hP.1.eigenvalues i + η) : ℝ) : ℂ)) *
        diagonal (fun i => ((√(hP.1.eigenvalues i + η) : ℝ) : ℂ)) =
        diagonal (fun i => ((hP.1.eigenvalues i : ℝ) : ℂ)) + (η : ℂ) • 1 := by
      rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one, ← Matrix.diagonal_smul,
        Matrix.diagonal_add]
      congr 1; funext i
      rw [← Complex.ofReal_mul, Real.mul_self_sqrt (by
        linarith [hP.eigenvalues_nonneg i])]
      simp
    calc U * diagonal (fun i => ((√(hP.1.eigenvalues i + η) : ℝ) : ℂ)) * star U *
          (U * diagonal (fun i => ((√(hP.1.eigenvalues i + η) : ℝ) : ℂ)) * star U)
        = U * (diagonal (fun i => ((√(hP.1.eigenvalues i + η) : ℝ) : ℂ)) *
            diagonal (fun i => ((√(hP.1.eigenvalues i + η) : ℝ) : ℂ))) * star U := by
          simp only [Matrix.mul_assoc]
          rw [← Matrix.mul_assoc (star U) U, hUU, Matrix.one_mul]
      _ = P + (η : ℂ) • 1 := by
          rw [hd, Matrix.mul_add, Matrix.add_mul, ← hspec, Matrix.mul_smul, Matrix.mul_one,
            Matrix.smul_mul, hUU']
  · refine (Matrix.PosSemidef.mul_mul_conjTranspose_same ?_ U).nonneg
    rw [Matrix.posSemidef_diagonal_iff]
    intro i
    exact_mod_cast Real.sqrt_nonneg _

/-- `√(P + ηₘ) → √P` as `ηₘ → 0`, `ηₘ ≥ 0`. -/
lemma tendsto_sqrt_add_smul {P : Matrix n n ℂ} (hP : P.PosSemidef) {η : ℕ → ℝ}
    (hη0 : ∀ m, 0 ≤ η m) (hη : Tendsto η atTop (𝓝 0)) :
    Tendsto (fun m => CFC.sqrt (P + (η m : ℂ) • 1)) atTop (𝓝 (CFC.sqrt P)) := by
  rw [sqrt_eq_conj_diagonal hP]
  simp_rw [sqrt_add_smul_eq hP (hη0 _)]
  refine ((tendsto_const_nhds.mul ?_).mul tendsto_const_nhds)
  refine tendsto_pi_nhds.2 fun i => tendsto_pi_nhds.2 fun j => ?_
  simp only [Matrix.diagonal_apply]
  split_ifs with hij
  · subst hij
    refine Complex.continuous_ofReal.continuousAt.tendsto.comp ?_
    have := ((tendsto_const_nhds (x := hP.1.eigenvalues i)).add hη).sqrt
    simpa using this
  · exact tendsto_const_nhds

/-- **Lower semicontinuity of the cost under the regularization:**
`b_P(K) ≤ liminf_m b_{P+ηₘ}(K)` for `ηₘ ↓ 0`. -/
lemma matCost_le_liminf {P : Matrix n n ℂ} (hP : P.PosSemidef) (K : Matrix n n ℂ)
    {η : ℕ → ℝ} (hη0 : ∀ m, 0 ≤ η m) (hη : Tendsto η atTop (𝓝 0)) :
    matCost P K ≤ liminf (fun m => matCost (P + (η m : ℂ) • 1) K) atTop := by
  refine iSup_le fun X => ?_
  have hc : Continuous fun A : Matrix n n ℂ => costInt A K X := by
    unfold costInt hsRe
    fun_prop
  have hlim : Tendsto (fun m => ENNReal.ofReal ((3 / 2) * costInt (CFC.sqrt (P + (η m : ℂ) • 1))
      K X)) atTop (𝓝 (ENNReal.ofReal ((3 / 2) * costInt (CFC.sqrt P) K X))) :=
    (ENNReal.continuous_ofReal.tendsto _).comp
      ((hc.tendsto _).comp (tendsto_sqrt_add_smul hP hη0 hη) |>.const_mul (3 / 2))
  rw [← hlim.liminf_eq]
  exact liminf_le_liminf (Eventually.of_forall fun m => le_iSup (fun X =>
    ENNReal.ofReal ((3 / 2) * costInt (CFC.sqrt (P + (η m : ℂ) • 1)) K X)) X)

/-- `Φ_{ηₘ}(P) → Φ(P)` as `ηₘ → 0`, `ηₘ ≥ 0`. -/
lemma tendsto_energyReg {P : Matrix n n ℂ} (hP : P.IsHermitian) {η : ℕ → ℝ}
    (hη : Tendsto η atTop (𝓝 0)) :
    Tendsto (fun m => energyReg (η m) P) atTop (𝓝 (energyReg 0 P)) := by
  simp only [energyReg, trF_eq_sum _ hP]
  refine tendsto_finsetSum _ fun i _ => ?_
  have hc : Continuous fun e : ℝ => (hP.eigenvalues i + e) ^ (3 / 2 : ℝ) - e ^ (3 / 2 : ℝ) :=
    ((Real.continuous_rpow_const (by norm_num)).comp (continuous_const.add continuous_id)).sub
      (Real.continuous_rpow_const (by norm_num))
  exact (hc.tendsto 0).comp hη

end D02Limit

/-! ### Lemma 5.2: telescoping the dissipation across the switches -/

section D02Telescope

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι)

lemma Jbar_nonneg (hh : 0 ≤ Hd.h) (α : Fin 3 → ℝ) {η : ℝ} (hη : 0 ≤ η) (s : ℝ) :
    0 ≤ Hd.Jbar α η s := by
  refine integral_nonneg fun p => mul_nonneg ?_ (Finset.sum_nonneg fun v _ =>
    (energyReg_bounds (Matrix.posSemidef_conjTranspose_mul_self _) hη).1)
  rw [Gm_eq]; exact gaussian_nonneg' _ _

/-- **Telescoping (proof of Lemma 5.2):** with arrays `A₀ = B_k` on the scale interval
`[t_k, t_{k+1}]`, Lemma 4.3 on each piece gives
`c_* ∑_{k ≤ N} ∫_{t_k}^{t_{k+1}} ∑_v V̄_v ≤ J̄(t₀) - J̄(t_{N+1}) + ∑_{k<N} |J̄ jump at t_{k+1}|`. -/
theorem telescope_dissipation (hh : 0 < Hd.h) {η : ℝ} (hη : 0 < η) {α : Fin 3 → ℝ}
    (hα : ∀ k, α k = 1 ∨ α k = 11 / 10) (hsum : α 0 + α 1 + α 2 = 16 / 5) (t : ℕ → ℝ)
    (ht0 : 0 < t 0) (hmono : Monotone t) (B : ℕ → Matrix ι ι ℂ) (N : ℕ) :
    (1 / 28) * ∑ k ∈ Finset.range (N + 1),
        ∫ s in t k..t (k + 1), ∑ v, (Hd.withA0 (B k)).Vbar α η v s ≤
      (Hd.withA0 (B 0)).Jbar α η (t 0) - (Hd.withA0 (B N)).Jbar α η (t (N + 1)) +
        ∑ k ∈ Finset.range N, |(Hd.withA0 (B (k + 1))).Jbar α η (t (k + 1)) -
          (Hd.withA0 (B k)).Jbar α η (t (k + 1))| := by
  have hpos : ∀ k, 0 < t k := fun k => ht0.trans_le (hmono (Nat.zero_le k))
  have piece := fun k => (Hd.withA0 (B k)).smeared_plane_dissipation α η hh hη hα hsum (hpos k)
    (hmono (Nat.le_succ k))
  induction N with
  | zero =>
    simpa using piece 0
  | succ N ih =>
    simp only [Finset.sum_range_succ] at ih ⊢
    have hj := le_abs_self ((Hd.withA0 (B (N + 1))).Jbar α η (t (N + 1)) -
      (Hd.withA0 (B N)).Jbar α η (t (N + 1)))
    linarith [piece (N + 1)]

end HeatData

end D02Telescope

section D02Reg

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι) {kk : ι → ℤ}

/-- The constant of the jump bound. -/
def jumpConst : ℝ := 3 * (1 + √(2 / π)) * (30 * √2) ^ (2 / 3 : ℝ)

lemma jumpConst_nonneg : 0 ≤ jumpConst := by unfold jumpConst; positivity

/-- **Lemma 5.2, regularized form.** Arrays `A₀ = B_k` on `[t_k, t_{k+1}]`, all entries bounded
by `|B₀|`, with total variation `∑_k |B_{k+1}(i,j) - B_k(i,j)| ≤ 2n |B₀(i,j)|`, and `t₀ ≥ h²`:
`c_* ∑_k ∫_{t_k}^{t_{k+1}} ∑_v V̄_v ≤ J̄(t₀) + C · 2n (2n₀³ + n₀²n₂ + n₀²n₁) + √η Err`. -/
theorem integrated_cost_reg (hk : Function.Injective kk) (hu : ∀ i, Hd.u i = Hd.h * kk i)
    (hh : 0 < Hd.h) {η : ℝ} (hη : 0 < η) {α : Fin 3 → ℝ}
    (hα : ∀ k, α k = 1 ∨ α k = 11 / 10) (hsum : α 0 + α 1 + α 2 = 16 / 5) (t : ℕ → ℝ)
    (ht0 : Hd.h ^ 2 ≤ t 0) (hmono : Monotone t) (B : ℕ → Matrix ι ι ℂ) (B0 : Matrix ι ι ℂ)
    (hB : ∀ k i j, ‖B k i j‖ ≤ ‖B0 i j‖) {n : ℝ} (hn : 0 ≤ n) (N : ℕ)
    (hvar : ∀ i j, ∑ k ∈ Finset.range N, ‖B (k + 1) i j - B k i j‖ ≤ 2 * n * ‖B0 i j‖) :
    (1 / 28) * ∑ k ∈ Finset.range (N + 1),
        ∫ s in t k..t (k + 1), ∑ v, (Hd.withA0 (B k)).Vbar α η v s ≤
      (Hd.withA0 (B 0)).Jbar α η (t 0) +
        jumpConst * (2 * n) * (2 * nNorm Hd.h B0 ^ 3 + nNorm Hd.h B0 ^ 2 * nNorm Hd.h (Hd.A 2) +
          nNorm Hd.h B0 ^ 2 * nNorm Hd.h (Hd.A 1)) +
        √η * ∑ k ∈ Finset.range N, Hd.jumpErr α (t (k + 1)) B0 (B k) (B (k + 1)) := by
  have hα1 : ∀ k, 1 ≤ α k := fun k => by rcases hα k with h | h <;> rw [h]; norm_num
  have hα2 : ∀ k, α k ≤ 2 := fun k => by rcases hα k with h | h <;> rw [h] <;> norm_num
  have ht0' : 0 < t 0 := lt_of_lt_of_le (by positivity) ht0
  have tele := Hd.telescope_dissipation hh hη hα hsum t ht0' hmono B N
  have hend := (Hd.withA0 (B N)).Jbar_nonneg hh.le α hη.le (t (N + 1))
  set F : ι → ι → ℝ := fun i j => 2 * Xs kk B0 i j * Ys kk B0 i j +
    Hs kk (Hd.A 2) i j * Ys kk B0 i j + Qs kk (Hd.A 1) i j * Xs kk B0 i j
  have hF : ∀ i j, 0 ≤ F i j := fun i j => by
    have := Real.sqrt_nonneg (maxZ (zext kk fun m => ‖B0 i m‖ ^ 2) (kk j))
    have := Real.sqrt_nonneg (maxZ (zext kk fun m => ‖B0 m j‖ ^ 2) (kk i))
    have := Real.sqrt_nonneg (maxZ (zext kk fun m => ‖Hd.A 2 m i‖ ^ 2) (-kk i - kk j))
    have := Real.sqrt_nonneg (maxZ (zext kk fun m => ‖Hd.A 1 j m‖ ^ 2) (-kk i - kk j))
    simp only [F, Xs, Ys, Hs, Qs]; positivity
  have hjump : ∀ k ∈ Finset.range N, |(Hd.withA0 (B (k + 1))).Jbar α η (t (k + 1)) -
      (Hd.withA0 (B k)).Jbar α η (t (k + 1))| ≤
      3 * ((1 + √(2 / π)) * Hd.h ^ 2 * ∑ i, ∑ j, ‖B (k + 1) i j - B k i j‖ * F i j) +
        √η * Hd.jumpErr α (t (k + 1)) B0 (B k) (B (k + 1)) := by
    intro k _
    exact Hd.jump_integrated hk hu hh hη hα1 hα2 (ht0.trans (hmono (Nat.zero_le _)))
      (B k) (B (k + 1)) B0 (hB k) (hB (k + 1))
  have hsumJ : ∑ k ∈ Finset.range N, |(Hd.withA0 (B (k + 1))).Jbar α η (t (k + 1)) -
      (Hd.withA0 (B k)).Jbar α η (t (k + 1))| ≤
      3 * ((1 + √(2 / π)) * Hd.h ^ 2 *
        ∑ k ∈ Finset.range N, ∑ i, ∑ j, ‖B (k + 1) i j - B k i j‖ * F i j) +
      √η * ∑ k ∈ Finset.range N, Hd.jumpErr α (t (k + 1)) B0 (B k) (B (k + 1)) := by
    refine (Finset.sum_le_sum hjump).trans (le_of_eq ?_)
    simp only [Finset.mul_sum, Finset.sum_add_distrib]
  -- exchange the sums and use the total variation
  have hvarF : ∑ k ∈ Finset.range N, ∑ i, ∑ j, ‖B (k + 1) i j - B k i j‖ * F i j ≤
      2 * n * ∑ i, ∑ j, ‖B0 i j‖ * F i j := by
    rw [Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_le_sum fun i _ => ?_
    rw [Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_le_sum fun j _ => ?_
    rw [← Finset.sum_mul]
    have := mul_le_mul_of_nonneg_right (hvar i j) (hF i j)
    linarith
  have hHold := cross_holder (kk := kk) hk Hd.h B0 (Hd.A 1) (Hd.A 2)
  have hC0 : 0 ≤ 3 * ((1 + √(2 / π)) * Hd.h ^ 2) := by positivity
  have hmain : 3 * ((1 + √(2 / π)) * Hd.h ^ 2 *
      ∑ k ∈ Finset.range N, ∑ i, ∑ j, ‖B (k + 1) i j - B k i j‖ * F i j) ≤
      jumpConst * (2 * n) * (2 * nNorm Hd.h B0 ^ 3 + nNorm Hd.h B0 ^ 2 * nNorm Hd.h (Hd.A 2) +
        nNorm Hd.h B0 ^ 2 * nNorm Hd.h (Hd.A 1)) := by
    have h2n : 0 ≤ 2 * n := by positivity
    calc 3 * ((1 + √(2 / π)) * Hd.h ^ 2 *
          ∑ k ∈ Finset.range N, ∑ i, ∑ j, ‖B (k + 1) i j - B k i j‖ * F i j)
        ≤ 3 * ((1 + √(2 / π)) * Hd.h ^ 2 * (2 * n * ∑ i, ∑ j, ‖B0 i j‖ * F i j)) := by
          gcongr
      _ = 3 * (1 + √(2 / π)) * (2 * n) * (Hd.h ^ 2 * ∑ i, ∑ j, ‖B0 i j‖ * F i j) := by ring
      _ ≤ 3 * (1 + √(2 / π)) * (2 * n) * ((30 * √2) ^ (2 / 3 : ℝ) *
          (2 * nNorm Hd.h B0 ^ 3 + nNorm Hd.h B0 ^ 2 * nNorm Hd.h (Hd.A 2) +
            nNorm Hd.h B0 ^ 2 * nNorm Hd.h (Hd.A 1))) := by gcongr
      _ = _ := by unfold jumpConst; ring
  linarith

end HeatData

end D02Reg

section D02Limit2

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι)

/-- `J̄_η(s) → J̄_0(s)` as `η ↓ 0` (dominated convergence). -/
theorem tendsto_Jbar (hh : 0 < Hd.h) {α : Fin 3 → ℝ} (hα1 : ∀ k, 1 ≤ α k)
    (hα2 : ∀ k, α k ≤ 2) {s : ℝ} (hs : 0 < s) {η : ℕ → ℝ} (hη0 : ∀ m, 0 < η m)
    (hη1 : ∀ m, η m ≤ 1) (hlim : Tendsto η atTop (𝓝 0)) :
    Tendsto (fun m => Hd.Jbar α (η m) s) atTop (𝓝 (Hd.Jbar α 0 s)) := by
  set σ := sig α s
  have hσ : ∀ k, 0 < σ k := fun k => mul_pos (zero_lt_one.trans_le (hα1 k)) hs
  have hσr : ∀ k, σ k ∈ Set.Icc s (2 * s) := fun k => by
    constructor
    · simp only [σ, sig]; nlinarith [hα1 k]
    · simp only [σ, sig]; nlinarith [hα2 k]
  set L : Fin 3 → (Fin 3 → ℝ) → ℝ := fun v p => (Hd.T p σ v).trace.re
  set bnd : (Fin 3 → ℝ) → ℝ := fun p =>
    Gm (1 / 10) 0 s p * ∑ v, 2 * L v p * √(L v p + 1)
  have hTp : ∀ p v, (Hd.T p σ v).PosSemidef := fun p v =>
    Matrix.posSemidef_conjTranspose_mul_self _
  have hL0 : ∀ v p, 0 ≤ L v p := fun v p => re_trace_nonneg_of_posSemidef (hTp p v)
  have hG0 : ∀ p, 0 ≤ Gm (1 / 10) 0 s p := fun p => by rw [Gm_eq]; exact gaussian_nonneg' _ _
  -- integrability of the dominating function
  have hbnd : Integrable bnd := by
    obtain ⟨C₀, hC₀, hent⟩ := Hd.entry_bounds hh.le (σa := s) (σb := 2 * s) hs (by linarith)
    obtain ⟨Cg, hCg, hG⟩ := abs_Gm_le 0 (β := 1 / 10) (by norm_num) hs (sb := s)
    set N : ℝ := (Fintype.card (ι ⊕ ι) : ℝ)
    set K := 2 * N * C₀ * √(N * (4 * C₀) + 1)
    have hK : 0 ≤ K := by positivity
    set ε := min (1 / (8 * (2 * s))) (1 / (4 * (1 / 10 * s))) / 4
    have hε : 0 < ε := by positivity
    have hc : Continuous bnd := by
      have cG : Continuous fun p : Fin 3 → ℝ => Gm (1 / 10) 0 s p := by
        have : (fun p : Fin 3 → ℝ => Gm (1 / 10) 0 s p) =
            fun p => gaussian (1 / 10 * s) (p 0 + p 1 + p 2) := by funext p; rw [Gm_eq]
        rw [this]; exact (continuous_gaussian' _).comp (by fun_prop)
      have cL : ∀ v, Continuous (L v) := fun v =>
        continuous_re_trace (Hd.continuous_mats continuous_id continuous_const
          (fun _ => hσ) v).1
      exact cG.mul (continuous_finset_sum _ fun v _ => (continuous_const.mul (cL v)).mul
        (Real.continuous_sqrt.comp ((cL v).add continuous_const)))
    refine integrable_of_le_gdom hc hε (C := Cg * K * 4 * 3) fun p => ?_
    have hφ : ∀ v, L v p ≤ N * (C₀ * phi (2 * s) v p ^ 2) := fun v =>
      re_trace_le_of_entry_le _ fun a b => ((hent p σ hσr v).1 a b).1
    have hφ2 : ∀ v, phi (2 * s) v p ≤ 2 := fun v => phi_le_two (by positivity) v p
    have hterm : ∀ v, 2 * L v p * √(L v p + 1) ≤ K * phi (2 * s) v p ^ 2 := by
      intro v
      have h1 := hφ v
      have hφ0 := phi_nonneg (2 * s) v p
      have h4 : phi (2 * s) v p ^ 2 ≤ 4 := by nlinarith [hφ2 v]
      have hL4 : L v p ≤ N * (4 * C₀) := by
        have : N * (C₀ * phi (2 * s) v p ^ 2) ≤ N * (C₀ * 4) := by gcongr
        linarith
      have hs1 : √(L v p + 1) ≤ √(N * (4 * C₀) + 1) := Real.sqrt_le_sqrt (by linarith)
      calc 2 * L v p * √(L v p + 1) ≤ 2 * (N * (C₀ * phi (2 * s) v p ^ 2)) *
            √(N * (4 * C₀) + 1) := by
            gcongr
        _ = K * phi (2 * s) v p ^ 2 := by simp only [K]; ring
    have hG1 := hG s ⟨le_rfl, le_rfl⟩ p
    rw [abs_of_nonneg (hG0 p)] at hG1
    have hdec : ∀ v, phi (2 * s) v p ^ 2 *
        Real.exp (-(p 0 + p 1 + p 2) ^ 2 / (4 * (1 / 10 * s))) ≤ 4 * gdom ε p := fun v =>
      phi_sq_mul_exp_le (by positivity) (by positivity) v p
    have hsumv : ∑ v, 2 * L v p * √(L v p + 1) ≤ K * ∑ v, phi (2 * s) v p ^ 2 := by
      rw [Finset.mul_sum]; exact Finset.sum_le_sum fun v _ => hterm v
    have hE := Real.exp_pos (-(p 0 + p 1 + p 2) ^ 2 / (4 * (1 / 10 * s)))
    have hnn : 0 ≤ ∑ v, 2 * L v p * √(L v p + 1) := Finset.sum_nonneg fun v _ =>
      mul_nonneg (mul_nonneg zero_le_two (hL0 v p)) (Real.sqrt_nonneg _)
    rw [abs_of_nonneg (mul_nonneg (hG0 p) hnn)]
    calc Gm (1 / 10) 0 s p * ∑ v, 2 * L v p * √(L v p + 1)
        ≤ (Cg * Real.exp (-(p 0 + p 1 + p 2) ^ 2 / (4 * (1 / 10 * s)))) *
            (K * ∑ v, phi (2 * s) v p ^ 2) := mul_le_mul hG1 hsumv hnn (by positivity)
      _ = Cg * K * ∑ v, phi (2 * s) v p ^ 2 *
            Real.exp (-(p 0 + p 1 + p 2) ^ 2 / (4 * (1 / 10 * s))) := by
          rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
          refine Finset.sum_congr rfl fun v _ => by ring
      _ ≤ Cg * K * ∑ _v : Fin 3, 4 * gdom ε p :=
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun v _ => hdec v) (by positivity)
      _ = Cg * K * 4 * 3 * gdom ε p := by simp; ring
  refine tendsto_integral_of_dominated_convergence bnd
    (fun m => (Hd.Jbar_integrable hh (hη0 m) hα1 hα2 hs).aestronglyMeasurable) hbnd
    (fun m => Eventually.of_forall fun p => ?_) (Eventually.of_forall fun p => ?_)
  · have hnn : 0 ≤ Gm (1 / 10) 0 s p * ∑ v, Hd.qE α (η m) v s p :=
      mul_nonneg (hG0 p) (Finset.sum_nonneg fun v _ =>
        (energyReg_bounds (hTp p v) (hη0 m).le).1)
    rw [Real.norm_eq_abs, abs_of_nonneg hnn]
    refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun v _ => ?_) (hG0 p)
    have := (energyReg_bounds (hTp p v) (hη0 m).le).2
    refine this.trans ?_
    gcongr
    · exact mul_nonneg zero_le_two (hL0 v p)
    · exact hη1 m
  · refine Tendsto.const_mul _ (tendsto_finsetSum _ fun v _ => ?_)
    exact tendsto_energyReg (hTp p v).1 hlim

end HeatData

end D02Limit2

section D02Final

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι)

/-- The integrand `g_{βs}(p₀+p₁+p₂) ∑_v V_v` of the averaged row costs on `(s, p)`. -/
def costDensity (α : Fin 3 → ℝ) (η : ℝ) (z : ℝ × (Fin 3 → ℝ)) : ℝ :=
  Gm (1 / 10) 0 z.1 z.2 * ∑ v, Hd.qV α η v z.1 z.2

lemma costDensity_integrable (hh : 0 < Hd.h) {η : ℝ} (hη : 0 < η) {α : Fin 3 → ℝ}
    (hα1 : ∀ k, 1 ≤ α k) (hα2 : ∀ k, α k ≤ 2) {ta tb : ℝ} (hta : 0 < ta) (hab : ta ≤ tb) :
    Integrable (Hd.costDensity α η) ((volume.restrict (Set.Ioc ta tb)).prod volume) := by
  have e : Hd.costDensity α η = fun z => ∑ v, Gm (1 / 10) 0 z.1 z.2 * Hd.qV α η v z.1 z.2 := by
    funext z; rw [costDensity, Finset.mul_sum]
  rw [e]
  refine integrable_finsetSum _ fun v _ => ?_
  have G := Hd.family_good α η v hh hη hα1 hα2 hta hab
  exact (good_integrable (Q := fun z => Hd.qV α η v z.1 z.2) hta (by linarith : (0 : ℝ) < 2 * tb)
    (by norm_num : (0 : ℝ) < 1 / 10) v (G _ (by simp)).1 (G _ (by simp)).2 0).2

lemma costDensity_nonneg (hh : 0 ≤ Hd.h) (α : Fin 3 → ℝ) (η : ℝ) (z : ℝ × (Fin 3 → ℝ)) :
    0 ≤ Hd.costDensity α η z := by
  refine mul_nonneg ?_ (Finset.sum_nonneg fun v _ => ENNReal.toReal_nonneg)
  rw [Gm_eq]; exact gaussian_nonneg' _ _

lemma ofReal_costDensity (hh : 0 ≤ Hd.h) {η : ℝ} (hη : 0 < η) (α : Fin 3 → ℝ)
    (z : ℝ × (Fin 3 → ℝ)) :
    ENNReal.ofReal (Hd.costDensity α η z) = ENNReal.ofReal (Gm (1 / 10) 0 z.1 z.2) *
      ∑ v, matCost (Hd.T z.2 (sig α z.1) v + (η : ℂ) • 1) (Hd.Ui z.2 (sig α z.1) v) := by
  have hG : 0 ≤ Gm (1 / 10) 0 z.1 z.2 := by rw [Gm_eq]; exact gaussian_nonneg' _ _
  simp only [costDensity, qV, V]
  rw [ENNReal.ofReal_mul hG, ENNReal.ofReal_sum_of_nonneg
    (fun v _ => ENNReal.toReal_nonneg)]
  congr 1
  refine Finset.sum_congr rfl fun v _ => ?_
  exact ENNReal.ofReal_toReal (matCost_ne_top (posDef_add_smul_one
    (Matrix.posSemidef_conjTranspose_mul_self _) hη) _)

/-- The interval integral of the averaged costs as an integral of the cost density. -/
lemma integral_Vbar_eq (hh : 0 < Hd.h) {η : ℝ} (hη : 0 < η) {α : Fin 3 → ℝ}
    (hα1 : ∀ k, 1 ≤ α k) (hα2 : ∀ k, α k ≤ 2) {ta tb : ℝ} (hta : 0 < ta) (hab : ta ≤ tb) :
    ∫ s in ta..tb, ∑ v, Hd.Vbar α η v s =
      ∫ z, Hd.costDensity α η z ∂((volume.restrict (Set.Ioc ta tb)).prod volume) := by
  rw [intervalIntegral.integral_of_le hab,
    integral_prod _ (Hd.costDensity_integrable hh hη hα1 hα2 hta hab)]
  refine setIntegral_congr_fun measurableSet_Ioc fun s hs => ?_
  have hs0 : 0 < s := hta.trans hs.1
  simp only [costDensity, Vbar]
  rw [← integral_finsetSum]
  · congr 1; funext p; rw [Finset.mul_sum]
  · intro v _
    have G := Hd.family_good α η v hh hη hα1 hα2 hta hab
    exact (good_integrable (Q := fun z => Hd.qV α η v z.1 z.2) hta
      (by linarith : (0 : ℝ) < 2 * tb) (by norm_num : (0 : ℝ) < 1 / 10) v (G _ (by simp)).1
      (G _ (by simp)).2 0).1 s ⟨hs.1.le, hs.2⟩

lemma ofReal_integral_Vbar (hh : 0 < Hd.h) {η : ℝ} (hη : 0 < η) {α : Fin 3 → ℝ}
    (hα1 : ∀ k, 1 ≤ α k) (hα2 : ∀ k, α k ≤ 2) {ta tb : ℝ} (hta : 0 < ta) (hab : ta ≤ tb) :
    ENNReal.ofReal (∫ s in ta..tb, ∑ v, Hd.Vbar α η v s) =
      ∫⁻ z, ENNReal.ofReal (Gm (1 / 10) 0 z.1 z.2) *
        ∑ v, matCost (Hd.T z.2 (sig α z.1) v + (η : ℂ) • 1) (Hd.Ui z.2 (sig α z.1) v)
        ∂((volume.restrict (Set.Ioc ta tb)).prod volume) := by
  rw [Hd.integral_Vbar_eq hh hη hα1 hα2 hta hab, ofReal_integral_eq_lintegral_ofReal
    (Hd.costDensity_integrable hh hη hα1 hα2 hta hab)
    (Eventually.of_forall (Hd.costDensity_nonneg hh.le α η))]
  exact lintegral_congr fun z => Hd.ofReal_costDensity hh.le hη α z

/-- **Lemma 5.2 (node D02), integrated cost with repeated changes.** For arrays `A₀ = B_k` on
`[t_k, t_{k+1}]` (`h² ≤ t₀`), all bounded by `|B₀|` entrywise, with total variation
`∑_k |B_{k+1}(i,j) - B_k(i,j)| ≤ 2n |B₀(i,j)|`, and rates a permutation of `(1, λ, λ)`, the
unregularized averaged row costs satisfy
`∑_k ∫_{t_k}^{t_{k+1}} ∑_v V̄_v ≤ 28 (2√2 M (n₀³ + n₁³ + n₂³) + C n (2n₀³ + n₀²n₂ + n₀²n₁))`
with `M = 1 + √(2/π)`, `n₀ = n(B₀)`, `n₁ = n(A₁)`, `n₂ = n(A₂)`. -/
theorem repeated_mask_integrated_cost {kk : ι → ℤ} (hk : Function.Injective kk)
    (hu : ∀ i, Hd.u i = Hd.h * kk i) (hh : 0 < Hd.h) {α : Fin 3 → ℝ}
    (hα : ∀ k, α k = 1 ∨ α k = 11 / 10) (hsum : α 0 + α 1 + α 2 = 16 / 5) (t : ℕ → ℝ)
    (ht0 : Hd.h ^ 2 ≤ t 0) (hmono : Monotone t) (B : ℕ → Matrix ι ι ℂ) (B0 : Matrix ι ι ℂ)
    (hB : ∀ k i j, ‖B k i j‖ ≤ ‖B0 i j‖) {n : ℝ} (hn : 0 ≤ n) (N : ℕ)
    (hvar : ∀ i j, ∑ k ∈ Finset.range N, ‖B (k + 1) i j - B k i j‖ ≤ 2 * n * ‖B0 i j‖) :
    ∑ k ∈ Finset.range (N + 1), ∫⁻ z, ENNReal.ofReal (Gm (1 / 10) 0 z.1 z.2) *
        ∑ v, matCost ((Hd.withA0 (B k)).T z.2 (sig α z.1) v)
          ((Hd.withA0 (B k)).Ui z.2 (sig α z.1) v)
        ∂((volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod volume) ≤
      ENNReal.ofReal (28 * (2 * √2 * (1 + √(2 / π)) * (nNorm Hd.h B0 ^ 3 +
        nNorm Hd.h (Hd.A 1) ^ 3 + nNorm Hd.h (Hd.A 2) ^ 3) +
        jumpConst * (2 * n) * (2 * nNorm Hd.h B0 ^ 3 + nNorm Hd.h B0 ^ 2 * nNorm Hd.h (Hd.A 2) +
          nNorm Hd.h B0 ^ 2 * nNorm Hd.h (Hd.A 1)))) := by
  have hα1 : ∀ k, 1 ≤ α k := fun k => by rcases hα k with h | h <;> rw [h]; norm_num
  have hα2 : ∀ k, α k ≤ 2 := fun k => by rcases hα k with h | h <;> rw [h] <;> norm_num
  have ht0' : 0 < t 0 := lt_of_lt_of_le (by positivity) ht0
  have hpos : ∀ k, 0 < t k := fun k => ht0'.trans_le (hmono (Nat.zero_le k))
  have hstep : ∀ k, t k ≤ t (k + 1) := fun k => hmono (Nat.le_succ k)
  set η : ℕ → ℝ := fun m => 1 / ((m : ℝ) + 1)
  have hη0 : ∀ m, 0 < η m := fun m => by positivity
  have hη1 : ∀ m, η m ≤ 1 := fun m => by
    simp only [η]; rw [div_le_one (by positivity)]; linarith [(Nat.cast_nonneg m : (0 : ℝ) ≤ m)]
  have hηanti : Antitone η := fun a b hab => by
    simp only [η]; gcongr
  have hηlim : Tendsto η atTop (𝓝 0) := tendsto_one_div_add_atTop_nhds_zero_nat
  set main := jumpConst * (2 * n) * (2 * nNorm Hd.h B0 ^ 3 +
    nNorm Hd.h B0 ^ 2 * nNorm Hd.h (Hd.A 2) + nNorm Hd.h B0 ^ 2 * nNorm Hd.h (Hd.A 1))
  set E := ∑ k ∈ Finset.range N, Hd.jumpErr α (t (k + 1)) B0 (B k) (B (k + 1))
  set R : ℕ → ℝ := fun m => (Hd.withA0 (B 0)).Jbar α (η m) (t 0) + main + √(η m) * E
  -- the regularized densities
  set f : ℕ → ℕ → ℝ × (Fin 3 → ℝ) → ℝ≥0∞ := fun k m z =>
    ENNReal.ofReal (Gm (1 / 10) 0 z.1 z.2) *
      ∑ v, matCost ((Hd.withA0 (B k)).T z.2 (sig α z.1) v + (η m : ℂ) • 1)
        ((Hd.withA0 (B k)).Ui z.2 (sig α z.1) v)
  have hfmono : ∀ k z, Monotone fun m => f k m z := by
    intro k z a b hab
    refine mul_le_mul' le_rfl (Finset.sum_le_sum fun v _ => ?_)
    refine matCost_anti (P := (Hd.withA0 (B k)).T z.2 (sig α z.1) v + (η b : ℂ) • 1)
      (Q := (Hd.withA0 (B k)).T z.2 (sig α z.1) v + (η a : ℂ) • 1)
      (posDef_add_smul_one (Matrix.posSemidef_conjTranspose_mul_self _) (hη0 a)).posSemidef ?_ _
    rw [Matrix.le_iff]
    have : ((Hd.withA0 (B k)).T z.2 (sig α z.1) v + (η a : ℂ) • 1) -
        ((Hd.withA0 (B k)).T z.2 (sig α z.1) v + (η b : ℂ) • 1) =
        ((η a - η b : ℝ) : ℂ) • (1 : Matrix (ι ⊕ ι) (ι ⊕ ι) ℂ) := by
      push_cast; rw [sub_smul]; abel
    rw [this]
    exact Matrix.PosSemidef.one.smul (by exact_mod_cast sub_nonneg.2 (hηanti hab))
  -- the regularized inequality, for every `m`
  have hreg : ∀ m, (1 / 28) * ∑ k ∈ Finset.range (N + 1),
      ∫ s in t k..t (k + 1), ∑ v, (Hd.withA0 (B k)).Vbar α (η m) v s ≤ R m := fun m =>
    Hd.integrated_cost_reg hk hu hh (hη0 m) hα hsum t ht0 hmono B B0 hB hn N hvar
  have hInn : ∀ k m, 0 ≤ ∫ s in t k..t (k + 1), ∑ v, (Hd.withA0 (B k)).Vbar α (η m) v s := by
    intro k m
    refine intervalIntegral.integral_nonneg (hstep k) fun s _ => Finset.sum_nonneg fun v _ => ?_
    refine integral_nonneg fun p => mul_nonneg ?_ ENNReal.toReal_nonneg
    rw [Gm_eq]; exact gaussian_nonneg' _ _
  have hconv : ∀ k m, ∫⁻ z, f k m z ∂((volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod volume) =
      ENNReal.ofReal (∫ s in t k..t (k + 1), ∑ v, (Hd.withA0 (B k)).Vbar α (η m) v s) := fun k m =>
    ((Hd.withA0 (B k)).ofReal_integral_Vbar hh (hη0 m) hα1 hα2 (hpos k) (hstep k)).symm
  have hsum_m : ∀ m, ∑ k ∈ Finset.range (N + 1),
      ∫⁻ z, f k m z ∂((volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod volume) ≤
      ENNReal.ofReal (28 * R m) := by
    intro m
    simp only [hconv]
    rw [← ENNReal.ofReal_sum_of_nonneg fun k _ => hInn k m]
    refine ENNReal.ofReal_le_ofReal ?_
    linarith [hreg m]
  -- the limit of the right-hand sides
  have hJ0 := (Hd.withA0 (B 0)).tendsto_Jbar hh hα1 hα2 ht0' hη0 hη1 hηlim
  have hsq : Tendsto (fun m => √(η m) * E) atTop (𝓝 0) := by
    have := ((Real.continuous_sqrt.tendsto 0).comp hηlim).mul_const E
    simpa using this
  have hRlim : Tendsto R atTop (𝓝 ((Hd.withA0 (B 0)).Jbar α 0 (t 0) + main)) := by
    have := (hJ0.add_const main).add hsq
    simpa [R] using this
  have hJbound : (Hd.withA0 (B 0)).Jbar α 0 (t 0) ≤ 2 * √2 * (1 + √(2 / π)) *
      (nNorm Hd.h B0 ^ 3 + nNorm Hd.h (Hd.A 1) ^ 3 + nNorm Hd.h (Hd.A 2) ^ 3) := by
    refine ((Hd.withA0 (B 0)).Jbar_zero_le hh kk hk hu α hα1 ht0).trans ?_
    have hM : 0 ≤ 2 * √2 * (1 + √(2 / π)) := by positivity
    refine mul_le_mul_of_nonneg_left ?_ hM
    rw [Fin.sum_univ_three, nNorm_cube, nNorm_cube, nNorm_cube]
    simp only [nCube, withA0_h, withA0_A0, withA0_A1, withA0_A2]
    have : ∑ i, ∑ j, ‖B 0 i j‖ ^ 3 ≤ ∑ i, ∑ j, ‖B0 i j‖ ^ 3 :=
      Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ =>
        pow_le_pow_left₀ (norm_nonneg _) (hB 0 i j) 3
    have := mul_le_mul_of_nonneg_left this (sq_nonneg Hd.h)
    linarith
  -- monotone convergence in `m`
  have hfmeas : ∀ k m, AEMeasurable (f k m)
      ((volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod volume) := by
    intro k m
    have e : f k m = fun z => ENNReal.ofReal ((Hd.withA0 (B k)).costDensity α (η m) z) := by
      funext z; exact ((Hd.withA0 (B k)).ofReal_costDensity hh.le (hη0 m) α z).symm
    rw [e]
    exact ((Hd.withA0 (B k)).costDensity_integrable hh (hη0 m) hα1 hα2 (hpos k)
      (hstep k)).aestronglyMeasurable.aemeasurable.ennreal_ofReal
  have hpt : ∀ k z, ENNReal.ofReal (Gm (1 / 10) 0 z.1 z.2) *
      ∑ v, matCost ((Hd.withA0 (B k)).T z.2 (sig α z.1) v)
        ((Hd.withA0 (B k)).Ui z.2 (sig α z.1) v) ≤ ⨆ m, f k m z := by
    intro k z
    simp only [f]
    rw [← ENNReal.mul_iSup]
    refine mul_le_mul' le_rfl ?_
    rw [← ENNReal.finsetSum_iSup_of_monotone]
    · refine Finset.sum_le_sum fun v _ => ?_
      refine (matCost_le_liminf (Matrix.posSemidef_conjTranspose_mul_self _) _
        (fun m => (hη0 m).le) hηlim).trans ?_
      exact (liminf_le_limsup (f := atTop)).trans limsup_le_iSup
    · intro v a b hab
      have := hfmono k z hab
      simp only [f] at this
      refine matCost_anti (P := (Hd.withA0 (B k)).T z.2 (sig α z.1) v + (η b : ℂ) • 1)
        (Q := (Hd.withA0 (B k)).T z.2 (sig α z.1) v + (η a : ℂ) • 1)
        (posDef_add_smul_one (Matrix.posSemidef_conjTranspose_mul_self _) (hη0 a)).posSemidef ?_ _
      rw [Matrix.le_iff]
      have e : ((Hd.withA0 (B k)).T z.2 (sig α z.1) v + (η a : ℂ) • 1) -
          ((Hd.withA0 (B k)).T z.2 (sig α z.1) v + (η b : ℂ) • 1) =
          ((η a - η b : ℝ) : ℂ) • (1 : Matrix (ι ⊕ ι) (ι ⊕ ι) ℂ) := by
        push_cast; rw [sub_smul]; abel
      rw [e]
      exact Matrix.PosSemidef.one.smul (by exact_mod_cast sub_nonneg.2 (hηanti hab))
  have hmonoI : ∀ k, Monotone fun m => ∫⁻ z, f k m z
      ∂((volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod volume) := fun k a b hab =>
    lintegral_mono fun z => hfmono k z hab
  calc ∑ k ∈ Finset.range (N + 1), ∫⁻ z, ENNReal.ofReal (Gm (1 / 10) 0 z.1 z.2) *
        ∑ v, matCost ((Hd.withA0 (B k)).T z.2 (sig α z.1) v)
          ((Hd.withA0 (B k)).Ui z.2 (sig α z.1) v)
        ∂((volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod volume)
      ≤ ∑ k ∈ Finset.range (N + 1), ∫⁻ z, ⨆ m, f k m z
        ∂((volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod volume) :=
        Finset.sum_le_sum fun k _ => lintegral_mono fun z => hpt k z
    _ = ∑ k ∈ Finset.range (N + 1), ⨆ m, ∫⁻ z, f k m z
        ∂((volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod volume) :=
        Finset.sum_congr rfl fun k _ =>
          lintegral_iSup' (hfmeas k) (Eventually.of_forall fun z => hfmono k z)
    _ = ⨆ m, ∑ k ∈ Finset.range (N + 1), ∫⁻ z, f k m z
        ∂((volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod volume) :=
        ENNReal.finsetSum_iSup_of_monotone hmonoI
    _ ≤ ENNReal.ofReal (28 * ((Hd.withA0 (B 0)).Jbar α 0 (t 0) + main)) := by
        refine iSup_le fun m => ?_
        have hlim' : Tendsto (fun m' => ENNReal.ofReal (28 * R m')) atTop
            (𝓝 (ENNReal.ofReal (28 * ((Hd.withA0 (B 0)).Jbar α 0 (t 0) + main)))) :=
          (ENNReal.continuous_ofReal.tendsto _).comp (hRlim.const_mul 28)
        refine ge_of_tendsto hlim' ?_
        filter_upwards [eventually_ge_atTop m] with m' hm'
        refine le_trans ?_ (hsum_m m')
        exact Finset.sum_le_sum fun k _ => hmonoI k hm'
    _ ≤ _ := by
        refine ENNReal.ofReal_le_ofReal ?_
        linarith

end HeatData

end D02Final

/-! ### Lemma 5.3: uniform bounds for the inserted multipliers -/

section D03Ratio

lemma poly_exp_bound (d : ℕ) {ε : ℝ} (hε : 0 < ε) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ y : ℝ, (1 + |y|) ^ d * Real.exp (-ε * y ^ 2) ≤ B := by
  set K := max 1 (√(2 * ε))⁻¹
  have hK : 1 ≤ K := le_max_left _ _
  have hs : 0 < √(2 * ε) := Real.sqrt_pos.2 (by positivity)
  refine ⟨K ^ d * (d.factorial * Real.exp 2), by positivity, fun y => ?_⟩
  set z := √(2 * ε) * y
  have hzy : 1 + |y| ≤ K * (1 + |z|) := by
    have : |y| = (√(2 * ε))⁻¹ * |z| := by
      rw [abs_mul, abs_of_pos hs, ← mul_assoc, inv_mul_cancel₀ hs.ne', one_mul]
    rw [this]
    have h1 : (√(2 * ε))⁻¹ ≤ K := le_max_right _ _
    nlinarith [abs_nonneg z]
  have hez : Real.exp (-ε * y ^ 2) = gaussProfile z := by
    unfold gaussProfile; congr 1
    simp only [z]; rw [mul_pow, Real.sq_sqrt (by positivity)]; ring
  rw [hez]
  calc (1 + |y|) ^ d * gaussProfile z ≤ (K * (1 + |z|)) ^ d * gaussProfile z :=
        mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) hzy d)
          (gaussProfile_pos z).le
    _ = K ^ d * ((1 + |z|) ^ d * gaussProfile z) := by rw [mul_pow]; ring
    _ ≤ K ^ d * (d.factorial * Real.exp 2 * Real.exp (-(z ^ 2) / 4)) :=
        mul_le_mul_of_nonneg_left (one_add_abs_pow_mul_gaussProfile_le d z) (by positivity)
    _ ≤ K ^ d * (d.factorial * Real.exp 2 * 1) := by
        gcongr; rw [Real.exp_le_one_iff]; have := sq_nonneg z; linarith
    _ = _ := by ring

/-- **Ratio bound (Lemma 5.3):** for `0 < q < l` there is `C` with
`(√s)^d |g_{qs}^{(d)}(x)| ≤ C g_{ls}(x)` for all `s > 0` and `x`. -/
theorem gaussianD_ratio_le (d : ℕ) {q l : ℝ} (hq : 0 < q) (hql : q < l) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℝ, 0 < s → ∀ x : ℝ,
      √s ^ d * |gaussianD d (q * s) x| ≤ C * gaussian (l * s) x := by
  have hl : 0 < l := hq.trans hql
  obtain ⟨C0, hC0, hprof⟩ := abs_gaussProfileD_le d
  set ε := (1 - q / l) / 2
  have hε : 0 < ε := by
    have : q / l < 1 := (div_lt_one hl).2 hql
    simp only [ε]; linarith
  obtain ⟨B, hB0, hB⟩ := poly_exp_bound d hε
  have hsq : 0 < √q := Real.sqrt_pos.2 hq
  have hsl : 0 < √l := Real.sqrt_pos.2 hl
  refine ⟨(√q)⁻¹ ^ (d + 1) * C0 * B * √l, by positivity, fun s hs x => ?_⟩
  have hss : 0 < √s := Real.sqrt_pos.2 hs
  have h2π : 0 < √(2 * π) := Real.sqrt_pos.2 (by positivity)
  set y := (√(q * s))⁻¹ * x
  have hqs : √(q * s) = √q * √s := Real.sqrt_mul hq.le s
  rw [gaussianD_eq_profile d (by positivity), abs_mul, abs_mul,
    abs_of_pos (by positivity : (0 : ℝ) < (√(2 * π))⁻¹),
    abs_of_pos (by positivity : (0 : ℝ) < (√(q * s))⁻¹ ^ (d + 1))]
  have hp := hprof y
  have hφ : gaussProfile y = Real.exp (-(q / l) * y ^ 2 / 2) * Real.exp (-ε * y ^ 2) := by
    unfold gaussProfile; rw [← Real.exp_add]; congr 1; simp only [ε]; ring
  have hx : Real.exp (-(x ^ 2) / (2 * (l * s))) = Real.exp (-(q / l) * y ^ 2 / 2) := by
    congr 1
    simp only [y]
    rw [mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
    field_simp
  have hg : gaussian (l * s) x = (√(2 * π))⁻¹ * (√l)⁻¹ * (√s)⁻¹ *
      Real.exp (-(q / l) * y ^ 2 / 2) := by
    unfold gaussian
    rw [hx, show 2 * π * (l * s) = (2 * π) * l * s by ring, Real.sqrt_mul (by positivity),
      Real.sqrt_mul (by positivity)]
    rw [mul_inv, mul_inv]
  have hpow : √s ^ d * (√(q * s))⁻¹ ^ (d + 1) = (√q)⁻¹ ^ (d + 1) * (√s)⁻¹ := by
    rw [hqs, mul_inv, mul_pow, pow_succ (√s)⁻¹, inv_pow (√s) d]
    field_simp
  have hE := Real.exp_pos (-(q / l) * y ^ 2 / 2)
  calc √s ^ d * ((√(2 * π))⁻¹ * (√(q * s))⁻¹ ^ (d + 1) * |gaussProfileD d y|)
      = (√(2 * π))⁻¹ * (√s ^ d * (√(q * s))⁻¹ ^ (d + 1)) * |gaussProfileD d y| := by ring
    _ ≤ (√(2 * π))⁻¹ * (√s ^ d * (√(q * s))⁻¹ ^ (d + 1)) *
          (C0 * (1 + |y|) ^ d * gaussProfile y) := by gcongr
    _ = (√(2 * π))⁻¹ * ((√q)⁻¹ ^ (d + 1) * (√s)⁻¹) * C0 *
          ((1 + |y|) ^ d * Real.exp (-ε * y ^ 2)) * Real.exp (-(q / l) * y ^ 2 / 2) := by
        rw [hpow, hφ]; ring
    _ ≤ (√(2 * π))⁻¹ * ((√q)⁻¹ ^ (d + 1) * (√s)⁻¹) * C0 * B *
          Real.exp (-(q / l) * y ^ 2 / 2) := by gcongr; exact hB y
    _ = (√q)⁻¹ ^ (d + 1) * C0 * B * √l * gaussian (l * s) x := by
        rw [hg]; field_simp

end D03Ratio

/-! ### §5.2: the masks -/

section Masks

/-- A list of at most `n` disjoint open scale intervals `(a_ℓ, b_ℓ) ⊆ [s₋, s₊]` with complex
coefficients of modulus at most one (one such list at each pair `(i,j)`). -/
structure IntervalList (n : ℕ) (sm sp : ℝ) where
  len : ℕ
  a : ℕ → ℝ
  b : ℕ → ℝ
  c : ℕ → ℂ
  len_le : len ≤ n
  lt : ∀ ℓ < len, a ℓ < b ℓ
  disj : ∀ ℓ < len, ∀ ℓ' < len, ℓ ≠ ℓ' → Disjoint (Set.Ioo (a ℓ) (b ℓ)) (Set.Ioo (a ℓ') (b ℓ'))
  norm_c : ∀ ℓ, ‖c ℓ‖ ≤ 1
  range : ∀ ℓ < len, sm ≤ a ℓ ∧ b ℓ ≤ sp

namespace IntervalList

variable {n : ℕ} {sm sp : ℝ} (L : IntervalList n sm sp)

/-- The mask `m(s) = ∑_ℓ c_ℓ 1_{(a_ℓ, b_ℓ)}(s)`. -/
def mval (s : ℝ) : ℂ := ∑ ℓ ∈ Finset.range L.len, (Set.Ioo (L.a ℓ) (L.b ℓ)).indicator (fun _ => L.c ℓ) s

lemma norm_mval_le (s : ℝ) : ‖L.mval s‖ ≤ 1 := by
  classical
  by_cases h : ∃ ℓ ∈ Finset.range L.len, s ∈ Set.Ioo (L.a ℓ) (L.b ℓ)
  · obtain ⟨ℓ, hℓ, hs⟩ := h
    rw [mval, Finset.sum_eq_single ℓ]
    · rw [Set.indicator_of_mem hs]; exact L.norm_c ℓ
    · intro ℓ' hℓ' hne
      refine Set.indicator_of_notMem (fun hs' => ?_) _
      exact Set.disjoint_left.1 (L.disj ℓ' (Finset.mem_range.1 hℓ') ℓ (Finset.mem_range.1 hℓ)
        hne) hs' hs
    · intro h; exact absurd hℓ h
  · push Not at h
    rw [mval, Finset.sum_eq_zero fun ℓ hℓ => Set.indicator_of_notMem (h ℓ hℓ) _]
    simp

end IntervalList

/-- An indicator of an open interval changes at most twice along an increasing sequence. -/
lemma sum_indicator_change_le {x : ℕ → ℝ} (hx : StrictMono x) (a b : ℝ) (N : ℕ) :
    ∑ k ∈ Finset.range N, |(Set.Ioo a b).indicator (fun _ => (1 : ℝ)) (x (k + 1)) -
      (Set.Ioo a b).indicator (fun _ => (1 : ℝ)) (x k)| ≤ 2 := by
  classical
  set I := Set.Ioo a b
  set f : ℕ → ℝ := fun k => |I.indicator (fun _ => (1 : ℝ)) (x (k + 1)) -
    I.indicator (fun _ => (1 : ℝ)) (x k)|
  -- the changes are entries (`x k ≤ a < x (k+1)`) or exits (`x k < b ≤ x (k+1)`)
  set En := (Finset.range N).filter fun k => x k ≤ a ∧ a < x (k + 1)
  set Ex := (Finset.range N).filter fun k => x k < b ∧ b ≤ x (k + 1)
  have hsub : ∀ k ∈ Finset.range N, f k ≠ 0 → k ∈ En ∪ Ex := by
    intro k hk hf
    simp only [f, I] at hf
    simp only [En, Ex, Finset.mem_union, Finset.mem_filter]
    by_cases h1 : x (k + 1) ∈ Set.Ioo a b <;> by_cases h0 : x k ∈ Set.Ioo a b
    · simp [Set.indicator_of_mem h1, Set.indicator_of_mem h0] at hf
    · left; refine ⟨hk, ?_, h1.1⟩
      by_contra hc; push Not at hc
      exact h0 ⟨hc, (hx (Nat.lt_succ_self k)).trans h1.2⟩
    · right; refine ⟨hk, h0.2, ?_⟩
      by_contra hc; push Not at hc
      exact h1 ⟨h0.1.trans (hx (Nat.lt_succ_self k)), hc⟩
    · simp [Set.indicator_of_notMem h1, Set.indicator_of_notMem h0] at hf
  have hle1 : ∀ k, f k ≤ 1 := by
    intro k
    simp only [f]
    rw [abs_le]
    constructor <;> by_cases h1 : x (k + 1) ∈ I <;> by_cases h0 : x k ∈ I <;>
      simp [Set.indicator_of_mem, Set.indicator_of_notMem, h1, h0]
  have hEn : En.card ≤ 1 := by
    refine Finset.card_le_one.2 fun k hk k' hk' => ?_
    simp only [En, Finset.mem_filter] at hk hk'
    by_contra hne
    rcases lt_or_gt_of_ne hne with h | h
    · have := hx.monotone (Nat.succ_le_of_lt h)
      linarith [hk.2.2, hk'.2.1]
    · have := hx.monotone (Nat.succ_le_of_lt h)
      linarith [hk.2.1, hk'.2.2]
  have hEx : Ex.card ≤ 1 := by
    refine Finset.card_le_one.2 fun k hk k' hk' => ?_
    simp only [Ex, Finset.mem_filter] at hk hk'
    by_contra hne
    rcases lt_or_gt_of_ne hne with h | h
    · have := hx.monotone (Nat.succ_le_of_lt h)
      linarith [hk.2.2, hk'.2.1]
    · have := hx.monotone (Nat.succ_le_of_lt h)
      linarith [hk.2.1, hk'.2.2]
  calc ∑ k ∈ Finset.range N, f k = ∑ k ∈ (Finset.range N).filter (fun k => f k ≠ 0), f k := by
        rw [Finset.sum_filter_ne_zero]
    _ ≤ ∑ k ∈ En ∪ Ex, f k := by
        refine Finset.sum_le_sum_of_subset_of_nonneg (fun k hk => ?_) fun k _ _ => abs_nonneg _
        simp only [Finset.mem_filter] at hk
        exact hsub k hk.1 hk.2
    _ ≤ ∑ _k ∈ En ∪ Ex, (1 : ℝ) := Finset.sum_le_sum fun k _ => hle1 k
    _ = (En ∪ Ex).card := by simp
    _ ≤ En.card + Ex.card := by exact_mod_cast Finset.card_union_le _ _
    _ ≤ 2 := by
        have : ((En.card : ℕ) : ℝ) ≤ 1 := by exact_mod_cast hEn
        have : ((Ex.card : ℕ) : ℝ) ≤ 1 := by exact_mod_cast hEx
        linarith

namespace IntervalList

variable {n : ℕ} {sm sp : ℝ} (L : IntervalList n sm sp)

/-- **Total variation of a mask (§5.2):** along increasing parameters the mask changes by at
most `2n` in total. -/
lemma sum_mval_change_le {x : ℕ → ℝ} (hx : StrictMono x) (N : ℕ) :
    ∑ k ∈ Finset.range N, ‖L.mval (x (k + 1)) - L.mval (x k)‖ ≤ 2 * n := by
  have hterm : ∀ k, ‖L.mval (x (k + 1)) - L.mval (x k)‖ ≤ ∑ ℓ ∈ Finset.range L.len,
      |(Set.Ioo (L.a ℓ) (L.b ℓ)).indicator (fun _ => (1 : ℝ)) (x (k + 1)) -
        (Set.Ioo (L.a ℓ) (L.b ℓ)).indicator (fun _ => (1 : ℝ)) (x k)| := by
    intro k
    rw [mval, mval, ← Finset.sum_sub_distrib]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun ℓ _ => ?_)
    have hc := L.norm_c ℓ
    by_cases h1 : x (k + 1) ∈ Set.Ioo (L.a ℓ) (L.b ℓ) <;>
      by_cases h0 : x k ∈ Set.Ioo (L.a ℓ) (L.b ℓ) <;>
      simp [Set.indicator_of_mem, Set.indicator_of_notMem, h1, h0, hc]
  calc ∑ k ∈ Finset.range N, ‖L.mval (x (k + 1)) - L.mval (x k)‖
      ≤ ∑ k ∈ Finset.range N, ∑ ℓ ∈ Finset.range L.len,
          |(Set.Ioo (L.a ℓ) (L.b ℓ)).indicator (fun _ => (1 : ℝ)) (x (k + 1)) -
            (Set.Ioo (L.a ℓ) (L.b ℓ)).indicator (fun _ => (1 : ℝ)) (x k)| :=
        Finset.sum_le_sum fun k _ => hterm k
    _ = ∑ ℓ ∈ Finset.range L.len, ∑ k ∈ Finset.range N,
          |(Set.Ioo (L.a ℓ) (L.b ℓ)).indicator (fun _ => (1 : ℝ)) (x (k + 1)) -
            (Set.Ioo (L.a ℓ) (L.b ℓ)).indicator (fun _ => (1 : ℝ)) (x k)| := Finset.sum_comm
    _ ≤ ∑ _ℓ ∈ Finset.range L.len, (2 : ℝ) :=
        Finset.sum_le_sum fun ℓ _ => sum_indicator_change_le hx _ _ N
    _ = 2 * L.len := by simp; ring
    _ ≤ 2 * n := by gcongr; exact_mod_cast L.len_le

end IntervalList

end Masks

section SwitchPartition

/-- **The switch scales:** a finite set `E ⊆ [s₋, s₊]` containing `s₋ < s₊` is the range of a
strictly increasing finite sequence `s₋ = t₀ < t₁ < ⋯ < t_{N+1} = s₊`; between consecutive
elements no point of `E` lies. -/
lemma exists_switch_partition (E : Finset ℝ) {sm sp : ℝ} (hsm : sm ∈ E) (hsp : sp ∈ E)
    (hlt : sm < sp) (hE : ∀ e ∈ E, sm ≤ e ∧ e ≤ sp) :
    ∃ (N : ℕ) (t : ℕ → ℝ), Monotone t ∧ t 0 = sm ∧ t (N + 1) = sp ∧
      (∀ k ≤ N, t k < t (k + 1)) ∧
      (∀ e ∈ E, ∀ k ≤ N, ∀ y ∈ Set.Ioo (t k) (t (k + 1)),
        (e < y ↔ e ≤ t k) ∧ (y < e ↔ t (k + 1) ≤ e)) := by
  classical
  set K := E.card
  have hK2 : 2 ≤ K := by
    have : ({sm, sp} : Finset ℝ) ⊆ E := by
      intro x hx; simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl <;> assumption
    have := Finset.card_le_card this
    rw [Finset.card_pair hlt.ne] at this
    exact this
  set emb := E.orderEmbOfFin (rfl : E.card = K)
  set t : ℕ → ℝ := fun k => if h : k < K then emb ⟨k, h⟩ else sp
  have hK0 : 0 < K := by omega
  have hmax : ∀ k (h : k < K), emb ⟨k, h⟩ ≤ sp := fun k h =>
    (hE _ (Finset.orderEmbOfFin_mem E rfl _)).2
  have hmono : Monotone t := by
    intro k k' hkk'
    simp only [t]
    split_ifs with h1 h2 h2
    · exact emb.monotone (Fin.mk_le_mk.2 hkk')
    · exact hmax k h1
    · omega
    · exact le_rfl
  have ht0 : t 0 = sm := by
    simp only [t, dif_pos hK0]
    rw [Finset.orderEmbOfFin_zero rfl hK0]
    exact le_antisymm (Finset.min'_le _ _ hsm)
      ((hE _ (Finset.min'_mem _ _)).1)
  refine ⟨K - 2, t, hmono, ht0, ?_, ?_, ?_⟩
  · have : K - 2 + 1 = K - 1 := by omega
    simp only [t, this, dif_pos (by omega : K - 1 < K)]
    rw [Finset.orderEmbOfFin_last rfl hK0]
    exact le_antisymm ((hE _ (Finset.max'_mem _ _)).2) (Finset.le_max' _ _ hsp)
  · intro k hk
    have h1 : k < K := by omega
    have h2 : k + 1 < K := by omega
    simp only [t, dif_pos h1, dif_pos h2]
    exact emb.strictMono (Fin.mk_lt_mk.2 (Nat.lt_succ_self k))
  · intro e he k hk y hy
    have h1 : k < K := by omega
    have h2 : k + 1 < K := by omega
    obtain ⟨⟨j, hj⟩, rfl⟩ : e ∈ Set.range emb := by
      rw [Finset.range_orderEmbOfFin]; exact he
    have htk : t k = emb ⟨k, h1⟩ := by simp only [t, dif_pos h1]
    have htk1 : t (k + 1) = emb ⟨k + 1, h2⟩ := by simp only [t, dif_pos h2]
    rw [htk, htk1] at hy ⊢
    rcases le_or_gt j k with hjk | hjk
    · have : emb ⟨j, hj⟩ ≤ emb ⟨k, h1⟩ := emb.monotone (Fin.mk_le_mk.2 hjk)
      constructor
      · exact ⟨fun _ => this, fun _ => this.trans_lt hy.1⟩
      · constructor
        · intro h; exact absurd (this.trans_lt hy.1) (not_lt.2 h.le)
        · intro h; exact absurd (h.trans this) (not_le.2 (emb.strictMono
            (Fin.mk_lt_mk.2 (Nat.lt_succ_self k))))
    · have : emb ⟨k + 1, h2⟩ ≤ emb ⟨j, hj⟩ := emb.monotone (Fin.mk_le_mk.2 hjk)
      constructor
      · constructor
        · intro h; exact absurd (h.trans (hy.2.trans_le this)) (lt_irrefl _)
        · intro h
          exact absurd (lt_of_lt_of_le (emb.strictMono (Fin.mk_lt_mk.2 (Nat.lt_succ_self k)))
            this) (not_lt.2 h)
      · exact ⟨fun _ => this, fun _ => hy.2.trans_le this⟩

/-- Membership in an interval with endpoints in `E` is constant on each gap. -/
lemma mem_Ioo_iff_of_gap {E : Finset ℝ} {t : ℕ → ℝ} {k : ℕ}
    (hgap : ∀ e ∈ E, ∀ y ∈ Set.Ioo (t k) (t (k + 1)), (e < y ↔ e ≤ t k) ∧ (y < e ↔ t (k + 1) ≤ e))
    {a b : ℝ} (ha : a ∈ E) (hb : b ∈ E) {y y' : ℝ} (hy : y ∈ Set.Ioo (t k) (t (k + 1)))
    (hy' : y' ∈ Set.Ioo (t k) (t (k + 1))) : y ∈ Set.Ioo a b ↔ y' ∈ Set.Ioo a b := by
  simp only [Set.mem_Ioo]
  rw [(hgap a ha y hy).1, (hgap a ha y' hy').1, (hgap b hb y hy).2, (hgap b hb y' hy').2]

end SwitchPartition

section MaskedD02

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The masked array `A^s(i,j) = A(i,j) m_{ij}(s)`. -/
def maskA {n : ℕ} {sm sp : ℝ} (A : Matrix ι ι ℂ) (M : ι → ι → IntervalList n sm sp) (s : ℝ) :
    Matrix ι ι ℂ := fun i j => A i j * (M i j).mval s

/-- The switch scales of a family of masks. -/
def switchSet {n : ℕ} {sm sp : ℝ} (M : ι → ι → IntervalList n sm sp) : Finset ℝ :=
  {sm, sp} ∪ Finset.univ.biUnion fun z : ι × ι =>
    (Finset.range (M z.1 z.2).len).biUnion fun ℓ => {(M z.1 z.2).a ℓ, (M z.1 z.2).b ℓ}

lemma restrict_Ioc_prod_eq_sum {β : Type*} [MeasurableSpace β] (ν : Measure β) [SFinite ν]
    {t : ℕ → ℝ} (ht : Monotone t) (N : ℕ) :
    (volume.restrict (Set.Ioc (t 0) (t (N + 1)))).prod ν =
      ∑ k ∈ Finset.range (N + 1), (volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod ν := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ, ← ih, ← Measure.add_prod,
      ← Measure.restrict_union (Set.Ioc_disjoint_Ioc_of_le le_rfl) measurableSet_Ioc,
      Set.Ioc_union_Ioc_eq_Ioc (ht (Nat.zero_le _)) (ht (Nat.le_succ _))]

lemma ae_prod_mem_Ioo {β : Type*} [MeasurableSpace β] (ν : Measure β) [SFinite ν] {a b : ℝ} :
    ∀ᵐ z ∂((volume.restrict (Set.Ioc a b)).prod ν), z.1 ∈ Set.Ioo a b := by
  have h1 : ∀ᵐ s ∂(volume.restrict (Set.Ioc a b)), s ∈ Set.Ioo a b := by
    have hb : ∀ᵐ s ∂(volume : Measure ℝ), s ∉ ({b} : Set ℝ) :=
      measure_eq_zero_iff_ae_notMem.1 Real.volume_singleton
    filter_upwards [ae_restrict_mem measurableSet_Ioc, ae_restrict_of_ae hb] with s hs hsb
    exact ⟨hs.1, lt_of_le_of_ne hs.2 (by simpa using hsb)⟩
  exact Measure.quasiMeasurePreserving_fst.ae h1

namespace HeatData

variable (Hd : HeatData ι)

/-- The integrand of the averaged row costs (unregularized). -/
def costIntegrand (α : Fin 3 → ℝ) (A : Matrix ι ι ℂ) (z : ℝ × (Fin 3 → ℝ)) : ℝ≥0∞ :=
  ENNReal.ofReal (Gm (1 / 10) 0 z.1 z.2) *
    ∑ v, matCost ((Hd.withA0 A).T z.2 (sig α z.1) v) ((Hd.withA0 A).Ui z.2 (sig α z.1) v)

/-- **Lemma 5.2 for the masked arrays of §5.2.** -/
theorem masked_integrated_cost {kk : ι → ℤ} (hk : Function.Injective kk)
    (hu : ∀ i, Hd.u i = Hd.h * kk i) (hh : 0 < Hd.h) {α : Fin 3 → ℝ}
    (hα : ∀ k, α k = 1 ∨ α k = 11 / 10) (hsum : α 0 + α 1 + α 2 = 16 / 5) {n : ℕ} {sm sp : ℝ}
    (hsm : Hd.h ^ 2 ≤ sm) (hlt : sm < sp) (M : ι → ι → IntervalList n sm sp) :
    ∫⁻ z, Hd.costIntegrand α (maskA (Hd.A 0) M z.1) z
        ∂((volume.restrict (Set.Ioc sm sp)).prod volume) ≤
      ENNReal.ofReal (28 * (2 * √2 * (1 + √(2 / π)) * (nNorm Hd.h (Hd.A 0) ^ 3 +
        nNorm Hd.h (Hd.A 1) ^ 3 + nNorm Hd.h (Hd.A 2) ^ 3) +
        jumpConst * (2 * n) * (2 * nNorm Hd.h (Hd.A 0) ^ 3 +
          nNorm Hd.h (Hd.A 0) ^ 2 * nNorm Hd.h (Hd.A 2) +
          nNorm Hd.h (Hd.A 0) ^ 2 * nNorm Hd.h (Hd.A 1)))) := by
  classical
  have hmemE : ∀ (i j : ι) (ℓ : ℕ), ℓ < (M i j).len →
      (M i j).a ℓ ∈ switchSet M ∧ (M i j).b ℓ ∈ switchSet M := by
    intro i j ℓ hℓ
    constructor <;> refine Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨(i, j),
      Finset.mem_univ _, Finset.mem_biUnion.2 ⟨ℓ, Finset.mem_range.2 hℓ, by simp⟩⟩)
  have hEbd : ∀ e ∈ switchSet M, sm ≤ e ∧ e ≤ sp := by
    intro e he
    simp only [switchSet, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
      Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_range] at he
    rcases he with (rfl | rfl) | ⟨z, ℓ, hℓ, rfl | rfl⟩
    · exact ⟨le_rfl, hlt.le⟩
    · exact ⟨hlt.le, le_rfl⟩
    · have := (M z.1 z.2).range ℓ hℓ
      exact ⟨this.1, ((M z.1 z.2).lt ℓ hℓ).le.trans this.2⟩
    · have := (M z.1 z.2).range ℓ hℓ
      exact ⟨this.1.trans ((M z.1 z.2).lt ℓ hℓ).le, this.2⟩
  obtain ⟨N, t, hmono, ht0, htN, hstrict, hgap⟩ := exists_switch_partition (switchSet M)
    (by simp [switchSet]) (by simp [switchSet]) hlt hEbd
  set mid : ℕ → ℝ := fun k => (t k + t (k + 1)) / 2
  have hmid : ∀ k ≤ N, mid k ∈ Set.Ioo (t k) (t (k + 1)) := fun k hk => by
    have := hstrict k hk
    simp only [mid, Set.mem_Ioo]; constructor <;> linarith
  set B : ℕ → Matrix ι ι ℂ := fun k => maskA (Hd.A 0) M (mid k)
  have hB : ∀ k i j, ‖B k i j‖ ≤ ‖Hd.A 0 i j‖ := fun k i j => by
    simp only [B, maskA, norm_mul]
    exact mul_le_of_le_one_right (norm_nonneg _) ((M i j).norm_mval_le _)
  -- the total variation
  set x : ℕ → ℝ := fun k => if k ≤ N then mid k else sp + k
  have hxmono : StrictMono x := by
    refine strictMono_nat_of_lt_succ fun k => ?_
    simp only [x]
    by_cases h1 : k + 1 ≤ N
    · rw [if_pos h1, if_pos (by omega)]
      have := hstrict k (by omega)
      have := hstrict (k + 1) h1
      simp only [mid]; linarith
    · rw [if_neg h1]
      by_cases h2 : k ≤ N
      · rw [if_pos h2]
        have hkN : k = N := by omega
        have := (hmid k h2).2
        rw [hkN] at this ⊢
        rw [htN] at this
        have : (0 : ℝ) ≤ ((N + 1 : ℕ) : ℝ) := Nat.cast_nonneg _
        push_cast at this ⊢
        linarith
      · rw [if_neg h2]; push_cast; linarith
  have hvar : ∀ i j, ∑ k ∈ Finset.range N, ‖B (k + 1) i j - B k i j‖ ≤
      2 * (n : ℝ) * ‖Hd.A 0 i j‖ := by
    intro i j
    have hx : ∀ k ∈ Finset.range N, ‖B (k + 1) i j - B k i j‖ =
        ‖Hd.A 0 i j‖ * ‖(M i j).mval (x (k + 1)) - (M i j).mval (x k)‖ := by
      intro k hk
      have hk' : k < N := Finset.mem_range.1 hk
      simp only [B, maskA, x, if_pos (show k + 1 ≤ N by omega), if_pos (show k ≤ N by omega)]
      rw [← mul_sub, norm_mul]
    rw [Finset.sum_congr rfl hx, ← Finset.mul_sum]
    have := (M i j).sum_mval_change_le hxmono N
    rw [mul_comm]
    exact mul_le_mul_of_nonneg_right this (norm_nonneg _)
  have hD02 := Hd.repeated_mask_integrated_cost hk hu hh hα hsum t (ht0 ▸ hsm) hmono B (Hd.A 0)
    hB (Nat.cast_nonneg n) N hvar
  -- decompose the scale integral along the switches
  rw [show Set.Ioc sm sp = Set.Ioc (t 0) (t (N + 1)) by rw [ht0, htN],
    restrict_Ioc_prod_eq_sum volume hmono N, lintegral_finset_sum_measure]
  refine le_trans (le_of_eq (Finset.sum_congr rfl fun k hk => ?_)) hD02
  have hkN : k ≤ N := Nat.lt_succ_iff.1 (Finset.mem_range.1 hk)
  refine lintegral_congr_ae ?_
  filter_upwards [ae_prod_mem_Ioo volume] with z hz
  have hA : maskA (Hd.A 0) M z.1 = B k := by
    funext i j
    simp only [B, maskA, IntervalList.mval]
    congr 1
    refine Finset.sum_congr rfl fun ℓ hℓ => ?_
    have hℓ' := Finset.mem_range.1 hℓ
    obtain ⟨ha, hb⟩ := hmemE i j ℓ hℓ'
    by_cases hz' : z.1 ∈ Set.Ioo ((M i j).a ℓ) ((M i j).b ℓ)
    · have hm := (mem_Ioo_iff_of_gap (hgap · · k hkN) ha hb hz (hmid k hkN)).1 hz'
      rw [Set.indicator_of_mem hz', Set.indicator_of_mem hm]
    · have hm : mid k ∉ Set.Ioo ((M i j).a ℓ) ((M i j).b ℓ) := fun hm =>
        hz' ((mem_Ioo_iff_of_gap (hgap · · k hkN) ha hb hz (hmid k hkN)).2 hm)
      rw [Set.indicator_of_notMem hz', Set.indicator_of_notMem hm]
  simp only [costIntegrand, hA]

end HeatData

end MaskedD02

/-! ### Lemma 5.3: the trace identity -/

section D03Trace

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

lemma trace_mul_three (X Y Z : Matrix ι ι ℂ) :
    (X * Y * Z).trace = ∑ i, ∑ j, ∑ k, X i j * Y j k * Z k i := by
  simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply, Finset.sum_mul]
  rw [Finset.sum_congr rfl fun i _ => Finset.sum_comm]

/-- The cyclic trace with diagonal insertions and square-root weights:
`tr(diag(x₀) W₀ diag(x₁) W₁ diag(x₂) W₂) = ∑ B₀(i,j) B₁(j,k) B₂(k,i) (x₀r₀²)(i) (x₁r₁²)(j) (x₂r₂²)(k)`
for `W₀ = diag(r₀) B₀ diag(r₁)`, `W₁ = diag(r₁) B₁ diag(r₂)`, `W₂ = diag(r₂) B₂ diag(r₀)`. -/
lemma trace_cyclic_diag (x₀ x₁ x₂ r₀ r₁ r₂ : ι → ℝ) (B₀ B₁ B₂ : Matrix ι ι ℂ) :
    (rdiag x₀ * (rdiag r₀ * B₀ * rdiag r₁) * rdiag x₁ * (rdiag r₁ * B₁ * rdiag r₂) *
        rdiag x₂ * (rdiag r₂ * B₂ * rdiag r₀)).trace =
      ∑ i, ∑ j, ∑ k, B₀ i j * B₁ j k * B₂ k i *
        ((x₀ i * r₀ i ^ 2 : ℝ) * (x₁ j * r₁ j ^ 2 : ℝ) * (x₂ k * r₂ k ^ 2 : ℝ) : ℝ) := by
  have e : rdiag x₀ * (rdiag r₀ * B₀ * rdiag r₁) * rdiag x₁ * (rdiag r₁ * B₁ * rdiag r₂) *
      rdiag x₂ * (rdiag r₂ * B₂ * rdiag r₀) =
      (rdiag x₀ * (rdiag r₀ * B₀ * rdiag r₁)) * (rdiag x₁ * (rdiag r₁ * B₁ * rdiag r₂)) *
        (rdiag x₂ * (rdiag r₂ * B₂ * rdiag r₀)) := by
    simp only [Matrix.mul_assoc]
  rw [e, trace_mul_three]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ =>
    Finset.sum_congr rfl fun k _ => ?_
  simp only [rdiag, Matrix.diagonal_mul, Matrix.mul_diagonal]
  push_cast; ring

/-- The plane parametrization `(q₀, q₁) ↦ (q₀, q₁, -q₀-q₁)` of `Π₀`. -/
def planePt (q : Fin 2 → ℝ) : Fin 3 → ℝ := ![q 0, q 1, -q 0 - q 1]

lemma integral_fin2 {F : (Fin 2 → ℝ) → ℂ} (hF : Integrable F) :
    ∫ q, F q = ∫ x, ∫ y, F ![x, y] := by
  have h2 := (volume_preserving_finTwoArrow ℝ).symm
  rw [← h2.integral_comp' (g := F), Measure.volume_eq_prod, integral_prod]
  · refine integral_congr_ae (Eventually.of_forall fun x => integral_congr_ae
      (Eventually.of_forall fun y => ?_))
    show F (MeasurableEquiv.finTwoArrow.symm (x, y)) = F ![x, y]
    congr 1
  · exact (h2.integrable_comp_emb MeasurableEquiv.finTwoArrow.symm.measurableEmbedding).2 hF

lemma integrable_fin2_prod {f g : ℝ → ℝ} (hf : Integrable f) (hg : Integrable g) :
    Integrable (fun q : Fin 2 → ℝ => f (q 0) * g (q 1)) := by
  have := Integrable.fintype_prod (f := ![f, g]) (μ := fun _ : Fin 2 => (volume : Measure ℝ))
    (fun i => by fin_cases i; exacts [hf, hg])
  simp only [Fin.prod_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one] at this
  exact this

/-- **The plane convolution (Lemma 5.3):**
`∫_{Π₀} g_σ^{(d₀)}(c₀ - p₀) g_σ^{(d₁)}(c₁ - p₁) g_σ^{(d₂)}(c₂ - p₂) dπ₀ = g_{3σ}^{(d₀+d₁+d₂)}(c₀+c₁+c₂)`. -/
theorem plane_gaussD_three (d₀ d₁ d₂ : ℕ) {σ : ℝ} (hσ : 0 < σ) (c₀ c₁ c₂ : ℝ) :
    Integrable (fun q : Fin 2 → ℝ => ((gaussianD d₀ σ (c₀ - q 0) * gaussianD d₁ σ (c₁ - q 1) *
      gaussianD d₂ σ (c₂ + q 0 + q 1) : ℝ) : ℂ)) ∧
    ∫ q : Fin 2 → ℝ, ((gaussianD d₀ σ (c₀ - q 0) * gaussianD d₁ σ (c₁ - q 1) *
      gaussianD d₂ σ (c₂ + q 0 + q 1) : ℝ) : ℂ) =
      (gaussianD (d₂ + d₁ + d₀) (σ + σ + σ) (c₀ + c₁ + c₂) : ℂ) := by
  obtain ⟨M, hM⟩ := abs_gaussianD_le_const d₂ hσ
  have h0 : Integrable (fun x => gaussianD d₀ σ (c₀ - x)) :=
    (integrable_gaussianD d₀ hσ).comp_sub_left c₀
  have h1 : Integrable (fun x => gaussianD d₁ σ (c₁ - x)) :=
    (integrable_gaussianD d₁ hσ).comp_sub_left c₁
  have hcont : Continuous (fun q : Fin 2 → ℝ => gaussianD d₀ σ (c₀ - q 0) *
      gaussianD d₁ σ (c₁ - q 1) * gaussianD d₂ σ (c₂ + q 0 + q 1)) := by
    have := continuous_gaussianD d₀ σ
    have := continuous_gaussianD d₁ σ
    have := continuous_gaussianD d₂ σ
    fun_prop
  have hI : Integrable (fun q : Fin 2 → ℝ => gaussianD d₀ σ (c₀ - q 0) *
      gaussianD d₁ σ (c₁ - q 1) * gaussianD d₂ σ (c₂ + q 0 + q 1)) := by
    refine ((integrable_fin2_prod h0 h1).norm.const_mul M).mono' hcont.aestronglyMeasurable
      (Eventually.of_forall fun q => ?_)
    rw [Real.norm_eq_abs, abs_mul, Real.norm_eq_abs, abs_mul]
    have := hM (c₂ + q 0 + q 1)
    have := abs_nonneg (gaussianD d₀ σ (c₀ - q 0))
    have := abs_nonneg (gaussianD d₁ σ (c₁ - q 1))
    nlinarith [mul_nonneg (abs_nonneg (gaussianD d₀ σ (c₀ - q 0)))
      (abs_nonneg (gaussianD d₁ σ (c₁ - q 1)))]
  refine ⟨hI.ofReal, ?_⟩
  rw [integral_complex_ofReal]
  congr 1
  -- iterated integration
  have hfin : ∫ q : Fin 2 → ℝ, gaussianD d₀ σ (c₀ - q 0) * gaussianD d₁ σ (c₁ - q 1) *
      gaussianD d₂ σ (c₂ + q 0 + q 1) = ∫ x, ∫ y, gaussianD d₀ σ (c₀ - x) *
        gaussianD d₁ σ (c₁ - y) * gaussianD d₂ σ (c₂ + x + y) := by
    have h2 := (volume_preserving_finTwoArrow ℝ).symm
    rw [← h2.integral_comp' (g := fun q : Fin 2 → ℝ => gaussianD d₀ σ (c₀ - q 0) *
      gaussianD d₁ σ (c₁ - q 1) * gaussianD d₂ σ (c₂ + q 0 + q 1)), Measure.volume_eq_prod,
      integral_prod]
    · rfl
    · exact (h2.integrable_comp_emb MeasurableEquiv.finTwoArrow.symm.measurableEmbedding).2 hI
  rw [hfin]
  have inner : ∀ x, ∫ y, gaussianD d₀ σ (c₀ - x) * gaussianD d₁ σ (c₁ - y) *
      gaussianD d₂ σ (c₂ + x + y) =
      gaussianD d₀ σ (c₀ - x) * gaussianD (d₂ + d₁) (σ + σ) (c₂ + x + c₁) := by
    intro x
    rw [← gaussianD_conv_gaussianD d₂ d₁ hσ hσ, ← integral_const_mul]
    rw [← integral_sub_left_eq_self (fun d => gaussianD d₀ σ (c₀ - x) *
      (gaussianD d₂ σ (c₂ + x + c₁ - d) * gaussianD d₁ σ d)) volume c₁]
    congr 1; funext y
    rw [show c₂ + x + c₁ - (c₁ - y) = c₂ + x + y by ring]; ring
  simp_rw [inner]
  rw [← gaussianD_conv_gaussianD (d₂ + d₁) d₀ (by positivity : 0 < σ + σ) hσ,
    ← integral_sub_left_eq_self (fun d => gaussianD (d₂ + d₁) (σ + σ) (c₀ + c₁ + c₂ - d) *
      gaussianD d₀ σ d) volume c₀]
  congr 1; funext x
  rw [show c₀ + c₁ + c₂ - (c₀ - x) = c₂ + x + c₁ by ring]; ring

end D03Trace

/-! ### Lemma 5.3: the multipliers -/

section D03Mult

/-- The derivative order `d_v` at vertex `v`: `(1,1,1)` for `m = 3` and `(2,1,1)` for `m = 4`. -/
def dexp (m : ℕ) (v : Fin 3) : ℕ := if v = 0 ∧ m = 4 then 2 else 1

lemma dexp_sum {m : ℕ} (hm : m = 3 ∨ m = 4) : dexp m 2 + dexp m 1 + dexp m 0 = m := by
  rcases hm with rfl | rfl <;> simp [dexp]

lemma dexp_pos (m : ℕ) (v : Fin 3) : 1 ≤ dexp m v := by unfold dexp; split_ifs <;> norm_num

lemma dexp_le (m : ℕ) (v : Fin 3) : dexp m v ≤ 2 := by unfold dexp; split_ifs <;> norm_num

/-- The diagonal insertion `D_v(i) = s^{d/2} g_{qs}^{(d)}(x) / g_{λs}(x)`, `x = u_i - p_v`
(`q = 21/20`, `λ = 11/10`). -/
def Dfun (d : ℕ) (s x : ℝ) : ℝ :=
  √s ^ d * gaussianD d (21 / 20 * s) x / gaussian (11 / 10 * s) x

/-- The coefficient `a_{j,s}(d) = -s^{j/2} g_{γs}^{(j-1)}(d) / g_{βs}(d)` (`γ = 1/20`, `β = 1/10`). -/
def acoef (j : ℕ) (s d : ℝ) : ℝ :=
  -(√s ^ j * gaussianD (j - 1) (1 / 20 * s) d / gaussian (1 / 10 * s) d)

lemma gaussian_pos {σ : ℝ} (hσ : 0 < σ) (t : ℝ) : 0 < gaussian σ t := by
  unfold gaussian
  have : 0 < √(2 * π * σ) := Real.sqrt_pos.2 (by positivity)
  positivity

/-- **`‖D_v‖_op ≤ C` uniformly** (since `q < λ`). -/
lemma Dfun_bound (d : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ s, 0 < s → ∀ x, |Dfun d s x| ≤ C := by
  obtain ⟨C, hC, h⟩ := gaussianD_ratio_le d (q := 21 / 20) (l := 11 / 10) (by norm_num)
    (by norm_num)
  refine ⟨C, hC, fun s hs x => ?_⟩
  have hg := gaussian_pos (by positivity : (0 : ℝ) < 11 / 10 * s) x
  rw [Dfun, abs_div, abs_of_pos hg, abs_mul, abs_of_nonneg (pow_nonneg (Real.sqrt_nonneg _) _),
    div_le_iff₀ hg]
  exact h s hs x

/-- **`|a_{j,s}(d)| ≤ C √s`** (since `γ < β`). -/
lemma acoef_bound (j : ℕ) (hj : 1 ≤ j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ s, 0 < s → ∀ d, |acoef j s d| ≤ C * √s := by
  obtain ⟨C, hC, h⟩ := gaussianD_ratio_le (j - 1) (q := 1 / 20) (l := 1 / 10) (by norm_num)
    (by norm_num)
  refine ⟨C, hC, fun s hs d => ?_⟩
  have hg := gaussian_pos (by positivity : (0 : ℝ) < 1 / 10 * s) d
  rw [acoef, abs_neg, abs_div, abs_of_pos hg, abs_mul,
    abs_of_nonneg (pow_nonneg (Real.sqrt_nonneg _) _), div_le_iff₀ hg]
  have hj' : j = (j - 1) + 1 := by omega
  rw [hj', pow_succ]
  have := h s hs d
  have hs' := Real.sqrt_nonneg s
  calc √s ^ (j - 1) * √s * |gaussianD (j - 1 + 1 - 1) (1 / 20 * s) d|
      = √s * (√s ^ (j - 1) * |gaussianD (j - 1) (1 / 20 * s) d|) := by
        rw [show j - 1 + 1 - 1 = j - 1 by omega]; ring
    _ ≤ √s * (C * gaussian (1 / 10 * s) d) := mul_le_mul_of_nonneg_left this hs'
    _ = _ := by ring

end D03Mult

/-! ### Lemma 5.3: the cost at one vertex by averaging (Lemma 3.3) -/

section D03Avg

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The averaging measure `g_{βs}(d) dd` (a probability measure). -/
def avgMeasure (s : ℝ) : Measure ℝ :=
  volume.withDensity fun d => ((gaussian (1 / 10 * s) d).toNNReal : ℝ≥0∞)

lemma measurable_gaussian_toNNReal (τ : ℝ) :
    Measurable fun d => (gaussian τ d).toNNReal :=
  (continuous_gaussian' τ).measurable.real_toNNReal

instance avgMeasure_prob {s : ℝ} [Fact (0 < s)] : IsProbabilityMeasure (avgMeasure s) := by
  have hs : 0 < s := Fact.out
  constructor
  rw [avgMeasure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  have : ∫⁻ d, ((gaussian (1 / 10 * s) d).toNNReal : ℝ≥0∞) =
      ENNReal.ofReal (∫ d, gaussian (1 / 10 * s) d) := by
    rw [ofReal_integral_eq_lintegral_ofReal (integrable_gaussian' (by positivity))
      (Eventually.of_forall fun d => gaussian_nonneg' _ _)]
    rfl
  rw [this, integral_gaussian_eq_one (by positivity), ENNReal.ofReal_one]

lemma integral_avgMeasure (s : ℝ) (f : ℝ → ℂ) :
    ∫ d, f d ∂(avgMeasure s) = ∫ d, (gaussian (1 / 10 * s) d : ℂ) * f d := by
  rw [avgMeasure, integral_withDensity_eq_integral_smul (measurable_gaussian_toNNReal _)]
  refine integral_congr_ae (Eventually.of_forall fun d => ?_)
  simp only [NNReal.smul_def, Real.coe_toNNReal _ (gaussian_nonneg' _ _), Complex.real_smul]

lemma integrable_avgMeasure_iff (s : ℝ) (f : ℝ → ℂ) :
    Integrable f (avgMeasure s) ↔ Integrable (fun d => (gaussian (1 / 10 * s) d : ℂ) * f d) := by
  rw [avgMeasure, integrable_withDensity_iff_integrable_smul (measurable_gaussian_toNNReal _)]
  constructor <;> intro h <;> refine h.congr (Eventually.of_forall fun d => ?_) <;>
    simp [NNReal.smul_def, Real.coe_toNNReal _ (gaussian_nonneg' _ _), Complex.real_smul]

lemma lintegral_avgMeasure (s : ℝ) (F : ℝ → ℝ≥0∞) :
    ∫⁻ d, F d ∂(avgMeasure s) = ∫⁻ d, ENNReal.ofReal (gaussian (1 / 10 * s) d) * F d := by
  rw [avgMeasure, lintegral_withDensity_eq_lintegral_mul_non_measurable _
    (measurable_gaussian_toNNReal _).coe_nnreal_ennreal
    (Eventually.of_forall fun d => ENNReal.coe_lt_top)]
  rfl

/-- `matCost P (c • K) ≤ c² matCost P K` for every real `c`. -/
lemma matCost_smul_le {n : Type*} [Fintype n] [DecidableEq n] (P K : Matrix n n ℂ) (c : ℝ) :
    matCost P ((c : ℂ) • K) ≤ ENNReal.ofReal (c ^ 2) * matCost P K := by
  by_cases hc : c = 0
  · subst hc
    simp only [Complex.ofReal_zero, zero_smul]
    refine le_trans (iSup_le fun X => ?_) (zero_le (a := ENNReal.ofReal (0 ^ 2) * matCost P K))
    refine (ENNReal.ofReal_eq_zero.2 ?_).le
    have hA : (CFC.sqrt P - ((0 : ℝ) : ℂ) • (1 : Matrix n n ℂ)).PosSemidef := by
      simpa using (CFC.sqrt_nonneg P).posSemidef
    have h := sylvester_lower hA hA X
    rw [hsRe_add_right] at h
    simp only [costInt, hsRe, Matrix.conjTranspose_zero, Matrix.zero_mul, Matrix.trace_zero,
      Complex.zero_re, mul_zero, zero_sub] at h ⊢
    nlinarith [hsSq_nonneg X]
  · have e : (c : ℂ) • K = c • K := by ext i j; simp [Complex.real_smul]
    rw [e, matCost_smul P K hc]

end D03Avg

section D03Avg2

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

lemma integral_avgMeasure_real (s : ℝ) (f : ℝ → ℝ) :
    ∫ d, f d ∂(avgMeasure s) = ∫ d, gaussian (1 / 10 * s) d * f d := by
  rw [avgMeasure, integral_withDensity_eq_integral_smul (measurable_gaussian_toNNReal _)]
  refine integral_congr_ae (Eventually.of_forall fun d => ?_)
  simp only [NNReal.smul_def, Real.coe_toNNReal _ (gaussian_nonneg' _ _), smul_eq_mul]

lemma integrable_avgMeasure_real (s : ℝ) {f : ℝ → ℝ}
    (hf : Integrable (fun d => gaussian (1 / 10 * s) d * f d)) : Integrable f (avgMeasure s) := by
  rw [avgMeasure, integrable_withDensity_iff_integrable_smul (measurable_gaussian_toNNReal _)]
  refine hf.congr (Eventually.of_forall fun d => ?_)
  simp only [NNReal.smul_def, Real.coe_toNNReal _ (gaussian_nonneg' _ _), smul_eq_mul]

/-- Averages of weighted Grams. -/
lemma matIntegral_wGram {κ : Type*} [Fintype κ] {ν : Measure ℝ} (B : Matrix ι κ ℂ)
    (f : ℝ → ι → ℝ) (hf : ∀ i, Integrable (fun d => f d i) ν) :
    (∀ a b, Integrable (fun d => wGram B (f d) a b) ν) ∧
    matIntegral ν (fun d => wGram B (f d)) = wGram B (fun i => ∫ d, f d i ∂ν) := by
  have hc : ∀ a b i, Integrable (fun d => star (B i a) * (f d i : ℂ) * B i b) ν := fun a b i =>
    (((hf i).ofReal).const_mul (star (B i a))).mul_const (B i b)
  refine ⟨fun a b => ?_, ?_⟩
  · simp_rw [wGram_apply]
    exact integrable_finsetSum _ fun i _ => hc a b i
  · ext a b
    rw [matIntegral_apply, wGram_apply]
    simp_rw [wGram_apply]
    rw [integral_finsetSum _ fun i _ => hc a b i]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [integral_mul_const, integral_const_mul, integral_complex_ofReal]

namespace HeatData

variable (Hd : HeatData ι)

omit [Fintype ι] [DecidableEq ι] in
lemma w_update2 (p σ : Fin 3 → ℝ) (v : Fin 3) (q τ : ℝ) :
    Hd.w (Function.update p v q) (Function.update σ v τ) v = gweight Hd.u Hd.h τ q := by
  simp [w]

lemma Brow_update2 (p σ : Fin 3 → ℝ) (v : Fin 3) (q τ : ℝ) :
    Hd.Brow (Function.update p v q) (Function.update σ v τ) v = Hd.Brow p σ v := by
  rw [Brow_update, Brow_update_σ]

omit [Fintype ι] [DecidableEq ι] in
lemma dw_update2 (p σ : Fin 3 → ℝ) (v : Fin 3) (q τ : ℝ) :
    Hd.dw (Function.update p v q) (Function.update σ v τ) v =
      fun i => -(Hd.h * gaussianD 1 τ (Hd.u i - q)) := by
  rw [dw_def]; simp

/-- `Rᴴ diag(D) R = Browᴴ diag(w D) Brow`. -/
lemma R_insert_eq (hh : 0 ≤ Hd.h) (p σ : Fin 3 → ℝ) (v : Fin 3) (D : ι → ℝ) (hσ : 0 < σ v) :
    (Hd.R p σ v)ᴴ * rdiag D * Hd.R p σ v =
      wGram (Hd.Brow p σ v) (fun i => Hd.w p σ v i * D i) := by
  rw [R_eq, wGram, Brow]
  have hw : (fun i => Hd.w p σ v i * D i) = Hd.sqw p σ v * D * Hd.sqw p σ v := by
    funext i
    simp only [Pi.mul_apply]
    rw [← Hd.sq_mul_sq p σ hh hσ]; simp only [Pi.mul_apply]; ring
  rw [hw, ← rdiag_mul_rdiag, ← rdiag_mul_rdiag]
  simp only [Matrix.conjTranspose_mul, rdiag_conjTranspose, Matrix.mul_assoc]

/-- **The cost at one vertex (proof of Lemma 5.3):** with base variances `λs` at all vertices,
`b_{T_v}(R_vᴴ D_v R_v) ≤ C² s ∫ g_{βs}(d) b_{T_v^d}(U_v^d) dd`, where `T_v^d, U_v^d` have row
variance `s` and row center `p_v + d` (Lemma 3.3 and `R_vᴴ D_v R_v = ∫ a_{j,s}(d) U_v^d g_{βs}`). -/
theorem vertex_avg (hh : 0 < Hd.h) (v : Fin 3) {j : ℕ} (hj : 1 ≤ j) {Ca : ℝ}
    (hCa : ∀ s, 0 < s → ∀ d, |acoef j s d| ≤ Ca * √s) (p : Fin 3 → ℝ) {s : ℝ} (hs : 0 < s) :
    matCost (Hd.T p (fun _ => 11 / 10 * s) v)
      ((Hd.R p (fun _ => 11 / 10 * s) v)ᴴ * rdiag (fun i => Dfun j s (Hd.u i - p v)) *
        Hd.R p (fun _ => 11 / 10 * s) v) ≤
      ENNReal.ofReal (Ca ^ 2 * s) * ∫⁻ d, ENNReal.ofReal (gaussian (1 / 10 * s) d) *
        matCost (Hd.T (Function.update p v (p v + d)) (Function.update (fun _ => 11 / 10 * s) v s) v)
          (Hd.Ui (Function.update p v (p v + d)) (Function.update (fun _ => 11 / 10 * s) v s) v) := by
  haveI : Fact (0 < s) := ⟨hs⟩
  set σB : Fin 3 → ℝ := fun _ => 11 / 10 * s
  have hσB : ∀ k, 0 < σB k := fun k => by simp only [σB]; positivity
  set σV := Function.update σB v s
  have hσV : ∀ k, 0 < σV k := fun k => by
    simp only [σV, Function.update_apply]; split_ifs; exacts [hs, hσB k]
  set Bw := Hd.Brow p σB v
  set ν := avgMeasure s
  have hβ : (0 : ℝ) < 1 / 10 * s := by positivity
  -- the two weight families
  set fT : ℝ → ι → ℝ := fun d i => gweight Hd.u Hd.h s (p v + d) i
  set fK : ℝ → ι → ℝ := fun d i => acoef j s d * -(Hd.h * gaussianD 1 s (Hd.u i - (p v + d)))
  have hT : ∀ d, Hd.T (Function.update p v (p v + d)) σV v = wGram Bw (fT d) := fun d => by
    rw [T_eq_wGram Hd _ _ hh.le (hσV v), Brow_update2, w_update2]
  have hK : ∀ d, ((acoef j s d : ℝ) : ℂ) • Hd.Ui (Function.update p v (p v + d)) σV v =
      wGram Bw (fK d) := fun d => by
    rw [Ui, Brow_update2, dw_update2, ← wGram_smul]
    congr 1
  -- integrability and the averages of the weights
  have hfT : ∀ i, Integrable (fun d => fT d i) ν := by
    intro i
    refine integrable_avgMeasure_real s ?_
    exact (integrable_gaussian' hβ).mul_bdd (c := Hd.h * (√(2 * π * s))⁻¹)
      ((continuous_const.mul ((continuous_gaussian' s).comp
        (continuous_const.sub (continuous_const.add continuous_id)))).aestronglyMeasurable)
      (Eventually.of_forall fun d => by
        rw [Real.norm_eq_abs, abs_of_nonneg (gweight_nonneg' _ hh.le _ _ _)]
        exact mul_le_mul_of_nonneg_left (gaussian_le_sup _ _) hh.le)
  have hgK : ∀ d, gaussian (1 / 10 * s) d * acoef j s d =
      -(√s ^ j * gaussianD (j - 1) (1 / 20 * s) d) := fun d => by
    have hne := (gaussian_pos hβ d).ne'
    simp only [acoef]
    rw [mul_neg, mul_div_assoc', mul_comm (gaussian (1 / 10 * s) d), mul_div_assoc,
      div_self hne, mul_one]
  have hfK : ∀ i, Integrable (fun d => fK d i) ν := by
    intro i
    refine integrable_avgMeasure_real s ?_
    obtain ⟨M, hM⟩ := abs_gaussianD_le_const 1 hs
    have h1 : Integrable (fun d => -(√s ^ j * gaussianD (j - 1) (1 / 20 * s) d)) :=
      ((integrable_gaussianD (j - 1) (by positivity)).const_mul _).neg
    have hc1 : Continuous fun d => -(Hd.h * gaussianD 1 s (Hd.u i - (p v + d))) := by
      have := continuous_gaussianD 1 s
      fun_prop
    have := h1.mul_bdd (c := Hd.h * M) hc1.aestronglyMeasurable
      (Eventually.of_forall fun d => by
        show ‖-(Hd.h * gaussianD 1 s (Hd.u i - (p v + d)))‖ ≤ _
        rw [Real.norm_eq_abs, abs_neg, abs_mul, abs_of_pos hh]
        exact mul_le_mul_of_nonneg_left (hM _) hh.le)
    refine this.congr (Eventually.of_forall fun d => ?_)
    show -(√s ^ j * gaussianD (j - 1) (1 / 20 * s) d) *
      -(Hd.h * gaussianD 1 s (Hd.u i - (p v + d))) = gaussian (1 / 10 * s) d * fK d i
    simp only [fK]; rw [← mul_assoc, hgK]
  have hIT : ∀ i, ∫ d, fT d i ∂ν = Hd.w p σB v i := by
    intro i
    rw [integral_avgMeasure_real]
    simp only [fT, gweight, w, σB]
    have := gaussian_conv_gaussian hs hβ (Hd.u i - p v)
    rw [show s + 1 / 10 * s = 11 / 10 * s by ring] at this
    rw [← this, ← integral_const_mul]
    congr 1; funext d
    rw [show Hd.u i - (p v + d) = Hd.u i - p v - d by ring]; ring
  have hIK : ∀ i, ∫ d, fK d i ∂ν = Hd.w p σB v i * Dfun j s (Hd.u i - p v) := by
    intro i
    rw [integral_avgMeasure_real]
    have e : ∀ d, gaussian (1 / 10 * s) d * fK d i = Hd.h * √s ^ j *
        (gaussianD 1 s (Hd.u i - p v - d) * gaussianD (j - 1) (1 / 20 * s) d) := fun d => by
      simp only [fK]
      rw [← mul_assoc, hgK, show Hd.u i - (p v + d) = Hd.u i - p v - d by ring]; ring
    simp_rw [e]
    rw [integral_const_mul, gaussianD_conv_gaussianD 1 (j - 1) hs (by positivity),
      show 1 + (j - 1) = j by omega, show s + 1 / 20 * s = 21 / 20 * s by ring]
    have hg := (gaussian_pos (by positivity : (0 : ℝ) < 11 / 10 * s) (Hd.u i - p v)).ne'
    simp only [w, gweight, σB, Dfun]
    rw [show Hd.h * gaussian (11 / 10 * s) (Hd.u i - p v) *
        (√s ^ j * gaussianD j (21 / 20 * s) (Hd.u i - p v) / gaussian (11 / 10 * s) (Hd.u i - p v)) =
        Hd.h * (gaussian (11 / 10 * s) (Hd.u i - p v) *
          (√s ^ j * gaussianD j (21 / 20 * s) (Hd.u i - p v)) /
            gaussian (11 / 10 * s) (Hd.u i - p v)) by ring, mul_div_cancel_left₀ _ hg]
    ring
  obtain ⟨iT, mT⟩ := matIntegral_wGram (ν := ν) Bw fT hfT
  obtain ⟨iK, mK⟩ := matIntegral_wGram (ν := ν) Bw fK hfK
  -- the averaged identities
  have hTavg : matIntegral ν (fun d => wGram Bw (fT d)) = Hd.T p σB v := by
    rw [mT, T_eq_wGram Hd p σB hh.le (hσB v)]
    simp_rw [hIT]
    rfl
  have hKavg : matIntegral ν (fun d => wGram Bw (fK d)) =
      (Hd.R p σB v)ᴴ * rdiag (fun i => Dfun j s (Hd.u i - p v)) * Hd.R p σB v := by
    rw [mK, R_insert_eq Hd hh.le p σB v _ (hσB v)]
    simp_rw [hIK]
    rfl
  -- Lemma 3.3
  have hTm : Measurable fun d => wGram Bw (fT d) := by
    have : Continuous fun d => wGram Bw (fT d) := continuous_wGram continuous_const fun i =>
      continuous_const.mul ((continuous_gaussian' s).comp
        (continuous_const.sub (continuous_const.add continuous_id)))
    exact this.measurable
  have hTpsd : ∀ d, (wGram Bw (fT d)).PosSemidef := fun d =>
    wGram_posSemidef _ fun i => gweight_nonneg' _ hh.le _ _ _
  have h03 := matCost_average_le hTm hTpsd iT iK
  rw [hTavg, hKavg] at h03
  refine h03.trans ?_
  rw [lintegral_avgMeasure, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun d => ?_
  rw [← hT d, ← hK d]
  have hc := matCost_smul_le (Hd.T (Function.update p v (p v + d)) σV v)
    (Hd.Ui (Function.update p v (p v + d)) σV v) (acoef j s d)
  have ha2 : acoef j s d ^ 2 ≤ Ca ^ 2 * s := by
    have := hCa s hs d
    have h0 := abs_nonneg (acoef j s d)
    rw [← sq_abs]
    calc |acoef j s d| ^ 2 ≤ (Ca * √s) ^ 2 := pow_le_pow_left₀ h0 this 2
      _ = Ca ^ 2 * s := by rw [mul_pow, Real.sq_sqrt hs.le]
  calc ENNReal.ofReal (gaussian (1 / 10 * s) d) *
        matCost (Hd.T (Function.update p v (p v + d)) σV v)
          (((acoef j s d : ℝ) : ℂ) • Hd.Ui (Function.update p v (p v + d)) σV v)
      ≤ ENNReal.ofReal (gaussian (1 / 10 * s) d) * (ENNReal.ofReal (acoef j s d ^ 2) *
          matCost (Hd.T (Function.update p v (p v + d)) σV v)
            (Hd.Ui (Function.update p v (p v + d)) σV v)) := mul_le_mul' le_rfl hc
    _ ≤ ENNReal.ofReal (gaussian (1 / 10 * s) d) * (ENNReal.ofReal (Ca ^ 2 * s) *
          matCost (Hd.T (Function.update p v (p v + d)) σV v)
            (Hd.Ui (Function.update p v (p v + d)) σV v)) :=
        mul_le_mul' le_rfl (mul_le_mul' (ENNReal.ofReal_le_ofReal ha2) le_rfl)
    _ = _ := by ring

end HeatData

end D03Avg2

/-! ### Lemma 5.3: measurability of the costs and the change of variables -/

section D03Change

/-- The unregularized cost as the supremum of the regularized ones. -/
lemma matCost_eq_iSup {n : Type*} [Fintype n] [DecidableEq n] {P : Matrix n n ℂ}
    (hP : P.PosSemidef) (K : Matrix n n ℂ) :
    matCost P K = ⨆ m : ℕ, matCost (P + ((1 / ((m : ℝ) + 1) : ℝ) : ℂ) • 1) K := by
  refine le_antisymm ?_ (iSup_le fun m => ?_)
  · refine (matCost_le_liminf hP K (η := fun m : ℕ => 1 / ((m : ℝ) + 1)) (fun m => by positivity)
      tendsto_one_div_add_atTop_nhds_zero_nat).trans ?_
    exact (liminf_le_limsup (f := atTop)).trans limsup_le_iSup
  · refine matCost_anti (posDef_add_smul_one hP (by positivity)).posSemidef ?_ K
    rw [Matrix.le_iff, add_sub_cancel_left]
    exact Matrix.PosSemidef.one.smul (by exact_mod_cast (by positivity : (0 : ℝ) ≤ 1 / ((m : ℝ) + 1)))

/-- The matrix of the change of variables `(q₀, q₁, d) ↦ (q₀, q₁, -q₀-q₁) + d e_v`. -/
def shiftMat (v : Fin 3) : Matrix (Fin 3) (Fin 3) ℝ := fun r c =>
  if c = 2 then (if r = v then 1 else 0) else (if r = 2 then -1 else if r = c then 1 else 0)

lemma shiftMat_mulVec (v : Fin 3) (x : Fin 3 → ℝ) :
    shiftMat v *ᵥ x = Function.update (planePt ![x 0, x 1]) v (planePt ![x 0, x 1] v + x 2) := by
  ext r
  fin_cases v <;> fin_cases r <;>
    simp [shiftMat, Matrix.mulVec, dotProduct, Fin.sum_univ_three, planePt,
      Function.update_apply] <;> ring

lemma det_shiftMat (v : Fin 3) : (shiftMat v).det = 1 := by
  fin_cases v <;> simp [Matrix.det_fin_three, shiftMat]

lemma sum_shift (v : Fin 3) (q : Fin 2 → ℝ) (d : ℝ) :
    Function.update (planePt q) v (planePt q v + d) 0 +
      Function.update (planePt q) v (planePt q v + d) 1 +
      Function.update (planePt q) v (planePt q v + d) 2 = d := by
  fin_cases v <;> simp [planePt, Function.update_apply] <;> ring

/-- **Change of variables (proof of Lemma 5.3):** integrating `F(p + d e_v)` over the base plane
`Π₀` (coordinates `p₀, p₁`) and over `d` is integrating `F` over `ℝ³`. -/
theorem lintegral_plane_shift (v : Fin 3) {F : (Fin 3 → ℝ) → ℝ≥0∞} (hF : Measurable F) :
    ∫⁻ q : Fin 2 → ℝ, ∫⁻ d, F (Function.update (planePt q) v (planePt q v + d)) =
      ∫⁻ p, F p := by
  set L := Matrix.toLin' (shiftMat v)
  have hdet : (shiftMat v).det ≠ 0 := by rw [det_shiftMat]; norm_num
  have hmap : Measure.map L volume = (volume : Measure (Fin 3 → ℝ)) := by
    rw [Real.map_matrix_volume_pi_eq_smul_volume_pi hdet, det_shiftMat]; simp
  have hLm : Measurable L := (LinearMap.continuous_on_pi L).measurable
  rw [← hmap, lintegral_map hF hLm]
  simp only [L, Matrix.toLin'_apply, shiftMat_mulVec]
  -- split the last coordinate
  set e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 2
  have hmp : MeasurePreserving e.symm ((volume : Measure ℝ).prod (volume : Measure (Fin 2 → ℝ)))
      volume := (volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 2).symm
  set G : (Fin 3 → ℝ) → ℝ≥0∞ := fun x =>
    F (Function.update (planePt ![x 0, x 1]) v (planePt ![x 0, x 1] v + x 2))
  have hG : Measurable G := by
    refine hF.comp ?_
    have : (fun x : Fin 3 → ℝ => Function.update (planePt ![x 0, x 1]) v
        (planePt ![x 0, x 1] v + x 2)) = fun x => shiftMat v *ᵥ x := by
      funext x; rw [shiftMat_mulVec]
    rw [this]
    exact (Matrix.toLin' (shiftMat v)).continuous_on_pi.measurable
  show ∫⁻ q : Fin 2 → ℝ, ∫⁻ d, F (Function.update (planePt q) v (planePt q v + d)) = ∫⁻ x, G x
  rw [← hmp.lintegral_comp hG,
    lintegral_prod_symm (fun z => G (e.symm z)) (hG.comp e.symm.measurable).aemeasurable]
  refine lintegral_congr fun q => lintegral_congr fun d => ?_
  simp only [G, Function.comp_apply]
  have h0 : e.symm (d, q) 0 = q 0 := rfl
  have h1 : e.symm (d, q) 1 = q 1 := rfl
  have h2 : e.symm (d, q) 2 = d := rfl
  rw [h0, h1, h2]
  congr 3 <;> (congr 1; ext i; fin_cases i <;> rfl)

end D03Change

section D03Trace2

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι)

/-- The insertion `D_v = diag(D_v(i))` at vertex `v`. -/
def Dmat (m : ℕ) (v : Fin 3) (p : Fin 3 → ℝ) (s : ℝ) : Matrix ι ι ℂ :=
  rdiag fun i => Dfun (dexp m v) s (Hd.u i - p v)

/-- The base trace `tr(D₀W₀D₁W₁D₂W₂)` with variances `λs` at all vertices. -/
def baseTrace (m : ℕ) (p : Fin 3 → ℝ) (s : ℝ) : ℂ :=
  (Hd.Dmat m 0 p s * Hd.W p (fun _ => 11 / 10 * s) 0 * Hd.Dmat m 1 p s *
    Hd.W p (fun _ => 11 / 10 * s) 1 * Hd.Dmat m 2 p s * Hd.W p (fun _ => 11 / 10 * s) 2).trace

lemma Dfun_mul_w (hh : 0 ≤ Hd.h) (d : ℕ) {s : ℝ} (hs : 0 < s) (p : Fin 3 → ℝ) (v : Fin 3)
    (i : ι) :
    Dfun d s (Hd.u i - p v) * Hd.sqw p (fun _ => 11 / 10 * s) v i ^ 2 =
      Hd.h * (√s ^ d * gaussianD d (21 / 20 * s) (Hd.u i - p v)) := by
  rw [show Hd.sqw p (fun _ => 11 / 10 * s) v i ^ 2 = Hd.w p (fun _ => 11 / 10 * s) v i from
    Real.sq_sqrt (gweight_nonneg' _ hh _ _ _)]
  have hg := (gaussian_pos (by positivity : (0 : ℝ) < 11 / 10 * s) (Hd.u i - p v)).ne'
  simp only [w, gweight, Dfun]
  rw [div_mul_eq_mul_div, div_eq_iff hg]; ring

/-- **The trace identity (Lemma 5.3):**
`tr(D₀W₀D₁W₁D₂W₂) = h³ s^{m/2} ∑ A₀(i,j) A₁(j,k) A₂(k,i) ∏_v g_{qs}^{(d_v)}(u_· - p_v)`. -/
theorem baseTrace_eq (hh : 0 ≤ Hd.h) {m : ℕ} (hm : m = 3 ∨ m = 4) {s : ℝ} (hs : 0 < s)
    (p : Fin 3 → ℝ) :
    Hd.baseTrace m p s = ((Hd.h ^ 3 * √s ^ m : ℝ) : ℂ) * ∑ i, ∑ j, ∑ k,
      Hd.A 0 i j * Hd.A 1 j k * Hd.A 2 k i *
        ((gaussianD (dexp m 0) (21 / 20 * s) (Hd.u i - p 0) *
          gaussianD (dexp m 1) (21 / 20 * s) (Hd.u j - p 1) *
          gaussianD (dexp m 2) (21 / 20 * s) (Hd.u k - p 2) : ℝ) : ℂ) := by
  have e1 : (0 : Fin 3) + 1 = 1 := rfl
  have e2 : (1 : Fin 3) + 1 = 2 := rfl
  have e3 : (2 : Fin 3) + 1 = 0 := rfl
  rw [baseTrace, Dmat, Dmat, Dmat, W, W, W, e1, e2, e3, trace_cyclic_diag, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [Hd.Dfun_mul_w hh _ hs, Hd.Dfun_mul_w hh _ hs, Hd.Dfun_mul_w hh _ hs]
  have hsum := dexp_sum hm
  have hpow : √s ^ dexp m 0 * √s ^ dexp m 1 * √s ^ dexp m 2 = √s ^ m := by
    rw [← pow_add, ← pow_add]; congr 1; omega
  have : (Hd.h * (√s ^ dexp m 0 * gaussianD (dexp m 0) (21 / 20 * s) (Hd.u i - p 0)) *
      (Hd.h * (√s ^ dexp m 1 * gaussianD (dexp m 1) (21 / 20 * s) (Hd.u j - p 1))) *
      (Hd.h * (√s ^ dexp m 2 * gaussianD (dexp m 2) (21 / 20 * s) (Hd.u k - p 2)))) =
      Hd.h ^ 3 * √s ^ m * (gaussianD (dexp m 0) (21 / 20 * s) (Hd.u i - p 0) *
        gaussianD (dexp m 1) (21 / 20 * s) (Hd.u j - p 1) *
        gaussianD (dexp m 2) (21 / 20 * s) (Hd.u k - p 2)) := by
    rw [← hpow]; ring
  rw [this]
  push_cast; ring

/-- **The plane integral of the trace:** `∫_{Π₀} tr = h³ s^{m/2} ∑ A₀A₁A₂ g_{cs}^{(m)}(u_i+u_j+u_k)`. -/
theorem integral_baseTrace (hh : 0 ≤ Hd.h) {m : ℕ} (hm : m = 3 ∨ m = 4) {s : ℝ} (hs : 0 < s) :
    Integrable (fun q : Fin 2 → ℝ => Hd.baseTrace m (planePt q) s) ∧
    ∫ q : Fin 2 → ℝ, Hd.baseTrace m (planePt q) s = ((Hd.h ^ 3 * √s ^ m : ℝ) : ℂ) *
      ∑ i, ∑ j, ∑ k, Hd.A 0 i j * Hd.A 1 j k * Hd.A 2 k i *
        (gaussianD m (63 / 20 * s) (Hd.u i + Hd.u j + Hd.u k) : ℂ) := by
  have hq : (0 : ℝ) < 21 / 20 * s := by positivity
  have hpl : ∀ (i j k : ι), (fun q : Fin 2 → ℝ =>
      ((gaussianD (dexp m 0) (21 / 20 * s) (Hd.u i - planePt q 0) *
        gaussianD (dexp m 1) (21 / 20 * s) (Hd.u j - planePt q 1) *
        gaussianD (dexp m 2) (21 / 20 * s) (Hd.u k - planePt q 2) : ℝ) : ℂ)) =
      fun q => ((gaussianD (dexp m 0) (21 / 20 * s) (Hd.u i - q 0) *
        gaussianD (dexp m 1) (21 / 20 * s) (Hd.u j - q 1) *
        gaussianD (dexp m 2) (21 / 20 * s) (Hd.u k + q 0 + q 1) : ℝ) : ℂ) := by
    intro i j k; funext q
    simp only [planePt, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons]
    congr 3; ring
  have hint : ∀ i j k, Integrable (fun q : Fin 2 → ℝ => Hd.A 0 i j * Hd.A 1 j k * Hd.A 2 k i *
      ((gaussianD (dexp m 0) (21 / 20 * s) (Hd.u i - planePt q 0) *
        gaussianD (dexp m 1) (21 / 20 * s) (Hd.u j - planePt q 1) *
        gaussianD (dexp m 2) (21 / 20 * s) (Hd.u k - planePt q 2) : ℝ) : ℂ)) := by
    intro i j k
    have := (plane_gaussD_three (dexp m 0) (dexp m 1) (dexp m 2) hq (Hd.u i) (Hd.u j)
      (Hd.u k)).1.const_mul (Hd.A 0 i j * Hd.A 1 j k * Hd.A 2 k i)
    refine this.congr (Eventually.of_forall fun q => ?_)
    have h' := congrFun (hpl i j k) q
    simp only at h' ⊢
    rw [h']
  have hval : ∀ i j k, ∫ q : Fin 2 → ℝ, Hd.A 0 i j * Hd.A 1 j k * Hd.A 2 k i *
      ((gaussianD (dexp m 0) (21 / 20 * s) (Hd.u i - planePt q 0) *
        gaussianD (dexp m 1) (21 / 20 * s) (Hd.u j - planePt q 1) *
        gaussianD (dexp m 2) (21 / 20 * s) (Hd.u k - planePt q 2) : ℝ) : ℂ) =
      Hd.A 0 i j * Hd.A 1 j k * Hd.A 2 k i *
        (gaussianD m (63 / 20 * s) (Hd.u i + Hd.u j + Hd.u k) : ℂ) := by
    intro i j k
    rw [integral_const_mul, hpl i j k, (plane_gaussD_three (dexp m 0) (dexp m 1) (dexp m 2) hq
      (Hd.u i) (Hd.u j) (Hd.u k)).2, dexp_sum hm,
      show 21 / 20 * s + 21 / 20 * s + 21 / 20 * s = 63 / 20 * s by ring]
  simp only [Hd.baseTrace_eq hh hm hs]
  refine ⟨(integrable_finsetSum _ fun i _ => integrable_finsetSum _ fun j _ =>
    integrable_finsetSum _ fun k _ => hint i j k).const_mul _, ?_⟩
  rw [integral_const_mul, integral_finsetSum _ fun i _ => integrable_finsetSum _ fun j _ =>
    integrable_finsetSum _ fun k _ => hint i j k]
  congr 1
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [integral_finsetSum _ fun j _ => integrable_finsetSum _ fun k _ => hint i j k]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [integral_finsetSum _ fun k _ => hint i j k]
  exact Finset.sum_congr rfl fun k _ => hval i j k

end HeatData

end D03Trace2

section MaskPartition

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- **The partition of `[s₋, s₊]` by the switch scales of the masks**, with the arrays on the
pieces, their entry bounds, total variation `≤ 2n`, and constancy on the open pieces. -/
theorem mask_partition (A : Matrix ι ι ℂ) {n : ℕ} {sm sp : ℝ} (hlt : sm < sp)
    (M : ι → ι → IntervalList n sm sp) :
    ∃ (N : ℕ) (t : ℕ → ℝ) (B : ℕ → Matrix ι ι ℂ), Monotone t ∧ t 0 = sm ∧ t (N + 1) = sp ∧
      (∀ k ≤ N, t k < t (k + 1)) ∧ (∀ k i j, ‖B k i j‖ ≤ ‖A i j‖) ∧
      (∀ i j, ∑ k ∈ Finset.range N, ‖B (k + 1) i j - B k i j‖ ≤ 2 * (n : ℝ) * ‖A i j‖) ∧
      (∀ k ≤ N, ∀ s ∈ Set.Ioo (t k) (t (k + 1)), maskA A M s = B k) := by
  classical
  have hmemE : ∀ (i j : ι) (ℓ : ℕ), ℓ < (M i j).len →
      (M i j).a ℓ ∈ switchSet M ∧ (M i j).b ℓ ∈ switchSet M := by
    intro i j ℓ hℓ
    constructor <;> refine Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨(i, j),
      Finset.mem_univ _, Finset.mem_biUnion.2 ⟨ℓ, Finset.mem_range.2 hℓ, by simp⟩⟩)
  have hEbd : ∀ e ∈ switchSet M, sm ≤ e ∧ e ≤ sp := by
    intro e he
    simp only [switchSet, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
      Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_range] at he
    rcases he with (rfl | rfl) | ⟨z, ℓ, hℓ, rfl | rfl⟩
    · exact ⟨le_rfl, hlt.le⟩
    · exact ⟨hlt.le, le_rfl⟩
    · have := (M z.1 z.2).range ℓ hℓ
      exact ⟨this.1, ((M z.1 z.2).lt ℓ hℓ).le.trans this.2⟩
    · have := (M z.1 z.2).range ℓ hℓ
      exact ⟨this.1.trans ((M z.1 z.2).lt ℓ hℓ).le, this.2⟩
  obtain ⟨N, t, hmono, ht0, htN, hstrict, hgap⟩ := exists_switch_partition (switchSet M)
    (by simp [switchSet]) (by simp [switchSet]) hlt hEbd
  set mid : ℕ → ℝ := fun k => (t k + t (k + 1)) / 2
  have hmid : ∀ k ≤ N, mid k ∈ Set.Ioo (t k) (t (k + 1)) := fun k hk => by
    have := hstrict k hk
    simp only [mid, Set.mem_Ioo]; constructor <;> linarith
  set B : ℕ → Matrix ι ι ℂ := fun k => maskA A M (mid k)
  refine ⟨N, t, B, hmono, ht0, htN, hstrict, fun k i j => ?_, fun i j => ?_, fun k hk s hs => ?_⟩
  · simp only [B, maskA, norm_mul]
    exact mul_le_of_le_one_right (norm_nonneg _) ((M i j).norm_mval_le _)
  · set x : ℕ → ℝ := fun k => if k ≤ N then mid k else sp + k
    have hxmono : StrictMono x := by
      refine strictMono_nat_of_lt_succ fun k => ?_
      simp only [x]
      by_cases h1 : k + 1 ≤ N
      · rw [if_pos h1, if_pos (by omega)]
        have := hstrict k (by omega)
        have := hstrict (k + 1) h1
        simp only [mid]; linarith
      · rw [if_neg h1]
        by_cases h2 : k ≤ N
        · rw [if_pos h2]
          have hkN : k = N := by omega
          have := (hmid k h2).2
          rw [hkN] at this ⊢
          rw [htN] at this
          have : (0 : ℝ) ≤ ((N + 1 : ℕ) : ℝ) := Nat.cast_nonneg _
          push_cast at this ⊢
          linarith
        · rw [if_neg h2]; push_cast; linarith
    have hx : ∀ k ∈ Finset.range N, ‖B (k + 1) i j - B k i j‖ =
        ‖A i j‖ * ‖(M i j).mval (x (k + 1)) - (M i j).mval (x k)‖ := by
      intro k hk
      have hk' : k < N := Finset.mem_range.1 hk
      simp only [B, maskA, x, if_pos (show k + 1 ≤ N by omega), if_pos (show k ≤ N by omega)]
      rw [← mul_sub, norm_mul]
    rw [Finset.sum_congr rfl hx, ← Finset.mul_sum]
    have := (M i j).sum_mval_change_le hxmono N
    rw [mul_comm]
    exact mul_le_mul_of_nonneg_right this (norm_nonneg _)
  · funext i j
    simp only [B, maskA, IntervalList.mval]
    congr 1
    refine Finset.sum_congr rfl fun ℓ hℓ => ?_
    have hℓ' := Finset.mem_range.1 hℓ
    obtain ⟨ha, hb⟩ := hmemE i j ℓ hℓ'
    by_cases hz' : s ∈ Set.Ioo ((M i j).a ℓ) ((M i j).b ℓ)
    · have hm := (mem_Ioo_iff_of_gap (hgap · · k hk) ha hb hs (hmid k hk)).1 hz'
      rw [Set.indicator_of_mem hz', Set.indicator_of_mem hm]
    · have hm : mid k ∉ Set.Ioo ((M i j).a ℓ) ((M i j).b ℓ) := fun hm =>
        hz' ((mem_Ioo_iff_of_gap (hgap · · k hk) ha hb hs (hmid k hk)).2 hm)
      rw [Set.indicator_of_notMem hz', Set.indicator_of_notMem hm]

lemma restrict_Ioc_eq_sum {t : ℕ → ℝ} (ht : Monotone t) (N : ℕ) :
    (volume : Measure ℝ).restrict (Set.Ioc (t 0) (t (N + 1))) =
      ∑ k ∈ Finset.range (N + 1), volume.restrict (Set.Ioc (t k) (t (k + 1))) := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ, ← ih,
      ← Measure.restrict_union (Set.Ioc_disjoint_Ioc_of_le le_rfl) measurableSet_Ioc,
      Set.Ioc_union_Ioc_eq_Ioc (ht (Nat.zero_le _)) (ht (Nat.le_succ _))]

lemma ae_restrict_mem_Ioo {a b : ℝ} :
    ∀ᵐ s ∂((volume : Measure ℝ).restrict (Set.Ioc a b)), s ∈ Set.Ioo a b := by
  have hb : ∀ᵐ s ∂(volume : Measure ℝ), s ∉ ({b} : Set ℝ) :=
    measure_eq_zero_iff_ae_notMem.1 Real.volume_singleton
  filter_upwards [ae_restrict_mem measurableSet_Ioc, ae_restrict_of_ae hb] with s hs hsb
  exact ⟨hs.1, lt_of_le_of_ne hs.2 (by simpa using hsb)⟩

end MaskPartition

/-! ### Lemma 5.3: the interval kernels -/

section D03Kernel

/-- The interval kernel `K^{(m)}_{a,b}(t) = ∫_a^b s^{m/2} g_{cs}^{(m)}(t) ds/s`, `c = 63/20`. -/
def Kern (m : ℕ) (a b t : ℝ) : ℝ := ∫ s in a..b, √s ^ m * gaussianD m (63 / 20 * s) t / s

lemma continuousOn_kernIntegrand (m : ℕ) (t : ℝ) :
    ContinuousOn (fun s : ℝ => √s ^ m * gaussianD m (63 / 20 * s) t / s) (Set.Ioi 0) := by
  have hg : ContinuousOn (fun s : ℝ => gaussianD m (63 / 20 * s) t) (Set.Ioi 0) :=
    (continuousOn_gaussianD_joint m).comp ((continuous_const.mul continuous_id).prodMk
      continuous_const).continuousOn fun s hs => by
        simp only [Set.mem_setOf_eq]; exact mul_pos (by norm_num) hs
  exact ((Real.continuous_sqrt.pow m).continuousOn.mul hg).div continuous_id.continuousOn
    fun s hs => (ne_of_gt hs)

/-- **The scale integral of a mask** inserts the interval kernels:
`∫_{s₋}^{s₊} m(s) s^{m/2} g_{cs}^{(m)}(t) ds/s = ∑_ℓ c_ℓ K^{(m)}_{a_ℓ,b_ℓ}(t)`. -/
theorem integral_mval_kern {n : ℕ} {sm sp : ℝ} (hsm : 0 < sm) (L : IntervalList n sm sp)
    (m : ℕ) (t : ℝ) :
    ∫ s in Set.Ioc sm sp, L.mval s * ((√s ^ m * gaussianD m (63 / 20 * s) t / s : ℝ) : ℂ) =
      ∑ ℓ ∈ Finset.range L.len, L.c ℓ * (Kern m (L.a ℓ) (L.b ℓ) t : ℂ) := by
  set F : ℝ → ℝ := fun s => √s ^ m * gaussianD m (63 / 20 * s) t / s
  have hFint : ∀ a b, sm ≤ a → IntegrableOn F (Set.Ioc a b) := by
    intro a b ha
    rcases le_or_gt a b with hab | hab
    · exact ((continuousOn_kernIntegrand m t).mono fun s hs =>
        (hsm.trans_le ha).trans_le hs.1).integrableOn_Icc.mono_set Set.Ioc_subset_Icc_self
    · rw [Set.Ioc_eq_empty (not_lt.2 hab.le)]; exact integrableOn_empty
  have hterm : ∀ ℓ ∈ Finset.range L.len, ∫ s in Set.Ioc sm sp,
      (Set.Ioo (L.a ℓ) (L.b ℓ)).indicator (fun _ => L.c ℓ) s * (F s : ℂ) =
      L.c ℓ * (Kern m (L.a ℓ) (L.b ℓ) t : ℂ) := by
    intro ℓ hℓ
    have hℓ' := Finset.mem_range.1 hℓ
    obtain ⟨ha, hb⟩ := L.range ℓ hℓ'
    have hlt := L.lt ℓ hℓ'
    have e : (fun s => (Set.Ioo (L.a ℓ) (L.b ℓ)).indicator (fun _ => L.c ℓ) s * (F s : ℂ)) =
        (Set.Ioo (L.a ℓ) (L.b ℓ)).indicator (fun s => L.c ℓ * (F s : ℂ)) := by
      funext s; by_cases hs : s ∈ Set.Ioo (L.a ℓ) (L.b ℓ) <;> simp [hs]
    have hsub : Set.Ioo (L.a ℓ) (L.b ℓ) ⊆ Set.Ioc sm sp := fun s hs =>
      ⟨lt_of_le_of_lt ha hs.1, hs.2.le.trans hb⟩
    rw [e, setIntegral_indicator measurableSet_Ioo, Set.inter_eq_right.mpr hsub]
    rw [integral_const_mul, Kern, intervalIntegral.integral_of_le hlt.le,
      ← integral_Ioc_eq_integral_Ioo, integral_complex_ofReal]
  have hint : ∀ ℓ ∈ Finset.range L.len, Integrable
      (fun s => (Set.Ioo (L.a ℓ) (L.b ℓ)).indicator (fun _ => L.c ℓ) s * (F s : ℂ))
      ((volume : Measure ℝ).restrict (Set.Ioc sm sp)) := by
    intro ℓ _
    refine ((hFint sm sp le_rfl).ofReal.const_mul (L.c ℓ)).norm.mono'
      ((measurable_const.indicator measurableSet_Ioo).aestronglyMeasurable.mul
        (hFint sm sp le_rfl).ofReal.aestronglyMeasurable)
      (Eventually.of_forall fun s => ?_)
    rw [norm_mul, norm_mul]
    by_cases hs : s ∈ Set.Ioo (L.a ℓ) (L.b ℓ)
    · simp [Set.indicator_of_mem hs]
    · rw [Set.indicator_of_notMem hs, norm_zero, zero_mul]; positivity
  simp only [IntervalList.mval, Finset.sum_mul]
  rw [integral_finsetSum _ hint]
  exact Finset.sum_congr rfl hterm

end D03Kernel

section D03Meas

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι)

/-- The unregularized row cost is measurable in the centers (fixed positive variances). -/
lemma measurable_rowCost (σ : Fin 3 → ℝ) (hσ : ∀ k, 0 < σ k) (v : Fin 3) :
    Measurable fun p : Fin 3 → ℝ => matCost (Hd.T p σ v) (Hd.Ui p σ v) := by
  have e : (fun p : Fin 3 → ℝ => matCost (Hd.T p σ v) (Hd.Ui p σ v)) = fun p =>
      ⨆ m : ℕ, ENNReal.ofReal (Hd.V p σ (1 / ((m : ℝ) + 1)) v) := by
    funext p
    rw [matCost_eq_iSup (P := Hd.T p σ v) (Matrix.posSemidef_conjTranspose_mul_self _)]
    congr 1; funext m
    exact (ENNReal.ofReal_toReal (matCost_ne_top (posDef_add_smul_one
      (Matrix.posSemidef_conjTranspose_mul_self (Hd.R p σ v))
        (one_div_pos.2 (by positivity : (0 : ℝ) < (m : ℝ) + 1))) (Hd.Ui p σ v))).symm
  rw [e]
  refine Measurable.iSup fun m => ENNReal.measurable_ofReal.comp ?_
  exact ((Hd.continuous_scalars continuous_id continuous_const (fun _ => hσ)
    (by positivity : (0 : ℝ) < 1 / ((m : ℝ) + 1)) v).2.2.2.2.2.2.2.1).measurable

/-- The integrand of the averaged row costs is a.e. measurable on `[a, b] × ℝ³`, `a > 0`. -/
lemma aemeasurable_costIntegrand {α : Fin 3 → ℝ} (hα : ∀ k, 0 < α k) (hh : 0 ≤ Hd.h)
    (B : Matrix ι ι ℂ) {a b : ℝ} (ha : 0 < a) :
    AEMeasurable (Hd.costIntegrand α B) ((volume.restrict (Set.Ioc a b)).prod volume) := by
  set η : ℕ → ℝ := fun m => 1 / ((m : ℝ) + 1)
  have hη : ∀ m, 0 < η m := fun m => by positivity
  have e : Hd.costIntegrand α B = fun z => ⨆ m : ℕ,
      ENNReal.ofReal ((Hd.withA0 B).costDensity α (η m) z) := by
    funext z
    simp only [(Hd.withA0 B).ofReal_costDensity hh (hη _)]
    rw [costIntegrand, ← ENNReal.mul_iSup]
    congr 1
    rw [← ENNReal.finsetSum_iSup_of_monotone]
    · refine Finset.sum_congr rfl fun v _ => ?_
      rw [matCost_eq_iSup (P := (Hd.withA0 B).T z.2 (sig α z.1) v)
        (Matrix.posSemidef_conjTranspose_mul_self _)]
    · intro v x y hxy
      refine matCost_anti (P := (Hd.withA0 B).T z.2 (sig α z.1) v + (η y : ℂ) • 1)
        (Q := (Hd.withA0 B).T z.2 (sig α z.1) v + (η x : ℂ) • 1)
        (posDef_add_smul_one (Matrix.posSemidef_conjTranspose_mul_self _) (hη x)).posSemidef ?_ _
      rw [Matrix.le_iff]
      have e : ((Hd.withA0 B).T z.2 (sig α z.1) v + (η x : ℂ) • 1) -
          ((Hd.withA0 B).T z.2 (sig α z.1) v + (η y : ℂ) • 1) =
          ((η x - η y : ℝ) : ℂ) • (1 : Matrix (ι ⊕ ι) (ι ⊕ ι) ℂ) := by
        push_cast; rw [sub_smul]; abel
      rw [e]
      refine Matrix.PosSemidef.one.smul ?_
      have : η y ≤ η x := by simp only [η]; gcongr
      exact_mod_cast sub_nonneg.2 this
  rw [e]
  refine AEMeasurable.iSup fun m => ENNReal.measurable_ofReal.comp_aemeasurable ?_
  have hμ : (volume.restrict (Set.Ioc a b)).prod (volume : Measure (Fin 3 → ℝ)) =
      ((volume : Measure ℝ).prod volume).restrict (Set.Ioc a b ×ˢ Set.univ) := by
    rw [← Measure.prod_restrict, Measure.restrict_univ]
  rw [hμ]
  have hc : ContinuousOn ((Hd.withA0 B).costDensity α (η m)) (Set.Ioi 0 ×ˢ Set.univ) := by
    have hG := continuousOn_Gm (1 / 10) (by norm_num) 0
    have hV : ∀ v, ContinuousOn (fun z : ℝ × (Fin 3 → ℝ) =>
        (Hd.withA0 B).qV α (η m) v z.1 z.2) (Set.Ioi 0 ×ˢ Set.univ) := fun v =>
      ((Hd.withA0 B).continuousOn_family α hα (hη m) v).2.2.2.2.2.2.2.1
    exact hG.mul (continuousOn_finset_sum _ fun v _ => hV v)
  exact (hc.mono (Set.prod_mono (fun s hs => ha.trans hs.1) le_rfl)).aestronglyMeasurable
    (measurableSet_Ioc.prod MeasurableSet.univ) |>.aemeasurable

end HeatData

end D03Meas

section D03Sum

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι)

/-- The left side of Lemma 5.3:
`h³ ∑_{ijk} A₀(i,j) A₁(j,k) A₂(k,i) ∑_ℓ η_ℓ K^{(m)}_{u_ℓ,v_ℓ}(u_i + u_j + u_k)`. -/
def D03sum {n : ℕ} {sm sp : ℝ} (M : ι → ι → IntervalList n sm sp) (m : ℕ) : ℂ :=
  ((Hd.h ^ 3 : ℝ) : ℂ) * ∑ i, ∑ j, ∑ k, Hd.A 0 i j * Hd.A 1 j k * Hd.A 2 k i *
    ∑ ℓ ∈ Finset.range (M i j).len,
      (M i j).c ℓ * (Kern m ((M i j).a ℓ) ((M i j).b ℓ) (Hd.u i + Hd.u j + Hd.u k) : ℂ)

lemma measurable_mval {n : ℕ} {sm sp : ℝ} (L : IntervalList n sm sp) : Measurable L.mval :=
  Finset.measurable_sum _ fun ℓ _ => measurable_const.indicator measurableSet_Ioo

/-- **The integrated trace is the left side of Lemma 5.3.** -/
theorem D03sum_eq (hh : 0 ≤ Hd.h) {m : ℕ} (hm : m = 3 ∨ m = 4) {n : ℕ} {sm sp : ℝ}
    (hsm : 0 < sm) (M : ι → ι → IntervalList n sm sp) :
    Hd.D03sum M m = ∫ s in Set.Ioc sm sp, ((1 / s : ℝ) : ℂ) *
      ∫ q : Fin 2 → ℝ, (Hd.withA0 (maskA (Hd.A 0) M s)).baseTrace m (planePt q) s := by
  set F : ι → ι → ι → ℝ → ℝ := fun i j k s =>
    √s ^ m * gaussianD m (63 / 20 * s) (Hd.u i + Hd.u j + Hd.u k) / s
  have hFint : ∀ i j k, IntegrableOn (F i j k) (Set.Ioc sm sp) := fun i j k =>
    ((continuousOn_kernIntegrand m _).mono fun s hs => hsm.trans_le hs.1).integrableOn_Icc.mono_set
      Set.Ioc_subset_Icc_self
  have hterm : ∀ i j k, Integrable (fun s => ((Hd.h ^ 3 : ℝ) : ℂ) *
      (Hd.A 0 i j * Hd.A 1 j k * Hd.A 2 k i) * ((M i j).mval s * (F i j k s : ℂ)))
      ((volume : Measure ℝ).restrict (Set.Ioc sm sp)) := by
    intro i j k
    refine Integrable.const_mul ?_ _
    exact (hFint i j k).ofReal.bdd_mul (c := 1) (measurable_mval _).aestronglyMeasurable
      (Eventually.of_forall fun s => (M i j).norm_mval_le s)
  have hpt : ∀ s ∈ Set.Ioc sm sp, ((1 / s : ℝ) : ℂ) *
      ∫ q : Fin 2 → ℝ, (Hd.withA0 (maskA (Hd.A 0) M s)).baseTrace m (planePt q) s =
      ∑ i, ∑ j, ∑ k, ((Hd.h ^ 3 : ℝ) : ℂ) * (Hd.A 0 i j * Hd.A 1 j k * Hd.A 2 k i) *
        ((M i j).mval s * (F i j k s : ℂ)) := by
    intro s hs
    have hs0 : 0 < s := hsm.trans hs.1
    rw [((Hd.withA0 (maskA (Hd.A 0) M s)).integral_baseTrace hh hm hs0).2]
    simp only [withA0_h, withA0_u, withA0_A0, withA0_A1, withA0_A2, maskA, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ =>
      Finset.sum_congr rfl fun k _ => ?_
    simp only [F]
    push_cast
    field_simp
  rw [setIntegral_congr_fun measurableSet_Ioc hpt]
  rw [integral_finsetSum _ fun i _ => integrable_finsetSum _ fun j _ =>
    integrable_finsetSum _ fun k _ => hterm i j k]
  simp only [D03sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [integral_finsetSum _ fun j _ => integrable_finsetSum _ fun k _ => hterm i j k]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [integral_finsetSum _ fun k _ => hterm i j k]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [integral_const_mul, integral_mval_kern hsm (M i j) m, Finset.mul_sum]
  exact Finset.sum_congr rfl fun ℓ _ => by ring

end HeatData

end D03Sum

/-! ### Lemma 5.3: assembly -/

section D03Assembly

lemma sq_smul_one_sub_rdiag_psd {ι : Type*} [Fintype ι] [DecidableEq ι] {f : ι → ℝ} {d : ℝ}
    (hf : ∀ i, |f i| ≤ d) :
    ((d ^ 2 : ℝ) • (1 : Matrix ι ι ℂ) - rdiag f * rdiag f).PosSemidef := by
  have e : (d ^ 2 : ℝ) • (1 : Matrix ι ι ℂ) - rdiag f * rdiag f =
      rdiag fun i => d ^ 2 - f i ^ 2 := by
    ext i j
    by_cases hij : i = j
    · subst hij; simp [rdiag, Matrix.one_apply, Matrix.diagonal_apply]; push_cast; ring
    · simp [rdiag, Matrix.one_apply, Matrix.diagonal_apply, hij]
  rw [e]
  refine rdiag_posSemidef fun i => ?_
  have := hf i
  have h0 := abs_nonneg (f i)
  nlinarith [sq_abs (f i)]

/-- The rates `(1 at v, λ elsewhere)`. -/
def rateAt (v : Fin 3) : Fin 3 → ℝ := fun k => if k = v then 1 else 11 / 10

lemma rateAt_cases (v : Fin 3) : ∀ k, rateAt v k = 1 ∨ rateAt v k = 11 / 10 := fun k => by
  unfold rateAt; split_ifs <;> simp

lemma rateAt_pos (v : Fin 3) : ∀ k, 0 < rateAt v k := fun k => by
  rcases rateAt_cases v k with h | h <;> rw [h] <;> norm_num

lemma rateAt_sum (v : Fin 3) : rateAt v 0 + rateAt v 1 + rateAt v 2 = 16 / 5 := by
  fin_cases v <;> simp [rateAt] <;> norm_num

lemma sig_rateAt (v : Fin 3) (s : ℝ) :
    HeatData.sig (rateAt v) s = Function.update (fun _ => 11 / 10 * s) v s := by
  funext k
  simp only [HeatData.sig, rateAt, Function.update_apply]
  split_ifs <;> ring

lemma dexp_cases (m : ℕ) (v : Fin 3) : dexp m v = 1 ∨ dexp m v = 2 := by
  unfold dexp; split_ifs <;> simp

/-- The constant bounding the insertions `D_v`. -/
def constD : ℝ := Classical.choose (Dfun_bound 1) + Classical.choose (Dfun_bound 2)
/-- The constant bounding the coefficients `a_{j,s}`. -/
def constA : ℝ := Classical.choose (acoef_bound 1 le_rfl) +
  Classical.choose (acoef_bound 2 (by norm_num))

lemma constD_spec : 0 ≤ constD ∧ ∀ (m : ℕ) (v : Fin 3) (s : ℝ), 0 < s → ∀ x,
    |Dfun (dexp m v) s x| ≤ constD := by
  have h1 := Classical.choose_spec (Dfun_bound 1)
  have h2 := Classical.choose_spec (Dfun_bound 2)
  refine ⟨add_nonneg h1.1 h2.1, fun m v s hs x => ?_⟩
  rcases dexp_cases m v with h | h <;> rw [h] <;> unfold constD
  · linarith [h1.2 s hs x, h2.1]
  · linarith [h2.2 s hs x, h1.1]

lemma constA_spec : 0 ≤ constA ∧ ∀ (m : ℕ) (v : Fin 3) (s : ℝ), 0 < s → ∀ d,
    |acoef (dexp m v) s d| ≤ constA * √s := by
  have h1 := Classical.choose_spec (acoef_bound 1 le_rfl)
  have h2 := Classical.choose_spec (acoef_bound 2 (by norm_num))
  refine ⟨add_nonneg h1.1 h2.1, fun m v s hs d => ?_⟩
  have hs' := Real.sqrt_nonneg s
  rcases dexp_cases m v with h | h <;> rw [h] <;> unfold constA
  · nlinarith [h1.2 s hs d, mul_nonneg h2.1 hs']
  · nlinarith [h2.2 s hs d, mul_nonneg h1.1 hs']

/-- The absolute constant of Lemma 5.3 (before normalization). -/
def constD03 : ℝ := 5 / 3 * constD * constA ^ 2 * 3 * 28 *
  (2 * √2 * (1 + √(2 / π)) + 2 * HeatData.jumpConst)

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

namespace HeatData

variable (Hd : HeatData ι)

/-- **Lemma 5.3 before normalization:**
`|h³ ∑ A₀A₁A₂ ∑_ℓ η_ℓ K^{(m)}| ≤ C (n₀³ + n₁³ + n₂³ + n (2n₀³ + n₀²n₂ + n₀²n₁))`. -/
theorem D03_pre {kk : ι → ℤ} (hk : Function.Injective kk) (hu : ∀ i, Hd.u i = Hd.h * kk i)
    (hh : 0 < Hd.h) {m : ℕ} (hm : m = 3 ∨ m = 4) {n : ℕ} {sm sp : ℝ} (hsm : Hd.h ^ 2 ≤ sm)
    (hlt : sm < sp) (M : ι → ι → IntervalList n sm sp) :
    ‖Hd.D03sum M m‖ ≤ constD03 * (nNorm Hd.h (Hd.A 0) ^ 3 + nNorm Hd.h (Hd.A 1) ^ 3 +
      nNorm Hd.h (Hd.A 2) ^ 3 + n * (2 * nNorm Hd.h (Hd.A 0) ^ 3 +
        nNorm Hd.h (Hd.A 0) ^ 2 * nNorm Hd.h (Hd.A 2) +
        nNorm Hd.h (Hd.A 0) ^ 2 * nNorm Hd.h (Hd.A 1))) := by
  classical
  have hsm0 : 0 < sm := lt_of_lt_of_le (by positivity) hsm
  obtain ⟨hcD, hD⟩ := constD_spec
  obtain ⟨hcA, hA⟩ := constA_spec
  obtain ⟨N, t, B, hmono, ht0, htN, hstrict, hB, hvar, hconst⟩ := mask_partition (Hd.A 0) hlt M
  set N0 := nNorm Hd.h (Hd.A 0)
  set N1 := nNorm Hd.h (Hd.A 1)
  set N2 := nNorm Hd.h (Hd.A 2)
  set R := 2 * √2 * (1 + √(2 / π)) * (N0 ^ 3 + N1 ^ 3 + N2 ^ 3) +
    jumpConst * (2 * (n : ℝ)) * (2 * N0 ^ 3 + N0 ^ 2 * N2 + N0 ^ 2 * N1)
  have hD02 : ∀ v : Fin 3, ∑ k ∈ Finset.range (N + 1), ∫⁻ z, Hd.costIntegrand (rateAt v) (B k) z
      ∂((volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod volume) ≤ ENNReal.ofReal (28 * R) :=
    fun v => Hd.repeated_mask_integrated_cost hk hu hh (rateAt_cases v) (rateAt_sum v) t
      (ht0 ▸ hsm) hmono B (Hd.A 0) hB (Nat.cast_nonneg n) N hvar
  set c := 5 / 3 * constD * constA ^ 2
  -- the bound at one scale, for constant arrays
  have hpiece : ∀ (B' : Matrix ι ι ℂ) (s : ℝ), 0 < s →
      ‖((1 / s : ℝ) : ℂ) * ∫ q : Fin 2 → ℝ, (Hd.withA0 B').baseTrace m (planePt q) s‖ₑ ≤
        ENNReal.ofReal c * ∑ v, ∫⁻ p, Hd.costIntegrand (rateAt v) B' (s, p) := by
    intro B' s hs
    set HB := Hd.withA0 B'
    set σB : Fin 3 → ℝ := fun _ => 11 / 10 * s
    have hσV : ∀ v k, 0 < Function.update σB v s k := fun v k => by
      simp only [σB, Function.update_apply]; split_ifs <;> positivity
    set Φ : Fin 3 → (Fin 3 → ℝ) → ℝ≥0∞ := fun v p =>
      matCost (HB.T p (Function.update σB v s) v) (HB.Ui p (Function.update σB v s) v)
    have hΦ : ∀ v, Measurable (Φ v) := fun v => HB.measurable_rowCost _ (hσV v) v
    -- the trace bound at a point of the base plane (Lemmas 3.5 and 3.3)
    have htr : ∀ q : Fin 2 → ℝ, ‖HB.baseTrace m (planePt q) s‖ₑ ≤
        ENNReal.ofReal (5 / 3 * constD) * ∑ v, ENNReal.ofReal (constA ^ 2 * s) *
          ∫⁻ d, ENNReal.ofReal (gaussian (1 / 10 * s) d) *
            Φ v (Function.update (planePt q) v (planePt q v + d)) := by
      intro q
      set p := planePt q
      have hDh : ∀ v, (HB.Dmat m v p s).IsHermitian := fun v => rdiag_isHermitian _
      have hDb : ∀ v, ((constD ^ 2 : ℝ) • (1 : Matrix ι ι ℂ) - HB.Dmat m v p s *
          HB.Dmat m v p s).PosSemidef := fun v =>
        sq_smul_one_sub_rdiag_psd fun i => hD m v s hs _
      have h05 := cyclic_trace_control (W0 := HB.W p σB 0) (W1 := HB.W p σB 1)
        (W2 := HB.W p σB 2) (D0 := HB.Dmat m 0 p s) (D1 := HB.Dmat m 1 p s)
        (D2 := HB.Dmat m 2 p s) (hDh 0) (hDh 1) (hDh 2) hcD (hDb 0) (hDb 1) (hDb 2)
      rw [← ofReal_norm]
      refine h05.trans (mul_le_mul' le_rfl ?_)
      rw [Fin.sum_univ_three]
      have hv := fun v : Fin 3 => HB.vertex_avg hh v (dexp_pos m v) (hA m v) p hs
      refine add_le_add (add_le_add ?_ ?_) ?_
      · exact hv 0
      · exact hv 1
      · exact hv 2
    have hI : ∀ v, AEMeasurable (fun q : Fin 2 → ℝ => ENNReal.ofReal (constA ^ 2 * s) *
        ∫⁻ d, ENNReal.ofReal (gaussian (1 / 10 * s) d) *
          Φ v (Function.update (planePt q) v (planePt q v + d))) volume := by
      intro v
      refine (Measurable.lintegral_prod_right' (ν := (volume : Measure ℝ))
        (f := fun z : (Fin 2 → ℝ) × ℝ => ENNReal.ofReal (gaussian (1 / 10 * s) z.2) *
          Φ v (Function.update (planePt z.1) v (planePt z.1 v + z.2))) ?_).const_mul _
        |>.aemeasurable
      refine (ENNReal.measurable_ofReal.comp ((continuous_gaussian' _).measurable.comp
        measurable_snd)).mul ((hΦ v).comp ?_)
      have : Continuous fun z : (Fin 2 → ℝ) × ℝ =>
          Function.update (planePt z.1) v (planePt z.1 v + z.2) := by
        refine continuous_pi fun k => ?_
        by_cases hk : k = v
        · subst hk; simp only [Function.update_self]
          fin_cases k <;> simp [planePt] <;> fun_prop
        · simp only [Function.update_of_ne hk]
          fin_cases k <;> simp [planePt] <;> fun_prop
      exact this.measurable
    have hcv : ∀ v, ∫⁻ q : Fin 2 → ℝ, ∫⁻ d, ENNReal.ofReal (gaussian (1 / 10 * s) d) *
        Φ v (Function.update (planePt q) v (planePt q v + d)) ≤
        ∫⁻ p, Hd.costIntegrand (rateAt v) B' (s, p) := by
      intro v
      have hF : Measurable fun p : Fin 3 → ℝ =>
          ENNReal.ofReal (gaussian (1 / 10 * s) (p 0 + p 1 + p 2)) * Φ v p :=
        (ENNReal.measurable_ofReal.comp ((continuous_gaussian' _).measurable.comp
          (by fun_prop))).mul (hΦ v)
      have := lintegral_plane_shift v hF
      simp only [sum_shift] at this
      rw [this]
      refine lintegral_mono fun p => ?_
      simp only [costIntegrand, Gm_eq, Φ, HB]
      rw [sig_rateAt]
      refine mul_le_mul' le_rfl ?_
      exact Finset.single_le_sum (f := fun v' => matCost ((Hd.withA0 B').T p
        (Function.update (fun _ => 11 / 10 * s) v s) v')
        ((Hd.withA0 B').Ui p (Function.update (fun _ => 11 / 10 * s) v s) v'))
        (fun _ _ => zero_le) (Finset.mem_univ v)
    calc ‖((1 / s : ℝ) : ℂ) * ∫ q : Fin 2 → ℝ, HB.baseTrace m (planePt q) s‖ₑ
        = ENNReal.ofReal (1 / s) * ‖∫ q : Fin 2 → ℝ, HB.baseTrace m (planePt q) s‖ₑ := by
          rw [enorm_mul, ← ofReal_norm (((1 / s : ℝ) : ℂ)), Complex.norm_real,
            Real.norm_eq_abs, abs_of_pos (by positivity)]
      _ ≤ ENNReal.ofReal (1 / s) * ∫⁻ q : Fin 2 → ℝ, ‖HB.baseTrace m (planePt q) s‖ₑ :=
          mul_le_mul' le_rfl (enorm_integral_le_lintegral_enorm _)
      _ ≤ ENNReal.ofReal (1 / s) * ∫⁻ q : Fin 2 → ℝ, ENNReal.ofReal (5 / 3 * constD) *
          ∑ v, ENNReal.ofReal (constA ^ 2 * s) * ∫⁻ d, ENNReal.ofReal (gaussian (1 / 10 * s) d) *
            Φ v (Function.update (planePt q) v (planePt q v + d)) :=
          mul_le_mul' le_rfl (lintegral_mono htr)
      _ = ENNReal.ofReal (1 / s) * (ENNReal.ofReal (5 / 3 * constD) *
          ∑ v, ENNReal.ofReal (constA ^ 2 * s) * ∫⁻ q : Fin 2 → ℝ, ∫⁻ d,
            ENNReal.ofReal (gaussian (1 / 10 * s) d) *
              Φ v (Function.update (planePt q) v (planePt q v + d))) := by
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, lintegral_finset_sum' _
            fun v _ => hI v]
          congr 2
          refine Finset.sum_congr rfl fun v _ => ?_
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
      _ ≤ ENNReal.ofReal (1 / s) * (ENNReal.ofReal (5 / 3 * constD) *
          ∑ v, ENNReal.ofReal (constA ^ 2 * s) * ∫⁻ p, Hd.costIntegrand (rateAt v) B' (s, p)) := by
          gcongr with v
          exact hcv v
      _ = ENNReal.ofReal c * ∑ v, ∫⁻ p, Hd.costIntegrand (rateAt v) B' (s, p) := by
          rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
          refine Finset.sum_congr rfl fun v _ => ?_
          rw [← mul_assoc, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity),
            ← ENNReal.ofReal_mul (by positivity)]
          congr 2
          simp only [c]; field_simp
  -- integrate in the scale, piece by piece
  have hmain : ENNReal.ofReal ‖Hd.D03sum M m‖ ≤ ENNReal.ofReal c *
      ∑ v : Fin 3, ENNReal.ofReal (28 * R) := by
    rw [ofReal_norm, Hd.D03sum_eq hh.le hm hsm0 M]
    refine (enorm_integral_le_lintegral_enorm _).trans ?_
    rw [show Set.Ioc sm sp = Set.Ioc (t 0) (t (N + 1)) by rw [ht0, htN],
      restrict_Ioc_eq_sum hmono N, lintegral_finset_sum_measure]
    have hk : ∀ k ∈ Finset.range (N + 1),
        ∫⁻ s in Set.Ioc (t k) (t (k + 1)), ‖((1 / s : ℝ) : ℂ) * ∫ q : Fin 2 → ℝ,
          (Hd.withA0 (maskA (Hd.A 0) M s)).baseTrace m (planePt q) s‖ₑ ≤
        ENNReal.ofReal c * ∑ v, ∫⁻ z, Hd.costIntegrand (rateAt v) (B k) z
          ∂((volume.restrict (Set.Ioc (t k) (t (k + 1)))).prod volume) := by
      intro k hkN
      have hkN' : k ≤ N := Nat.lt_succ_iff.1 (Finset.mem_range.1 hkN)
      have ht_pos : 0 < t k := (hsm0.trans_le (ht0 ▸ hmono (Nat.zero_le k)))
      calc ∫⁻ s in Set.Ioc (t k) (t (k + 1)), ‖((1 / s : ℝ) : ℂ) * ∫ q : Fin 2 → ℝ,
            (Hd.withA0 (maskA (Hd.A 0) M s)).baseTrace m (planePt q) s‖ₑ
          ≤ ∫⁻ s in Set.Ioc (t k) (t (k + 1)), ENNReal.ofReal c *
              ∑ v, ∫⁻ p, Hd.costIntegrand (rateAt v) (B k) (s, p) := by
            refine lintegral_mono_ae ?_
            filter_upwards [ae_restrict_mem_Ioo] with s hs
            rw [hconst k hkN' s hs]
            exact hpiece (B k) s (ht_pos.trans hs.1)
        _ = ENNReal.ofReal c * ∑ v, ∫⁻ s in Set.Ioc (t k) (t (k + 1)),
              ∫⁻ p, Hd.costIntegrand (rateAt v) (B k) (s, p) := by
            rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, lintegral_finset_sum']
            intro v _
            exact (Hd.aemeasurable_costIntegrand (rateAt_pos v) hh.le (B k)
              ht_pos).lintegral_prod_right'
        _ = _ := by
            congr 1
            refine Finset.sum_congr rfl fun v _ => ?_
            rw [lintegral_prod _ (Hd.aemeasurable_costIntegrand (rateAt_pos v) hh.le (B k) ht_pos)]
    refine (Finset.sum_le_sum hk).trans ?_
    rw [← Finset.mul_sum, Finset.sum_comm]
    exact mul_le_mul' le_rfl (Finset.sum_le_sum fun v _ => hD02 v)
  -- back to real numbers
  have hR : 0 ≤ R := by
    have := nNorm_nonneg Hd.h (Hd.A 0)
    have := nNorm_nonneg Hd.h (Hd.A 1)
    have := nNorm_nonneg Hd.h (Hd.A 2)
    have := jumpConst_nonneg
    positivity
  have hc : 0 ≤ c := by positivity
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_ofNat,
    ← ENNReal.ofReal_ofNat, ← ENNReal.ofReal_mul (by norm_num), ← ENNReal.ofReal_mul hc,
    ENNReal.ofReal_le_ofReal_iff (by positivity)] at hmain
  refine hmain.trans ?_
  have hJ := jumpConst_nonneg
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have h0 := nNorm_nonneg Hd.h (Hd.A 0)
  have h1 := nNorm_nonneg Hd.h (Hd.A 1)
  have h2 := nNorm_nonneg Hd.h (Hd.A 2)
  have hM : 0 ≤ 2 * √2 * (1 + √(2 / π)) := by positivity
  have hRle : R ≤ (2 * √2 * (1 + √(2 / π)) + 2 * jumpConst) * (N0 ^ 3 + N1 ^ 3 + N2 ^ 3 +
      n * (2 * N0 ^ 3 + N0 ^ 2 * N2 + N0 ^ 2 * N1)) := by
    have hA : 0 ≤ N0 ^ 3 + N1 ^ 3 + N2 ^ 3 := by positivity
    have hBn : 0 ≤ (n : ℝ) * (2 * N0 ^ 3 + N0 ^ 2 * N2 + N0 ^ 2 * N1) := by positivity
    simp only [R]
    nlinarith [mul_nonneg hJ hA, mul_nonneg hM hBn]
  calc c * (3 * (28 * R)) = c * 3 * 28 * R := by ring
    _ ≤ c * 3 * 28 * ((2 * √2 * (1 + √(2 / π)) + 2 * jumpConst) * (N0 ^ 3 + N1 ^ 3 + N2 ^ 3 +
        n * (2 * N0 ^ 3 + N0 ^ 2 * N2 + N0 ^ 2 * N1))) := by gcongr
    _ = _ := by simp only [constD03, c]; ring

end HeatData

end D03Assembly

section D03Final

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

omit [DecidableEq ι] in
lemma nNorm_smul (h : ℝ) (c : ℂ) (A : Matrix ι ι ℂ) : nNorm h (c • A) = ‖c‖ * nNorm h A := by
  unfold nNorm
  have e : h ^ 2 * ∑ i, ∑ j, ‖(c • A) i j‖ ^ 3 = ‖c‖ ^ 3 * (h ^ 2 * ∑ i, ∑ j, ‖A i j‖ ^ 3) := by
    simp only [Matrix.smul_apply, smul_eq_mul, norm_mul, mul_pow, ← Finset.mul_sum]; ring
  rw [e, Real.mul_rpow (by positivity) (by positivity), ← Real.rpow_natCast,
    ← Real.rpow_mul (norm_nonneg c)]
  norm_num

omit [DecidableEq ι] in
lemma eq_zero_of_nNorm_eq_zero {h : ℝ} (hh : 0 < h) {A : Matrix ι ι ℂ} (hA : nNorm h A = 0) :
    A = 0 := by
  unfold nNorm at hA
  have hS : 0 ≤ h ^ 2 * ∑ i, ∑ j, ‖A i j‖ ^ 3 := by positivity
  rw [Real.rpow_eq_zero hS (by norm_num)] at hA
  have hS0 : ∑ i, ∑ j, ‖A i j‖ ^ 3 = 0 := by
    rcases mul_eq_zero.1 hA with h1 | h1
    · exact absurd h1 (by positivity)
    · exact h1
  ext i j
  have h1 := (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => Finset.sum_nonneg fun j _ =>
    by positivity)).1 hS0 i (Finset.mem_univ i)
  have h2 := (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => by positivity)).1 h1 j
    (Finset.mem_univ j)
  simpa using h2

namespace HeatData

variable (Hd : HeatData ι)

/-- The data with the arrays rescaled by `c_v`. -/
def scaleA (c : Fin 3 → ℂ) : HeatData ι := ⟨Hd.u, Hd.h, fun v => c v • Hd.A v⟩

lemma D03sum_scaleA {n : ℕ} {sm sp : ℝ} (M : ι → ι → IntervalList n sm sp) (m : ℕ)
    (c : Fin 3 → ℂ) : (Hd.scaleA c).D03sum M m = c 0 * c 1 * c 2 * Hd.D03sum M m := by
  simp only [D03sum, scaleA, Matrix.smul_apply, smul_eq_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ =>
    Finset.sum_congr rfl fun k _ => ?_
  ring

/-- **Lemma 5.3 (node D03), third and fourth derivative kernels.** For `m = 3, 4`, nodes
`uᵢ = h kᵢ` on the integer mesh, masks of at most `n ≥ 1` disjoint scale intervals in
`[s₋, s₊]` with `h² ≤ s₋`, and coefficients of modulus at most one:
`|h³ ∑_{i,j,k} A₀(i,j) A₁(j,k) A₂(k,i) ∑_ℓ η_ℓ K^{(m)}_{u_ℓ,v_ℓ}(u_i+u_j+u_k)| ≤ C √n n₀ n₁ n₂`
with an absolute constant `C`. -/
theorem Gaussian_derivative_grid_count {kk : ι → ℤ} (hk : Function.Injective kk)
    (hu : ∀ i, Hd.u i = Hd.h * kk i) (hh : 0 < Hd.h) {m : ℕ} (hm : m = 3 ∨ m = 4) {n : ℕ}
    (hn : 1 ≤ n) {sm sp : ℝ} (hsm : Hd.h ^ 2 ≤ sm) (hlt : sm < sp)
    (M : ι → ι → IntervalList n sm sp) :
    ‖Hd.D03sum M m‖ ≤ 7 * constD03 * √n * nNorm Hd.h (Hd.A 0) * nNorm Hd.h (Hd.A 1) *
      nNorm Hd.h (Hd.A 2) := by
  set N0 := nNorm Hd.h (Hd.A 0)
  set N1 := nNorm Hd.h (Hd.A 1)
  set N2 := nNorm Hd.h (Hd.A 2)
  have hC : 0 ≤ constD03 := by
    unfold constD03
    have := constD_spec.1
    have := constA_spec.1
    have := HeatData.jumpConst_nonneg
    positivity
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hsn : 0 < √(n : ℝ) := Real.sqrt_pos.2 (by linarith)
  have hRHS : 0 ≤ 7 * constD03 * √n * N0 * N1 * N2 := by
    have := nNorm_nonneg Hd.h (Hd.A 0)
    have := nNorm_nonneg Hd.h (Hd.A 1)
    have := nNorm_nonneg Hd.h (Hd.A 2)
    positivity
  -- degenerate cases
  by_cases hz : N0 = 0 ∨ N1 = 0 ∨ N2 = 0
  · have : Hd.D03sum M m = 0 := by
      simp only [D03sum]
      rcases hz with h0 | h1 | h2
      · have := eq_zero_of_nNorm_eq_zero hh h0
        simp [this]
      · have := eq_zero_of_nNorm_eq_zero hh h1
        simp [this]
      · have := eq_zero_of_nNorm_eq_zero hh h2
        simp [this]
    rw [this, norm_zero]; exact hRHS
  push Not at hz
  obtain ⟨h0, h1, h2⟩ := hz
  have p0 : 0 < N0 := lt_of_le_of_ne (nNorm_nonneg _ _) (Ne.symm h0)
  have p1 : 0 < N1 := lt_of_le_of_ne (nNorm_nonneg _ _) (Ne.symm h1)
  have p2 : 0 < N2 := lt_of_le_of_ne (nNorm_nonneg _ _) (Ne.symm h2)
  set c : Fin 3 → ℂ := ![((N0 * √n)⁻¹ : ℝ), (N1⁻¹ : ℝ), (N2⁻¹ : ℝ)]
  set Hs := Hd.scaleA c
  have hn0 : nNorm Hs.h (Hs.A 0) = (√n)⁻¹ := by
    show nNorm Hd.h (c 0 • Hd.A 0) = _
    rw [nNorm_smul]
    change ‖c 0‖ * N0 = _
    have : c 0 = (((N0 * √n)⁻¹ : ℝ) : ℂ) := rfl
    rw [this, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity), mul_inv]
    field_simp
  have hn1' : nNorm Hs.h (Hs.A 1) = 1 := by
    show nNorm Hd.h (c 1 • Hd.A 1) = _
    rw [nNorm_smul]
    change ‖c 1‖ * N1 = _
    have : c 1 = ((N1⁻¹ : ℝ) : ℂ) := rfl
    rw [this, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    field_simp
  have hn2' : nNorm Hs.h (Hs.A 2) = 1 := by
    show nNorm Hd.h (c 2 • Hd.A 2) = _
    rw [nNorm_smul]
    change ‖c 2‖ * N2 = _
    have : c 2 = ((N2⁻¹ : ℝ) : ℂ) := rfl
    rw [this, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    field_simp
  have hpre := Hs.D03_pre hk hu hh hm hsm hlt M
  rw [hn0, hn1', hn2', D03sum_scaleA] at hpre
  -- the bracket is at most `7`
  have hbr : (√n)⁻¹ ^ 3 + 1 ^ 3 + 1 ^ 3 + (n : ℝ) * (2 * (√n)⁻¹ ^ 3 + (√n)⁻¹ ^ 2 * 1 +
      (√n)⁻¹ ^ 2 * 1) ≤ 7 := by
    have hsq : (√(n : ℝ)) ^ 2 = n := Real.sq_sqrt (by linarith)
    have hs1 : 1 ≤ √(n : ℝ) := by rw [Real.one_le_sqrt]; linarith
    have hinv : (√(n : ℝ))⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hs1
    have hinv0 : 0 ≤ (√(n : ℝ))⁻¹ := by positivity
    have e1 : (n : ℝ) * (√n)⁻¹ ^ 2 = 1 := by
      rw [inv_pow, hsq]; field_simp
    have e2 : (n : ℝ) * (√n)⁻¹ ^ 3 = (√n)⁻¹ := by
      rw [pow_succ, ← mul_assoc, e1, one_mul]
    have : (n : ℝ) * (2 * (√n)⁻¹ ^ 3 + (√n)⁻¹ ^ 2 * 1 + (√n)⁻¹ ^ 2 * 1) =
        2 * (√n)⁻¹ + 2 := by
      rw [show (n : ℝ) * (2 * (√n)⁻¹ ^ 3 + (√n)⁻¹ ^ 2 * 1 + (√n)⁻¹ ^ 2 * 1) =
        2 * ((n : ℝ) * (√n)⁻¹ ^ 3) + 2 * ((n : ℝ) * (√n)⁻¹ ^ 2) by ring, e1, e2]; ring
    rw [this]
    have : (√(n : ℝ))⁻¹ ^ 3 ≤ 1 := pow_le_one₀ hinv0 hinv
    nlinarith
  have hcc : ‖c 0 * c 1 * c 2‖ = (N0 * √n * N1 * N2)⁻¹ := by
    have e0 : c 0 = (((N0 * √n)⁻¹ : ℝ) : ℂ) := rfl
    have e1 : c 1 = ((N1⁻¹ : ℝ) : ℂ) := rfl
    have e2 : c 2 = ((N2⁻¹ : ℝ) : ℂ) := rfl
    rw [e0, e1, e2, norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Complex.norm_real,
      Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos (by positivity),
      abs_of_pos (by positivity), abs_of_pos (by positivity)]
    field_simp
  rw [norm_mul, hcc] at hpre
  have hpos : 0 < N0 * √n * N1 * N2 := by positivity
  have key : (N0 * √n * N1 * N2)⁻¹ * ‖Hd.D03sum M m‖ ≤ constD03 * 7 :=
    hpre.trans (mul_le_mul_of_nonneg_left hbr hC)
  rw [inv_mul_le_iff₀ hpos] at key
  nlinarith [key]

