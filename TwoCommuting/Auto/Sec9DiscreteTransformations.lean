/-- The bilinear ergodic averages `A_N(f,g)(x) = N⁻¹ ∑_{n<N} f(Tⁿx) g(Sⁿx)`. -/
def bilinAvg {X : Type*} (T S : X → X) (f g : X → ℂ) (N : ℕ) (x : X) : ℂ :=
  (N : ℂ)⁻¹ * ∑ n ∈ Finset.range N, f (T^[n] x) * g (S^[n] x)

/-- The statement of Theorem 9.2 (node T02): for commuting invertible probability-preserving
maps with measurable inverses and bounded measurable `f, g`, the averages `A_N(f,g)` converge
almost everywhere. Stated for spaces in `Type`. -/
def InvertibleBoundedConvergence : Prop :=
  ∀ (Y : Type) [MeasurableSpace Y] (ν : Measure Y) [IsProbabilityMeasure ν]
    (T S Tinv Sinv : Y → Y), MeasurePreserving T ν ν → MeasurePreserving S ν ν →
    Measurable Tinv → Measurable Sinv →
    Function.LeftInverse Tinv T → Function.RightInverse Tinv T →
    Function.LeftInverse Sinv S → Function.RightInverse Sinv S →
    T ∘ S = S ∘ T →
    ∀ f g : Y → ℂ, Measurable f → Measurable g → (∃ C, ∀ y, ‖f y‖ ≤ C) → (∃ C, ∀ y, ‖g y‖ ≤ C) →
      ∀ᵐ y ∂ν, ∃ L, Tendsto (fun N => bilinAvg T S f g N y) atTop (𝓝 L)

