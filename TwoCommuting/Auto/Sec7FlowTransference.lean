open Classical in
/-- The orbit function `F_ω(u, v) = f(U^u V^v ω) 1_{Q_R}(u, v)`. -/
def orbitFun (U V : ℝ → Ω → Ω) (f : Ω → ℂ) (R : ℝ) (ω : Ω) (x : ℝ × ℝ) : ℂ :=
  if x ∈ flowSq R then f (U x.1 (V x.2 ω)) else 0

lemma measurable_flowPhi (hC : CommutingFlows ν U V) :
    Measurable fun z : Ω × (ℝ × ℝ) => U z.2.1 (V z.2.2 z.1) :=
  hC.measU.comp (measurable_snd.fst.prodMk
    (hC.measV.comp (measurable_snd.snd.prodMk measurable_fst)))

lemma measurable_orbitFun_joint (hC : CommutingFlows ν U V) {f : Ω → ℂ} (hf : Measurable f)
    (R : ℝ) : Measurable fun z : Ω × (ℝ × ℝ) => orbitFun U V f R z.1 z.2 := by
  unfold orbitFun
  exact Measurable.ite (measurable_snd (measurableSet_flowSq R)) (hf.comp (measurable_flowPhi hC))
    measurable_const

lemma measurable_orbitFun (hC : CommutingFlows ν U V) {f : Ω → ℂ} (hf : Measurable f)
    (R : ℝ) (ω : Ω) : Measurable (orbitFun U V f R ω) :=
  (measurable_orbitFun_joint hC hf R).comp
    (measurable_const.prodMk measurable_id : Measurable fun x : ℝ × ℝ => (ω, x))

