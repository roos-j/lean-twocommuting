/-- Commuting jointly measurable measure-preserving real flows (setting of §7). The identity
`U⁰ = id` is not required (in the suspension of node T01 it holds only almost everywhere). -/
structure CommutingFlows {Ω : Type*} [MeasurableSpace Ω] (ν : Measure Ω) (U V : ℝ → Ω → Ω) :
    Prop where
  measU : Measurable fun p : ℝ × Ω => U p.1 p.2
  measV : Measurable fun p : ℝ × Ω => V p.1 p.2
  mpU : ∀ t, MeasurePreserving (U t) ν ν
  mpV : ∀ t, MeasurePreserving (V t) ν ν
  addU : ∀ s t ω, U (s + t) ω = U s (U t ω)
  addV : ∀ s t ω, V (s + t) ω = V s (V t ω)
  comm : ∀ s t ω, U s (V t ω) = V t (U s ω)

/-- The flow bilinear operator `B^Ω_K(f,g)(ω) = ∫ f(U^t ω) g(V^t ω) K(t) dt`. -/
def flowBilin {Ω : Type*} (U V : ℝ → Ω → Ω) (K : ℝ → ℂ) (f g : Ω → ℂ) (ω : Ω) : ℂ :=
  ∫ t, f (U t ω) * g (V t ω) * K t

