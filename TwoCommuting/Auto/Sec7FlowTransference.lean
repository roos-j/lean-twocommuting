/-- The interval kernels `K^{(m)}_{u,v}` with `0 < u ≤ v` are measurable and integrable. -/
lemma KernC_measurable_integrable (m : ℕ) {u v : ℝ} (hu : 0 < u) (huv : u ≤ v) :
    Measurable (KernC m u v) ∧ Integrable (KernC m u v) :=
  ⟨Complex.measurable_ofReal.comp (continuous_Kern m hu huv).measurable,
    (integrable_Kern m hu huv).1.ofReal⟩

/-- The square `Q_R = [-R, R]²`. -/
def flowSq (R : ℝ) : Set (ℝ × ℝ) := Set.Icc (-R) R ×ˢ Set.Icc (-R) R

lemma measurableSet_flowSq (R : ℝ) : MeasurableSet (flowSq R) :=
  measurableSet_Icc.prod measurableSet_Icc

lemma volume_flowSq (R : ℝ) :
    volume (flowSq R) = ENNReal.ofReal (2 * R) * ENNReal.ofReal (2 * R) := by
  rw [flowSq, Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc]
  ring_nf

lemma volume_flowSq_ne_top (R : ℝ) : volume (flowSq R) ≠ ∞ := by
  rw [volume_flowSq]; exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top

lemma volume_flowSq_ne_zero {R : ℝ} (hR : 0 < R) : volume (flowSq R) ≠ 0 := by
  rw [volume_flowSq]
  have : ENNReal.ofReal (2 * R) ≠ 0 := by
    rw [Ne, ENNReal.ofReal_eq_zero]; push Not; linarith
  exact mul_ne_zero this this

lemma volume_flowSq_add {M L : ℝ} (hM : 0 < M) (hL : 0 ≤ L) :
    volume (flowSq (M + L)) = ENNReal.ofReal ((1 + L / M) ^ 2) * volume (flowSq M) := by
  have h1 : 0 ≤ 1 + L / M := by positivity
  have e : 2 * (M + L) = (1 + L / M) * (2 * M) := by field_simp
  rw [volume_flowSq, volume_flowSq, e, ENNReal.ofReal_mul h1, sq, ENNReal.ofReal_mul h1]
  ring

lemma add_mem_flowSq {M L : ℝ} {p : ℝ × ℝ} (hp : p ∈ flowSq M) {t : ℝ}
    (ht : t ∈ Set.Icc (-L) L) :
    (p.1 + t, p.2) ∈ flowSq (M + L) ∧ (p.1, p.2 + t) ∈ flowSq (M + L) := by
  simp only [flowSq, Set.mem_prod, Set.mem_Icc] at hp ht ⊢
  refine ⟨⟨⟨?_, ?_⟩, ?_, ?_⟩, ⟨?_, ?_⟩, ?_, ?_⟩ <;> linarith

